# machine.env.example - host-specific values (the machine profile).
# Copy to automation/config/machine.env (gitignored: it carries THIS
# machine's identity, not repo defaults). bootstrap.sh stages it.
# Sourced with ${VAR:-default} semantics like config.env, so an exported
# env var still wins. Consumers listed per var; as hardcoded paths are
# swept out of job code (README "known remaining hardcoded paths"), they
# resolve here instead.

# Steamdeck tailnet address - `tailscale ip` on the deck, or find it in
# `tailscale status`. Consumed by cadence/day/06-remote-posture.sh
# (docs/REMOTE-ACCESS.md).
DECK_IP="${DECK_IP:-100.79.162.3}"

# Tailscale network name (`tailscale status --json | jq -r .CurrentTailnet.Name`).
# Declared for the hardcoded-path sweep; no job consumes it yet.
#TAILNET_NAME="${TAILNET_NAME:-example.tailnet}"

# Dashboard bind - config.env carries the live defaults; uncomment to
# override on this machine (dashboard-server.py).
#DASHBOARD_HOST="${DASHBOARD_HOST:-0.0.0.0}"
#DASHBOARD_PORT="${DASHBOARD_PORT:-8890}"