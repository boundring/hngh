// opencode-safety.jsonc — the committed secret-deny BASELINE (R1 mitigation,
// design docs/research/2026-09-10-opencode-agentic-surface.md risk 1).
// Since 2026-09-11 the OPENCODE_CONFIG target for executor=opencode sessions
// is automation/config/opencode/opencode.jsonc (the full hngh config layer:
// this deny block copied verbatim into it plus agent roles + MCP servers).
// This file remains the superset test's baseline:
// --auto approves everything not explicitly denied, so the copied
// secret-deny permission block (from ~/.config/opencode/opencode.jsonc,
// copied verbatim 2026-09-11 — never referenced by path, so operator config
// churn cannot silently widen machine-session permissions) is the load-bearing
// content. Re-copy on operator-side deny-block changes.
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "~/.hermes/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*.key": "deny",
      "~/.gnupg/**": "deny",
      "~/.ssh/id_*": "deny"
    }
  }
}
