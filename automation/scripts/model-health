#!/usr/bin/env bash
# model-health — on-demand model state as JSON (stall-recovery step 1
# surface). Prints: demotion counters per model (consecutive_bad,
# demoted), the selector's current pick (same ladder overnight-cycle
# uses: env > bench > paid, with demotion filtering), and failfirst
# development speed. Stdlib only, fail-closed ({} on trouble), no daemon.
#
# usage: automation/scripts/model-health [--pretty]
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
KERNEL="${HNGH_HOME:-$HOME/Projects/etc/hngh}"
. "$ROOT/lib/common.sh" 2>/dev/null
. "$ROOT/lib/model-demote.sh" 2>/dev/null

DEMOTE_STATE="${DEMOTE_STATE:-$AUTOMATION_ROOT/state/model-demote.tsv}"
FF_STATE="${FAILFIRST_STATE_DIR:-/tmp/hngh-failfirst}/failfirst-development"

python3 - "$DEMOTE_STATE" "$FF_STATE" "${OVERNIGHT_MODEL:-}" "$ROOT/stats" <<'PY'
import glob, json, os, sys, time

state, ff, env_model, stats_dir = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
models = {}
try:
    for ln in open(state, errors="replace"):
        p = ln.rstrip("\n").split("\t")
        if len(p) >= 3:
            m = p[0]
            if not m:
                continue
            d = {"consecutive_bad": int(p[1]) if p[1].isdigit() else 0,
                 "demoted": p[2] == "1"}
            if len(p) >= 5:
                d["last_outcome"], d["last_ts"] = p[3], p[4]
            models[m] = d
except OSError:
    pass

ff_state = {}
try:
    for ln in open(ff, errors="replace"):
        k, _, v = ln.strip().partition("=")
        ff_state[k] = v
except OSError:
    pass

# bench candidates (same glob select_model scans), with demotion flags
bench = []
try:
    cutoff = time.time() - 86400
    for f in glob.glob(os.path.join(stats_dir, "model-bench-*.jsonl")):
        if os.path.getmtime(f) < cutoff:
            continue
        for ln in open(f, errors="replace"):
            try:
                r = json.loads(ln)
            except ValueError:
                continue
            m = r.get("model", "")
            if m and m not in [b["model"] for b in bench]:
                bench.append({"model": m, "score": r.get("score", 0),
                              "demoted": models.get(m, {}).get("demoted", False)})
except OSError:
    pass

active, source = env_model, "env"
if not active:
    ok = [b for b in bench if b["score"] >= 5 and not b["demoted"]]
    if ok:
        active, source = ok[0]["model"], "local-bench"
    else:
        active, source = os.environ.get("OVERNIGHT_PAID_MODEL", "zai/glm-5.3"), "paid-fallback"

out = {"generated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
       "active": {"model": active, "source": source},
       "models": models, "bench_24h": bench,
       "failfirst": {"speed": ff_state.get("speed"), "oks": ff_state.get("oks"),
                      "last": ff_state.get("last")}}
print(json.dumps(out, indent=2 if "--pretty" in sys.argv else None, sort_keys=True))
PY
