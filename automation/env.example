# env.example - the automation tier's ENVIRONMENT CONTRACT (peer-review
# finding 1: the operator env that used to live only in this Plasma session,
# declared here as KEY NAMES ONLY - no values, no operator secrets).
#
# How values actually resolve:
#   1. exported environment wins,
#   2. automation/config/machine.env (host identity; gitignored, staged by
#      bootstrap.sh from config/machine.env.example),
#   3. automation/config.env defaults (all use ${VAR:-default} semantics).
# Never put a secret value in this file, in config.env, or in machine.env.
# The documented secret path is the 1Password service account interface:
#   docs/records/2026-09-09-1password-service-account-interface.md
#   - ONEPASSWORD_SERVICE_KEY (operator-set; declared outside the repo, e.g.
#     ~/.config/plasma-workspace/env/env_vars.sh chmod 600, then
#     `systemctl --user import-environment ONEPASSWORD_SERVICE_KEY` at login)
#   - with OP_SERVICE_ACCOUNT_TOKEN set, `op` authenticates headless; scripts
#     read secrets via `op read op://<vault>/<item>/<field>` (lib/credentials.sh).
#
# REQUIRED vs OPTIONAL below: REQUIRED means a subsystem fails closed (dormant
# or degraded) without it - never a crash.

# --- secrets (REQUIRED for the live tier; obtain via 1Password `op://`) -----
#ONEPASSWORD_SERVICE_KEY=   # headless 1Password auth for `op`; REQUIRED for vault-backed secrets; see the interface doc above
#TOKEN_FILE=                # unsloth access-token cache; optional; default ~/.hngh-automation/unsloth.token (lib/model.sh refresh writes it)
#REFRESH_FILE=              # unsloth refresh-token cache; optional; default ~/.hngh-automation/unsloth.refresh
#REMOTE_TOKEN_FILE=         # OpenRouter API key file (remote paid leg); REQUIRED for remote calls; default ~/.hngh-automation/openrouter.token
#KIMI_AI_KEY=               # Kimi K3 quota key (api.kimi.com/coding/v1); optional, REQUIRED for the kimi leg; 1Password item
#KIMI_FOR_CODING_KEY=       # alias resolution for the kimi leg; optional (lib/model.sh:317 order)
#MOONSHOTAI_API_KEY=        # further kimi alias; optional
#KIMI_KEY_FILE=             # kimi key file fallback; optional; default ~/.config/hngh/kimi-key
#TELEGRAM_BOT_TOKEN=       # telegram notify channel; optional (dormant without it)
#TELEGRAM_CHAT_ID=         # telegram notify channel; optional
#HNGH_NOTIFY_EMAIL_CONF=   # email notify INI (chmod 600, scripts refuse looser); optional; default ~/.hngh-automation/notify-email.conf; stage via scripts/setup-notify-email.sh
#HNGH_OP_BIN=              # `op` binary override (test seam); optional

# --- config.env overrides (lib/common.sh sources config.env; ${VAR:-default}) ---
#MODEL=                    # local unsloth model id; optional; default unsloth/Qwen3.8-27B-GGUF
#UNSLOTH_FALLBACK_MODELS=  # space-separated ranked fallback chain; optional
#OLLAMA_MODEL=             # final-fallback ollama model; optional
#MODEL_MAX_TOKENS=         # summarization token budget; optional; default 1024
#MODEL_TIMEOUT=            # first-call timeout seconds (model swap loads 1-3 min); optional; default 300
#UNSLOTH_URL=              # unsloth llama-server endpoint; optional; default http://127.0.0.1:8888
#OLLAMA_URL=               # ollama endpoint; optional; default http://127.0.0.1:11434
#REMOTE_URL=               # remote (paid) OpenAI-compatible endpoint; optional; default https://openrouter.ai/api/v1
#REMOTE_MODEL=             # remote model id; optional; default z-ai/glm-5.3-flash
#REMOTE_DAILY_CAP_CALLS=   # paid-call UTC-day cap; optional; default 200
#USER_AGENT=               # fetch User-Agent; optional
#DECK_MODEL=               # deck model alias (deck-7b on llama-server, no /v1 suffix); optional
#DASHBOARD_PORT=           # dashboard bind port; optional; default 8890 (binds LAN)
#DASHBOARD_HOST=           # dashboard bind host; optional; default 0.0.0.0
#HNGH_HOME=                # hngh KERNEL repo path (CLI + report-queue); REQUIRED, default /home/<user>/Projects/etc/hngh
#HNGH_CLI=                 # hngh CLI path; optional; default $HNGH_HOME/scripts/hngh
#HNGH_STORE=               # hngh run store; optional; default ~/.hngh-automation/store
#HNGH_ROLE=                # create-run role label; optional; default operator
#SOURCES=                  # space/newline-separated name:url feed list (__TODAY__/__WEEKAGO__ substituted); optional; config.env has the verified default set
#MAX_SOURCE_CHARS=         # per-source prompt budget; optional; default 12000
#MAX_PING_WORDS=           # hourly ping word cap; optional; default 200
#MAX_MORNING_WORDS=        # morning digest word cap; optional; default 400
#BENCH_MODELS=             # daily model-bench candidate list; optional

# --- cadence-params.tsv overrides (each tsv row has an env twin; lib/params.sh) ---
#DECK_URL=                 # deck-model-endpoint row; deck llama-server URL, NO /v1 suffix; empty/absent = deck leg skipped fail-closed
#DECK_NODE_ENABLED=        # deck-node-enabled row; 0 = hourly deck-facts pull no-ops
#DECK_PROBE_TIMEOUT=       # deck-probe-timeout row; seconds for the /health probe
#KIMI_URL=                 # kimi-endpoint row; default https://api.kimi.com/coding/v1
#KIMI_MODEL=               # kimi-model row; default k3-256k; empty = kimi leg skipped
#KIMI_DAILY_CAP_CALLS=     # kimi-daily-cap row; default 40
#KIMI_RESEARCH_SHARE=      # every Nth research run pins kimi; 0 = never
#RESEARCH_LOAD_CEILING=    # loadavg-per-cpu routing ceiling; default 0.7

# --- machine profile (automation/config/machine.env; see machine.env.example) ---
#DECK_IP=                  # steamdeck tailnet address; REQUIRED for cadence/day/06-remote-posture.sh (tailscale status on the deck)
#TAILNET_NAME=             # tailscale network name; declared for the hardcoded-path sweep; no consumer yet
#DASHBOARD_HOST= / #DASHBOARD_PORT= also live here on this machine

# --- update/toolchain path (scripts/hngh-omp-update.sh, scripts/night-session.sh) ---
#OMP_BIN=                  # omp binary; optional; default ~/.bun/bin/omp
#OMP_BRIDGE_BIN=           # omp bridge binary; optional

# --- harness seams (tests/CI; operators normally never set these) ---
#HNGH_TICK_TS=             # YYYY-MM-DD tick date override (day-tier tests)
#HNGH_REPORT_ROOT=         # report-queue root override (tests point it at a sandbox)
#HNGH_REPORT_QUEUE=        # report-queue script override
#HNGH_TELEMETRY_DB=        # telemetry db override (tests)
#HNGH_SERVICE_SYSTEMCTL=   # systemctl override (service-ctl tests)
#HNGH_NOTIFY_IMMEDIATE=    # 0 forces every alert to digest-only
#DRY_RUN=                  # job-code dry-run seam where supported
#JOB_NAME= / TIER= / STATE_FILE= / DEMOTE_STATE= / FAILFIRST_STATE_DIR=  # test seams, set by tests, not operators