[Unit]
Description=hngh-automation morning report session (07:30)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.hngh/bin/hngh-night-session prompts/morning-report.md morning-report
ExecStartPost=%h/.hngh/bin/hngh-refresh-dashboard morning-report

Restart=no
