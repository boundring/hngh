[Unit]
Description=hngh-automation security check (every 4h)

# NOTE: the [Service] section that used to sit here was ignored by systemd
# ("Unknown section 'Service'" in a .timer file), so its ExecStart never ran.
# hngh-security.service is the real unit; this file only schedules it.

[Timer]
OnCalendar=*-*-* 00,04,08,12,16,20:00:00
Persistent=true

[Install]
WantedBy=timers.target