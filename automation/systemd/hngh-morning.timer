[Unit]
Description=hngh-automation morning digest
[Service]
Type=oneshot
ExecStart=/home/bricker/Projects/etc/hngh-automation/jobs/morning-digest.sh
WorkingDirectory=/home/bricker/Projects/etc/hngh-automation

[Timer]
OnCalendar=*-*-* 06,07,08,09:00:00
Persistent=true

[Install]
WantedBy=timers.target