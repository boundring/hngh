[Unit]
Description=hngh-automation morning digest

# NOTE: this timer used to carry a [Service] section with its own ExecStart.
# systemd ignores [Service] in a .timer file ("Unknown section 'Service'"), so
# that ExecStart never ran. The work is driven by hngh-morning.service, which
# hngh-cadence-* and the morning timer chain reach; keeping the section here
# only ever misled readers.

[Timer]
OnCalendar=*-*-* 06,07,08,09:00:00
Persistent=true

[Install]
WantedBy=timers.target