[Unit]
Description=hngh cadence tick: monthly tier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TIER=month
ExecStart=%h/Projects/etc/hngh/automation/jobs/cadence-tick.sh
WorkingDirectory=%h/Projects/etc/hngh/automation
Restart=no

[Install]
WantedBy=multi-user.target
