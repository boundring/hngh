[Unit]
Description=hngh-automation dashboard (phone-accessible on LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.hngh/bin/hngh-dashboard-server

Restart=on-failure
RestartSec=5
# dashboard serves generated digests/JSON only — no secrets are ever written here

[Install]
WantedBy=default.target