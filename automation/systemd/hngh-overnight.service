[Unit]
Description=hngh overnight work cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/bricker/Projects/etc/hngh/automation/scripts/overnight-cycle.sh
WorkingDirectory=/home/bricker/Projects/etc/hngh/automation
Restart=no

[Install]
WantedBy=multi-user.target
