[Unit]
Description=hngh overnight work cycle
After=network-online.target
Wants=network-online.target

[Service]
# operator authorization 2026-09-09: prefer GLM 5.3 Flash for cost;
# every unit that can reach overnight-cycle.sh must carry the
# override so a lane switch (e.g. hour workbeat) cannot drop it
Environment=OVERNIGHT_MODEL=openrouter/z-ai/glm-5.3-flash
Type=oneshot
ExecStart=%h/Projects/etc/hngh/automation/scripts/overnight-cycle.sh
WorkingDirectory=%h/Projects/etc/hngh/automation
Restart=no

[Install]
WantedBy=multi-user.target
