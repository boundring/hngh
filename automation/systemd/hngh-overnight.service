[Unit]
Description=hngh overnight work cycle
After=network-online.target
Wants=network-online.target

[Service]
# No OVERNIGHT_MODEL override: the env rung was removed 2026-10-14
# (docs/records/2026-10-14-overnight-model-pin-removal.md). This lane
# now resolves its model through select_model's ladder, the same as any
# other lane — see test-unit-model-env.sh, which guards that.
Type=oneshot
ExecStart=%h/.hngh/bin/hngh-overnight-cycle

Restart=no

[Install]
WantedBy=multi-user.target
