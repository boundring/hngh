[Unit]
Description=hngh cadence tick: 10-minute tier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TIER=10m
ExecStart=~/Projects/etc/hngh/automation/jobs/cadence-tick.sh
WorkingDirectory=~/Projects/etc/hngh/automation
Restart=no

[Install]
WantedBy=multi-user.target
