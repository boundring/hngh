[Unit]
Description=hngh cadence tick: calendar tier (daily / weekly / monthly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TIER=calendar
ExecStart=%h/Projects/etc/hngh/automation/jobs/cadence-tick.sh
WorkingDirectory=%h/Projects/etc/hngh/automation
Restart=no

[Install]
WantedBy=multi-user.target
