[Unit]
Description=hngh-automation hourly research ping
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.hngh/bin/hngh-ping-hourly

# fail-closed jobs always exit 0 on expected conditions; nonzero = real bug
Restart=no

[Install]
WantedBy=multi-user.target