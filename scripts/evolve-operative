#!/usr/bin/env python3
"""evolve-operative: breed evolutionary pixel-art frame-sets for the operative.

Two generations, selected with --gen:

  --gen 1 (default) — "operative-v1": a seeded mutation walk over a dark
      slab humanoid (family operative-v1, unchanged since v1).

  --gen 2 — "operative-v2": the evolved template. Reads as a human figure at
      a glance: small head well below shoulder width, visible neck, arms as
      thin limbs hanging OUTSIDE the torso with negative space and bent
      elbows, a coat that opens into two panels, stanced legs with a clear
      gap, boots, and a ground line. New mutation vocabulary: neck-gap,
      arm-bend (elbow), leg-split / visible stance gap, head-small,
      coat-open (two panels), plus the carried set (blink, breath, tilt,
      coat-flare, arm height, props).

Every frame is a monospace-safe grid (<=24 cols, <=18 rows) drawn only from
the approved glyph set; every generation is deterministic per seed.

Determinism contract: the ONLY entropy is random.Random(seed) — same seed,
same generation, same JSON, byte for byte. The rng call sequence per
generation is fixed: randint(1,3) mutation count, then per mutation
randrange(len(mutations)), and randrange(len(props)) inside the prop
mutation. Gen 1's sequence is preserved exactly, so its output is unchanged.

Usage:
    evolve-operative [--gen 1|2] [--frames N] [--seed S] [--out FILE]
    evolve-operative --help
"""

import argparse
import json
import random
import sys

# ---------------------------------------------------------------------------
# generation 1 — the original slab operative (family "operative-v1")
# ---------------------------------------------------------------------------

CANVAS_W = 20

# The base pose ("idle-0"). All offspring are mutations of this grid.
# head: crown / slab / pale eye-slit / jaw — neck, shoulders with arm tips,
# torso band, coat flare, split legs, floor feet.
BASE = (
    "     ▄▄████▄▄       ",   #  0 crown
    "    ██████████      ",   #  1 head slab
    "    █▒▒▒▒▒▒▒▒█     ",   #  2 eye slit (dim slot between solid)
    "    ▀████████▀     ",   #  3 jaw
    "       ▐█▌         ",   #  4 neck
    "  ▐████████████▌   ",   #  5 shoulders + arm tips (raised baseline)
    "   ████████████    ",   #  6 torso top
    "    ██████████     ",   #  7 torso
    "    ░███████░      ",   #  8 waist (coat shading)
    "   ░██████████░    ",   #  9 coat
    "  ░████████████░   ",   # 10 coat hem (widest)
    "    ██     ██      ",   # 11 left / right leg
    "    ██     ██      ",   # 12
    "    ██     ██      ",   # 13
    "    ▀▀     ▀▀      ",   # 14 boots
)


def to_grid():
    """BASE -> mutable char grid."""
    return [list(row) for row in BASE]


def to_art(grid):
    """Grid -> multi-line art string, trailing whitespace stripped."""
    return "\n".join("".join(row).rstrip() for row in grid)


def blink(grid):
    """Eye slit darkens: the pale slot closes to solid head."""
    for x, c in enumerate(grid[2]):
        if c == "▒":
            grid[2][x] = "█"


def arm_row(grid, target):
    """Lift or drop the arm tips: ▐/▌ sit at the shoulder band (5),
    raised toward the neck (4), or lowered along the torso (6)."""
    for y in (4, 5, 6):
        grid[y][2] = " "
        grid[y][17] = " "
    grid[target][2] = "▐"
    grid[target][17] = "▌"


def stance(grid, delta):
    """Leg spread: delta -1 wide, 0 base, +1 narrow. Rewrites rows 11-14."""
    left, right = 4 + delta, 11 - delta
    for y in range(11, 15):
        row = grid[y]
        for x in range(3, 14):
            row[x] = " "
        ch = "▀" if y == 14 else "█"
        row[left], row[left + 1] = ch, ch
        row[right], row[right + 1] = ch, ch


def coat_flare(grid):
    """Coat hem and mid-coat flare one cell wider on both edges."""
    for y in (9, 10):
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█░"]
        if not xs:
            continue
        a, b = min(xs), max(xs)
        if row[a - 1] == " ":
            row[a - 1] = "░"
        if row[b + 1] == " ":
            row[b + 1] = "░"


def tilt(grid, dx):
    """Head cluster (rows 0-4) shifts one column left/right. Arm tips on the
    outer rails are excluded so a raised hand does not ride the tilt."""
    for y in range(5):
        row = grid[y]
        cells = [(x, c) for x, c in enumerate(row)
                 if c != " " and not (c in "▐▌" and (x <= 3 or x >= 16))]
        for x, _ in cells:
            row[x] = " "
        for x, c in cells:
            nx = x + dx
            if 0 <= nx < CANVAS_W:
                row[nx] = c


def breath(grid, direction):
    """Torso band (rows 6-7) breathes: +1 column each edge on in, -1 on out.
    Only the solid torso rows breathe — the shaded waist row (8) is left
    alone so breath-in/out never hollow a notch between the ░ shading."""
    for y in (6, 7):
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c == "█"]
        if not xs:
            continue
        if direction == "in":
            for side in (-1, 1):
                edge = min(xs) if side == -1 else max(xs)
                tgt = edge + side
                if 0 <= tgt < CANVAS_W and row[tgt] == " ":
                    row[tgt] = "█"
        else:
            a, b = min(xs), max(xs)
            if b - a + 1 <= 4:
                continue  # never narrower than a 4-cell core
            row[a] = " "
            row[b] = " "


PROPS = (
    ("mote", ((2, 1, "•"),)),
    ("ember", ((11, 18, "▓"),)),
    ("glint", ((14, 2, "▖"), (14, 17, "▗"))),
)


def prop(grid, rng):
    """A minimal glow adjunct: floating mote, ember beside the coat, or a
    boot-edge glint on the floor line."""
    kind, cells = PROPS[rng.randrange(len(PROPS))]
    for y, x, ch in cells:
        grid[y][x] = ch
    return "prop:" + kind


MUTATIONS = (
    ("blink", lambda g, r: blink(g)),
    ("arm-up", lambda g, r: arm_row(g, 4)),
    ("arm-down", lambda g, r: arm_row(g, 6)),
    ("stance-wide", lambda g, r: stance(g, -1)),
    ("stance-narrow", lambda g, r: stance(g, 1)),
    ("coat-flare", lambda g, r: coat_flare(g)),
    ("tilt-left", lambda g, r: tilt(g, -1)),
    ("tilt-right", lambda g, r: tilt(g, 1)),
    ("breath-in", lambda g, r: breath(g, "in")),
    ("breath-out", lambda g, r: breath(g, "out")),
    ("prop", lambda g, r: prop(g, r)),
)

# ---------------------------------------------------------------------------
# generation 2 — the humanoid operative (family "operative-v2")
# ---------------------------------------------------------------------------
#
# Anatomy (20-col canvas):
#   rows 0-2   head: crown / slab / eye-slit (7 wide — smaller than shoulders)
#   row 3      neck (2 wide)
#   row 4      shoulders / traps (10 wide — clearly wider than the head)
#   rows 5-6   chest + upper arms; arms are thin ▐/▌ columns at cols 2/17
#              with a 2-col negative-space gap to the torso
#   row 7      waist (8 wide — narrower than shoulders: a clean V-taper)
#   row 8      hips + forearms bent one column inward at the elbow (▄▄)
#   rows 9-10  coat, two panels with a center gap ("open front")
#   rows 11-12 legs: two 2-wide columns, 6-col gap between
#   row 13     boots (feet wider than shins)
#   row 14     ground slab

BASE2 = (
    "      ▄█████▄      ",   #  0 crown
    "      ███████      ",   #  1 head slab
    "      █▀▀▀▀▀█      ",   #  2 eye slit (pale slot)
    "        ██         ",   #  3 neck
    "     ▄████████▄     ",   #  4 shoulders / traps
    "  ▐  ██████████  ▌  ",   #  5 chest + upper arms (gap between)
    "  ▐  ██████████  ▌  ",   #  6 chest + upper arms
    "  ▐   ████████   ▌  ",   #  7 waist (V-taper) + arms
    "   ▄▄ ████████ ▄▄   ",   #  8 hips + forearms bent in at the elbow
    "     ████  ████     ",   #  9 coat, two panels, center gap
    "    ░███  ███░      ",   # 10 coat flare
    "    ██      ██      ",   # 11 legs (6-col gap)
    "    ██      ██      ",   # 12 legs
    "    ███    ███      ",   # 13 boots
    " ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ ",   # 14 ground
)

# v2 geometry: rows 11-13 legs at left cols 4-5, right cols 12-13; boots at
# left 4-6 / right 11-13; coat panels rows 9-10; forearms at row 8.
V2 = {"w": CANVAS_W, "legs_l": (4, 5), "legs_r": (12, 13),
      "boots_l": (4, 6), "boots_r": (11, 13)}


def to_grid2():
    return [list(row) for row in BASE2]


def blink2(grid):
    """Eye slit closes: the pale ▀ slot darkens to solid head."""
    for x, c in enumerate(grid[2]):
        if c == "▀":
            grid[2][x] = "█"


def neck_gap(grid):
    """The neck clears: head floats above the shoulders (visible void)."""
    for x in range(8, 10):
        grid[3][x] = " "


def arms2(grid, rows):
    """Upper arms: thin ▐/▌ columns at cols 2/17 across ROWS."""
    for y in range(4, 9):
        grid[y][2] = " "
        grid[y][17] = " "
    for y in rows:
        grid[y][2] = "▐"
        grid[y][17] = "▌"


def arm_bend(grid):
    """Elbow: forearms straighten to hang directly under the upper arms
    (the base keeps them bent inward at the hip). Clears only the arm zone
    (cols 2-5 and 14-17 on row 8); the hip row is never touched."""
    for x in range(2, 6):
        grid[8][x] = " "
    for x in range(14, 18):
        grid[8][x] = " "
    grid[8][2], grid[8][3], grid[8][16], grid[8][17] = "▄", "▄", "▄", "▄"


def legs2(grid, left, right):
    """Legs + boots at (LEFT, RIGHT) 2-wide column pairs; boots widen to
    (L-1..R+1) on the boot row."""
    l1, l2 = left
    r1, r2 = right
    for y in (11, 12):
        row = grid[y]
        for x in range(1, 18):
            if row[x] in "█":
                row[x] = " "
        row[l1], row[l2], row[r1], row[r2] = "█", "█", "█", "█"
    boot = grid[13]
    for x in range(1, 18):
        if boot[x] in "█":
            boot[x] = " "
    for x in range(l1 - 1, l2 + 1):
        boot[x] = "█"
    for x in range(r1 - 1, r2 + 1):
        boot[x] = "█"


def coat_open(grid):
    """Coat gap widens: both panels clear one more column toward center."""
    for y, ls, le, rs, re in ((9, 4, 7, 12, 15), (10, 3, 6, 11, 14)):
        row = grid[y]
        for x in range(2, 17):
            if row[x] in "█░":
                row[x] = " "
        for x in range(ls, le + 1):
            row[x] = "█"
        for x in range(rs, re + 1):
            row[x] = "█"


def coat_flare2(grid):
    """Coat hem flares: panels shift one column outward, ░ at the outer
    edge of each panel."""
    for y, ls, le, rs, re, d in ((9, 4, 9, 11, 16, "░"),
                                 (10, 3, 8, 10, 15, "░")):
        row = grid[y]
        for x in range(2, 17):
            if row[x] in "█░":
                row[x] = " "
        for x in range(ls, le + 1):
            row[x] = "█"
        for x in range(rs, re + 1):
            row[x] = "█"
        row[ls] = d
        row[re] = d


def head_small(grid):
    """Head shrinks to 2 rows and lifts to the top of the canvas (no
    leading void): the slab and eye-slit move to rows 0-1, the crown row
    and the vacated slit row clear."""
    grid[0] = grid[1][:]
    grid[1] = grid[2][:]
    for x in range(len(grid[2])):
        grid[2][x] = " "


def tilt2(grid, dx):
    """Head + neck (rows 0-3) shift one column left/right."""
    for y in range(0, 4):
        row = grid[y]
        cells = [(x, c) for x, c in enumerate(row) if c != " "]
        for x, _ in cells:
            row[x] = " "
        for x, c in cells:
            nx = x + dx
            if 0 <= nx < V2["w"]:
                row[nx] = c


def breath2(grid, direction):
    """Chest (rows 5-6, the solid 10-wide rows) breathes: ±1 column each
    edge. Waist, coat, and arms are untouched."""
    for y in (5, 6):
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c == "█"]
        if not xs:
            continue
        if direction == "in":
            for side in (-1, 1):
                edge = min(xs) if side == -1 else max(xs)
                tgt = edge + side
                if 0 <= tgt < V2["w"] and row[tgt] == " ":
                    row[tgt] = "█"
        else:
            a, b = min(xs), max(xs)
            if b - a + 1 <= 6:
                continue  # never narrower than a 6-cell chest
            row[a] = " "
            row[b] = " "


PROPS2 = (
    ("mote", ((1, 15, "•"),)),
    ("ember", ((10, 18, "▓"),)),
    ("glint", ((14, 2, "▖"), (14, 17, "▗"))),
)


def prop2(grid, rng):
    kind, cells = PROPS2[rng.randrange(len(PROPS2))]
    for y, x, ch in cells:
        grid[y][x] = ch
    return "prop:" + kind


MUTATIONS2 = (
    ("blink", lambda g, r: blink2(g)),
    ("neck-gap", lambda g, r: neck_gap(g)),
    ("arm-up", lambda g, r: arms2(g, (4, 5, 6))),
    ("arm-down", lambda g, r: arms2(g, (6, 7, 8))),
    ("arm-bend", lambda g, r: arm_bend(g)),
    ("stance-wide", lambda g, r: legs2(g, (3, 4), (13, 14))),
    ("stance-narrow", lambda g, r: legs2(g, (5, 6), (10, 11))),
    ("leg-split", lambda g, r: legs2(g, (3, 4), (13, 14))),
    ("head-small", lambda g, r: head_small(g)),
    ("coat-open", lambda g, r: coat_open(g)),
    ("coat-flare", lambda g, r: coat_flare2(g)),
    ("tilt-left", lambda g, r: tilt2(g, -1)),
    ("tilt-right", lambda g, r: tilt2(g, 1)),
    ("breath-in", lambda g, r: breath2(g, "in")),
    ("breath-out", lambda g, r: breath2(g, "out")),
    ("prop", lambda g, r: prop2(g, r)),
)

# ---------------------------------------------------------------------------
# generation 3 — the deliberate operative (family "operative-v3")
# ---------------------------------------------------------------------------
#
# Fitness journal (generation 3) — the critique that drives this pass:
#   "grey pixelated faceless humanoid, crude low-resolution sprite, jagged
#    edges, lacks detail, feels like a placeholder."
# Targets, mapped to concrete art decisions:
#   smooth silhouette  -> rounded head (crown narrower than slab, ▄ corners),
#                         head sides feathered with ▒, shoulder pads with ▄
#                         corners and ░ feathering — no hard 90-degree runs
#   visible detail     -> • mote of light inside the eye-slit, ░ seam lines
#                         inside the coat panels, ▓ belt line, ▀ cuffs and
#                         ▒ hem accents
#   deliberate art     -> subtle asymmetry (seams sit at different panel
#                         offsets; mote is off-center), shading gradation
#   grounded           -> bright ▄ ground slab with a ▒ cast shadow under
#                         the figure, wider than the boots
#   terminal-safe      -> <=18 rows, <=24 cols, approved glyphs only
#   deterministic      -> same seed, same JSON (sole entropy is the rng)

BASE3 = (
    "       ▄██████▄         ",   #  0 crown (rounded, ▄ corners)
    "      █▒██████▒█        ",   #  1 head slab (▒ feathers the hard edges)
    "      █▀▀▀▀•▀▀▀█        ",   #  2 eye-slit with an off-center • mote
    "       ▀██████▀         ",   #  3 jaw
    "          ██            ",   #  4 neck
    "    ▄████████████▄      ",   #  5 traps / shoulder pads
    "  ▐  ████████████  ▌    ",   #  6 chest + upper arms (gap between)
    "  ▐   ██████████   ▌    ",   #  7 chest (V-taper)
    "  ▐    ████████    ▌    ",   #  8 waist + arms
    "    ▄▄ ████████ ▄▄      ",   #  9 hips + forearms bent in at the elbow
    "        ██▓▓▓▓██       ",   # 10 belt line (▓ band)
    "       ██░█  █░██       ",   # 11 coat panels, open front, ░ seams
    "       ░██░█  █░██░     ",   # 12 coat hem flaring, ░ hem accents
    "         ██    ██       ",   # 13 legs (clear gap)
    "         ██    ██       ",   # 14 legs
    "         ███  ███       ",   # 15 boots (wider than the shins)
    "  ▄▄▄▄▒▒▒▒▒▒▒▒▒▒▒▒▄▄▄▄  ",   # 16 bright ground slab + ▒ cast shadow
)

V3 = {
    "w": 24,
    "head_rows": (0, 1, 2, 3),
    "neck_row": 4,
    "traps_row": 5,
    "chest_rows": (6, 7),
    "waist_row": 8,
    "hip_row": 9,
    "belt_row": 10,
    "coat_rows": (11, 12),
    "leg_rows": (13, 14),
    "boot_row": 15,
    "ground_row": 16,
    "arm_l": 2,
    "arm_r": 19,
    "legs_base": ((9, 10), (15, 16)),
    "legs_wide": ((7, 8), (17, 18)),
    "legs_narrow": ((10, 11), (13, 14)),
}


def to_grid3():
    return [list(row) for row in BASE3]


def _find_mote(grid):
    for y in V3["head_rows"]:
        for x, c in enumerate(grid[y]):
            if c == "•":
                return y, x
    return None


def blink3(grid, rng):
    """Eye-slit closes: every pale ▀ in the head darkens to █; the • mote
    persists as eyelight through the closed slit."""
    for y in V3["head_rows"]:
        for x, c in enumerate(grid[y]):
            if c == "▀":
                grid[y][x] = "█"


def mote_shift(grid, rng):
    """The eye mote drifts one cell left or right (off-center glint)."""
    pos = _find_mote(grid)
    if pos is None:
        return
    y, x = pos
    dx = 1 if rng.randrange(2) else -1
    nx = x + dx
    if 0 <= nx < V3["w"] and grid[y][nx] == " ":
        grid[y][x] = " "
        grid[y][nx] = "•"


def neck_gap3(grid, rng):
    """The neck clears: head floats above the shoulders."""
    for x in range(10, 12):
        grid[V3["neck_row"]][x] = " "


def arms3(grid, rows):
    """Upper-arm columns at the outer rails across ROWS."""
    for y in range(5, 10):
        grid[y][V3["arm_l"]] = " "
        grid[y][V3["arm_r"]] = " "
    for y in rows:
        grid[y][V3["arm_l"]] = "▐"
        grid[y][V3["arm_r"]] = "▌"


def arm_bend3(grid, rng):
    """Elbow straightens: forearms hang directly under the upper arms."""
    for x in (4, 5, 16, 17):
        grid[V3["hip_row"]][x] = " "
    grid[V3["hip_row"]][3] = "▄"
    grid[V3["hip_row"]][4] = "▄"
    grid[V3["hip_row"]][18] = "▄"
    grid[V3["hip_row"]][19] = "▄"


def legs3(grid, left, right):
    """Legs + boots at (LEFT, RIGHT) 2-wide column pairs; boots widen to
    L-1..L+1 / R-1..R+1 on the boot row."""
    l1, l2 = left
    r1, r2 = right
    for y in V3["leg_rows"]:
        row = grid[y]
        for x in range(4, 20):
            if row[x] == "█":
                row[x] = " "
        row[l1], row[l2], row[r1], row[r2] = "█", "█", "█", "█"
    boot = grid[V3["boot_row"]]
    for x in range(4, 20):
        if boot[x] == "█":
            boot[x] = " "
    for x in range(max(0, l1 - 1), min(V3["w"] - 1, l2 + 1) + 1):
        boot[x] = "█"
    for x in range(max(0, r1 - 1), min(V3["w"] - 1, r2 + 1) + 1):
        boot[x] = "█"


def head_small3(grid, rng):
    """Head shrinks to 2 rows and lifts to the top of the canvas."""
    grid[0] = grid[1][:]
    grid[1] = grid[2][:]
    for x in range(len(grid[2])):
        grid[2][x] = " "


def round_head(grid, rng):
    """Feather the head silhouette: slab and jaw outer edges go ▒."""
    grid[1][6] = "▒"
    grid[1][15] = "▒"
    grid[3][7] = "▒"
    grid[3][14] = "▒"


def smooth_shoulders(grid, rng):
    """Shoulder pads feather: the ▄ corners soften to ▒ with ░ outside."""
    row = grid[V3["traps_row"]]
    row[4] = "▒"
    row[17] = "▒"
    if row[3] == " ":
        row[3] = "░"
    if row[18] == " ":
        row[18] = "░"


def _seam_cells():
    return ((11, 10), (11, 15), (12, 10), (12, 15))


def seam_toggle(grid, rng):
    """Coat seam lines (░ inside the panels) appear or disappear."""
    on = grid[11][10] == "░"
    for y, x in _seam_cells():
        grid[y][x] = "█" if on else "░"


def belt_toggle(grid, rng):
    """Belt line appears or disappears."""
    row = grid[V3["belt_row"]]
    if row[10] == "▓":
        for x in range(10, 14):
            row[x] = "█"
    else:
        for x in range(10, 14):
            row[x] = "▓"


def hem_cuff(grid, rng):
    """Cuffs (arm tips become ▀) and a brighter ▒ hem on the coat."""
    for arm_x in (V3["arm_l"], V3["arm_r"]):
        for y in reversed(range(6, 10)):
            if grid[y][arm_x] in "▐▌":
                grid[y][arm_x] = "▀"
                break
    for x in (7, 18):
        if grid[12][x] == "░":
            grid[12][x] = "▒"


def shadow_extend(grid, rng):
    """The cast shadow widens one cell per side."""
    row = grid[V3["ground_row"]]
    xs = [x for x, c in enumerate(row) if c == "▒"]
    if not xs:
        return
    a, b = min(xs), max(xs)
    if a > 0 and row[a - 1] == "▄":
        row[a - 1] = "▒"
    if b < V3["w"] - 1 and row[b + 1] == "▄":
        row[b + 1] = "▒"


def shadow_shrink(grid, rng):
    """The cast shadow narrows one cell per side (never below 4 wide)."""
    row = grid[V3["ground_row"]]
    xs = [x for x, c in enumerate(row) if c == "▒"]
    if len(xs) <= 4:
        return
    a, b = min(xs), max(xs)
    row[a] = "▄"
    row[b] = "▄"


def coat_open3(grid, rng):
    """The coat gap widens: each panel's inner edge clears one column."""
    for x in (11, 14):
        if grid[11][x] == "█":
            grid[11][x] = " "
        if grid[12][x] == "█":
            grid[12][x] = " "


def coat_flare3(grid, rng):
    """The coat hem bells outward: ░ accents move one column further out."""
    row11 = grid[11]
    if row11[7] == " ":
        row11[7] = "░"
    if row11[18] == " ":
        row11[18] = "░"
    row12 = grid[12]
    for x in (7, 18):
        if row12[x] == "░":
            row12[x] = " "
    if row12[6] == " ":
        row12[6] = "░"
    if row12[19] == " ":
        row12[19] = "░"


def tilt3(grid, dx):
    """Head + neck (rows 0-4) shift one column left/right."""
    for y in range(5):
        row = grid[y]
        cells = [(x, c) for x, c in enumerate(row) if c != " "]
        for x, _ in cells:
            row[x] = " "
        for x, c in cells:
            nx = x + dx
            if 0 <= nx < V3["w"]:
                row[nx] = c


def breath3(grid, direction):
    """Chest (rows 6-7) breathes: ±1 column each edge; waist, coat, arms
    and the belt are untouched."""
    for y in V3["chest_rows"]:
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c == "█"]
        if not xs:
            continue
        if direction == "in":
            for side in (-1, 1):
                edge = min(xs) if side == -1 else max(xs)
                tgt = edge + side
                if 0 <= tgt < V3["w"] and row[tgt] == " ":
                    row[tgt] = "█"
        else:
            a, b = min(xs), max(xs)
            if b - a + 1 <= 8:
                continue  # never narrower than an 8-cell chest
            row[a] = " "
            row[b] = " "


PROPS3 = (
    ("mote", ((1, 17, "•"),)),
    ("ember", ((12, 21, "▓"),)),
    ("glint", ((16, 1, "▖"), (16, 22, "▗"))),
)


def prop3(grid, rng):
    """A minimal glow adjunct: floating mote, ember beside the coat, or a
    spark at the ground-slab edge."""
    kind, cells = PROPS3[rng.randrange(len(PROPS3))]
    for y, x, ch in cells:
        grid[y][x] = ch
    return "prop:" + kind


MUTATIONS3 = (
    ("blink", lambda g, r: blink3(g, r)),
    ("mote-shift", lambda g, r: mote_shift(g, r)),
    ("neck-gap", lambda g, r: neck_gap3(g, r)),
    ("arm-up", lambda g, r: arms3(g, (5, 6, 7))),
    ("arm-down", lambda g, r: arms3(g, (7, 8, 9))),
    ("arm-bend", lambda g, r: arm_bend3(g, r)),
    ("stance-wide", lambda g, r: legs3(g, *V3["legs_wide"])),
    ("stance-narrow", lambda g, r: legs3(g, *V3["legs_narrow"])),
    ("leg-split", lambda g, r: legs3(g, *V3["legs_wide"])),
    ("head-small", lambda g, r: head_small3(g, r)),
    ("round-head", lambda g, r: round_head(g, r)),
    ("smooth-shoulders", lambda g, r: smooth_shoulders(g, r)),
    ("seam-toggle", lambda g, r: seam_toggle(g, r)),
    ("belt-toggle", lambda g, r: belt_toggle(g, r)),
    ("hem-cuff", lambda g, r: hem_cuff(g, r)),
    ("shadow-extend", lambda g, r: shadow_extend(g, r)),
    ("shadow-shrink", lambda g, r: shadow_shrink(g, r)),
    ("coat-open", lambda g, r: coat_open3(g, r)),
    ("coat-flare", lambda g, r: coat_flare3(g, r)),
    ("tilt-left", lambda g, r: tilt3(g, -1)),
    ("tilt-right", lambda g, r: tilt3(g, 1)),
    ("breath-in", lambda g, r: breath3(g, "in")),
    ("breath-out", lambda g, r: breath3(g, "out")),
    ("prop", lambda g, r: prop3(g, r)),
)

# ---------------------------------------------------------------------------
# generation 4 — the Nihei-proportion fluid operative (family "operative-v4")
# ---------------------------------------------------------------------------
#
# Fitness journal (generation 4):
#   "still pretty Atari, not terribly well animated ... no more ball-shaped
#    heads on awkward-proportioned Atari-style figures. We're doing fluid but
#    pixellated renders with all kinds of artistic tricks and finesse points
#    in an evolutionary manner."
# Targets, mapped to concrete art decisions:
#   Nihei proportions  -> tiny 2-row flat wedge head (never round); long neck
#                         with void; narrow sloping shoulders; the coat
#                         dominates ~half the height and reaches wide while
#                         the body stays narrow (vast negative space);
#                         narrow legs with a huge gap between them
#   fluid pixel tricks -> anti-aliased ▒ feathering on all diagonal edges,
#                         motion-blur ░ drag-tails off the coat hem during a
#                         flare, squash-and-stretch on breath, anticipation
#                         (a 1-frame lean before the flare) and staggered
#                         limb motion (the arm follows the shoulder with a
#                         frame delay)
#   no ball heads       -> the head is a flat tilted slab / helmet wedge
#   detail finesse      -> interior coat shading (▓▒░ gradient, lit center to
#                         dark hems), a secondary edge light on one side, an
#                         off-center eye mote that persists through a blink,
#                         a ground contact shadow that SHIFTS with motion
#   loop arc            -> frames cycle anticipation -> action -> settle so
#                         --frames 4 is a closed motion loop
#   terminal-safe       -> <=18 rows, <=24 cols, approved glyphs only
#   deterministic       -> same seed, same JSON (sole entropy is the rng)

BASE4 = (
    "        ██████        ",   #  0 tiny flat slab head (6 wide, no curve)
    "       █▀▀•▀▀█        ",   #  1 eye-slit wedge (tilted, off-center • mote)
    "         ██           ",   #  2 neck band 1
    "         ██           ",   #  3 neck band 2 (long neck, void either side)
    "    ▐    ██     ▌     ",   #  4 narrow shoulders + outer arm starts
    "    ▐  ▄██████▄ ▌     ",   #  5 sloping traps (▄ corners)
    "    ▐ ██████████ ▌    ",   #  6 chest / coat top
    "    ▐ ▓████████▓ ▌    ",   #  7 coat, ▓ gradient (lit centre)
    "     ▓▓████████▓▓     ",   #  8 coat, ▓ widens; arms fold in
    "     ████▓▓  ▓▓████   ",   #  9 coat opens into two panels (▓ seams)
    "     ▒███▓    ▓███▒   ",   # 10 panels, ▓ + edge light ▒
    "     ▓██░      ░██▓   ",   # 11 panels, dark ░ hems
    "    ░░██        ██░░  ",   # 12 hem flare with ░ drag-tails
    "     ██          ██   ",   # 13 narrow legs (wide gap)
    "     ██          ██   ",   # 14 legs
    "     ███        ███   ",   # 15 small boots
    "  ▄▄▄▄▒▒▒▒▒▒▒▒▒▒▄▄▄▄  ",   # 16 ground slab + ▒ cast shadow
)

V4 = {
    "w": 24,
    "head_rows": (0, 1),
    "neck_rows": (2, 3),
    "upper_rows": (4, 5),
    "chest_rows": (6, 7),
    "coat_rows": (8, 9, 10, 11),
    "hem_row": 12,
    "leg_rows": (13, 14),
    "boot_row": 15,
    "ground_row": 16,
    "arm_l": 4,
    "arm_r": 20,
    "legs_base": ((5, 6), (15, 16)),
    "legs_wide": ((4, 5), (17, 18)),
    "legs_narrow": ((6, 7), (13, 14)),
}


def to_grid4():
    return [list(row) for row in BASE4]


def _put(grid, y, x, ch):
    """Bounds-safe cell write: no-op when x is outside the row. Keeps every
    mutation safe against the fixed-width rows of the v4 canvas."""
    if 0 <= y < len(grid) and 0 <= x < len(grid[y]):
        grid[y][x] = ch


def _find_mote4(grid):
    for y in V4["head_rows"]:
        for x, c in enumerate(grid[y]):
            if c == "•":
                return y, x
    return None


def lean4(grid, dx):
    """Anticipation: the head + neck + shoulders shift one column DX while
    the coat (rows 6+) LAGS behind, and the ground shadow shifts opposite.
    The arm columns stay put — a 1-frame staggered delay awaiting a follow."""
    for y in range(0, 6):
        row = grid[y]
        cells = [(x, c) for x, c in enumerate(row)
                 if c != " " and not (c in "▐▌" and x in (V4["arm_l"], V4["arm_r"]))]
        for x, _ in cells:
            row[x] = " "
        for x, c in cells:
            _put(grid, y, x + dx, c)
    shadow_shift(grid, -dx)


def arm_follow(grid, rng):
    """Staggered limb catch-up: the outer arm columns slide one column either
    side (a deferred follow after a lean)."""
    dx = 1 if rng.randrange(2) else -1
    for y in range(4, 9):
        grid[y][V4["arm_l"]] = " "
        grid[y][V4["arm_r"]] = " "
    for y in range(4, 9):
        _put(grid, y, V4["arm_l"] + dx, "▐")
        _put(grid, y, V4["arm_r"] + dx, "▌")


def coat_flare4(grid, rng):
    """Action: the coat hem bells outward and leaves motion-blur ░ drag-tails
    off both outer edges."""
    hem = grid[V4["hem_row"]]
    xs = [x for x, c in enumerate(hem) if c in "░█"]
    if xs:
        a, b = min(xs), max(xs)
        if a > 0 and hem[a - 1] == " ":
            hem[a - 1] = "░"
        if b < len(hem) - 1 and hem[b + 1] == " ":
            hem[b + 1] = "░"
    for y in (11, 12):
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█▓░"]
        if not xs:
            continue
        a, b = min(xs), max(xs)
        if a > 0 and row[a - 1] == " ":
            row[a - 1] = "░"
        if b < len(row) - 1 and row[b + 1] == " ":
            row[b + 1] = "░"


def drag_tail(grid, rng):
    """Motion blur: extra ░ smear cells beyond the hem's outer edge."""
    for y in (11, 12):
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█▓░"]
        if not xs:
            continue
        a, b = min(xs), max(xs)
        if a > 1 and row[a - 1] == " ":
            row[a - 1] = "░"
        if b < len(row) - 1 and row[b + 1] == " ":
            row[b + 1] = "░"


def breath_in4(grid, rng):
    """Squash: the chest widens and the hem panels move inward (flatter),
    reading as the body compressing."""
    for y in V4["chest_rows"]:
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█▓"]
        if not xs:
            continue
        a, b = min(xs), max(xs)
        if a > 0 and row[a - 1] == " ":
            row[a - 1] = "█"
        if b < len(row) - 1 and row[b + 1] == " ":
            row[b + 1] = "█"
    hem = grid[V4["hem_row"]]
    for x, c in enumerate(hem):
        if c == "░" and (x in (4, 5, 18, 19)):
            hem[x] = " "


def breath_out4(grid, rng):
    """Stretch: the chest narrows and a ░ hem row is appended below (a taller
    spread), guarded to keep the frame within 18 rows."""
    for y in V4["chest_rows"]:
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█▓"]
        if len(xs) <= 8:
            continue
        a, b = min(xs), max(xs)
        row[a] = " "
        row[b] = " "
    if len(grid) < 18:
        grid.append(list("     ░░░        ░░░   "))


def feather4(grid, rng):
    """Anti-aliased edges: shoulder ▄ corners soften to ▒ and the chest / hem
    outer cells gain ░ feathering — no hard 90-degree corners."""
    row5 = grid[5]
    for x, c in enumerate(row5):
        if c == "▄":
            row5[x] = "▒"
    for y in (6, 7):
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█▓"]
        if not xs:
            continue
        a, b = min(xs), max(xs)
        _put(grid, y, a - 1, "▒")
        _put(grid, y, b + 1, "▒")


def edgelight4(grid, rng):
    """Secondary light source: a ▓ highlight down one coat-panel edge and a
    ░ shadow down the other (lit from the left)."""
    for y in V4["coat_rows"]:
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c in "█▓▒░"]
        if not xs:
            continue
        a, b = min(xs), max(xs)
        _put(grid, y, a, "▓")
        _put(grid, y, b, "░")


def shadow_shift(grid, dx):
    """The cast shadow slides DX cells, rewriting the ground ▒ band (held to
    at least 4 wide, within the row)."""
    row = grid[V4["ground_row"]]
    xs = [x for x, c in enumerate(row) if c == "▒"]
    if not xs:
        return
    a, b = min(xs), max(xs)
    for x in range(a, b + 1):
        row[x] = "▄"
    na, nb = a + dx, b + dx
    if na < 0 or nb >= len(row) or (nb - na + 1) < 4:
        return
    for x in range(na, nb + 1):
        row[x] = "▒"


def mote_drift4(grid, rng):
    """The eye mote drifts one cell either side (off-centre glint)."""
    pos = _find_mote4(grid)
    if pos is None:
        return
    y, x = pos
    dx = 1 if rng.randrange(2) else -1
    if 0 <= x + dx < len(grid[y]) and grid[y][x + dx] in " ▀":
        _put(grid, y, x, "▀")
        _put(grid, y, x + dx, "•")


def blink4(grid, rng):
    """Eye-slit closes: the pale ▀ darkens to █; the mote persists as eyelight."""
    for y in V4["head_rows"]:
        for x, c in enumerate(grid[y]):
            if c == "▀":
                grid[y][x] = "█"


def tilt4(grid, dx):
    """Head + neck (rows 0-3) shift one column."""
    for y in range(4):
        row = grid[y]
        cells = [(x, c) for x, c in enumerate(row) if c != " "]
        for x, _ in cells:
            row[x] = " "
        for x, c in cells:
            _put(grid, y, x + dx, c)


def legs4(grid, left, right):
    """Legs + boots at (LEFT, RIGHT) 2-wide column pairs."""
    l1, l2 = left
    r1, r2 = right
    for y in V4["leg_rows"]:
        row = grid[y]
        for x in range(1, len(row) - 1):
            if row[x] == "█":
                row[x] = " "
        _put(grid, y, l1, "█")
        _put(grid, y, l2, "█")
        _put(grid, y, r1, "█")
        _put(grid, y, r2, "█")
    boot = grid[V4["boot_row"]]
    for x in range(1, len(boot) - 1):
        if boot[x] == "█":
            boot[x] = " "
    for x in range(l1, l2 + 2):
        _put(grid, V4["boot_row"], x, "█")
    for x in range(r1, r2 + 2):
        _put(grid, V4["boot_row"], x, "█")


def seams4(grid, rng):
    """Coat panel seams appear or disappear (▓ join becomes an open ░ gap)."""
    seam = grid[9][10]
    for y in (8, 9, 10, 11):
        _put(grid, y, 10, "░" if seam == "▓" else "▓")
        _put(grid, y, 11, "░" if seam == "▓" else "▓")


def prop4(grid, rng):
    """A minimal glow adjunct: mote, hem ember, or a ground-edged spark."""
    kinds = (("mote", ((1, 16, "•"),)),
             ("ember", ((12, 22, "▓"),)),
             ("glint", ((16, 1, "▖"), (16, 22, "▗"))))
    kind, cells = kinds[rng.randrange(len(kinds))]
    for y, x, ch in cells:
        _put(grid, y, x, ch)
    return "prop:" + kind


MUTATIONS4 = (
    ("blink", lambda g, r: blink4(g, r)),
    ("mote-drift", lambda g, r: mote_drift4(g, r)),
    ("neck-gap", lambda g, r: _put(g, 2, 9, " ") and _put(g, 2, 10, " ") and None),
    ("lean-left", lambda g, r: lean4(g, -1)),
    ("lean-right", lambda g, r: lean4(g, 1)),
    ("arm-follow", lambda g, r: arm_follow(g, r)),
    ("coat-flare", lambda g, r: coat_flare4(g, r)),
    ("drag-tail", lambda g, r: drag_tail(g, r)),
    ("breath-in", lambda g, r: breath_in4(g, r)),
    ("breath-out", lambda g, r: breath_out4(g, r)),
    ("feather", lambda g, r: feather4(g, r)),
    ("edgelight", lambda g, r: edgelight4(g, r)),
    ("shadow-shift", lambda g, r: shadow_shift(g, 1 if r.randrange(2) else -1)),
    ("stance-wide", lambda g, r: legs4(g, *V4["legs_wide"])),
    ("stance-narrow", lambda g, r: legs4(g, *V4["legs_narrow"])),
    ("leg-split", lambda g, r: legs4(g, *V4["legs_wide"])),
    ("seams", lambda g, r: seams4(g, r)),
    ("tilt-left", lambda g, r: tilt4(g, -1)),
    ("tilt-right", lambda g, r: tilt4(g, 1)),
    ("prop", lambda g, r: prop4(g, r)),
)

# The looped motion arc: frame i draws only from the phase cycle
# (anticipation -> action -> settle), so --frames 4 is a closed loop with a
# clear motion arc off the base pose.
PHASES4 = (
    ("lean-left", "lean-right", "arm-follow", "shadow-shift"),  # anticipation
    ("coat-flare", "drag-tail", "breath-in", "edgelight", "seams"),  # action
    ("breath-out", "feather", "mote-drift", "blink", "stance-narrow",
     "stance-wide", "tilt-left", "tilt-right", "prop", "shadow-shift"),  # settle
)

# ---------------------------------------------------------------------------
# generation 5 — the standardized rig (family "operative-v5")
# ---------------------------------------------------------------------------
#
# Fitness journal (generation 5):
#   "slightly more interesting avatar, but still not animated enough, not
#    recognizable enough, needs more of a standardized appearance — as in two
#    arms and two legs."
# Targets, mapped to concrete art decisions:
#   standardized rig  -> a fixed, readable humanoid skeleton with EXACTLY two
#                        arms (upper + lower arm, visible elbow bend on both
#                        sides in the default pose) and EXACTLY two separated
#                        legs (thigh + shin + boot, a hard gap between them).
#                        Symmetric default pose: reads as "person" instantly.
#   recognizable      -> small head with the eye-slit mote, a visible shoulder
#                        line, central vertical axis, bilateral symmetry,
#                        balanced 1:1:1 head-torso-legs height (the coat-heavy
#                        1:2:1 shape is gone — no flared coat).
#   animation louder  -> an 8-phase loop (not 4): weight transfer (legs
#                        together -> legs apart), a two-arm raise gesture,
#                        blink + inhale, an asymmetric arm swing, a stepping
#                        foot, exhale + tilt, then a settle back to the base
#                        pose. Every frame is clearly different at 0.3-0.5 s.
#   terminal-safe     -> <=18 rows, <=24 cols, approved glyphs only
#   deterministic     -> same seed, same JSON (sole entropy is the rng)

BASE5 = (
    "        ██████          ",   #  0 head slab (6 wide, centered)
    "        █▀▀•▀▀█         ",   #  1 eye-slit with off-center • mote
    "           ██           ",   #  2 neck (2 wide)
    "     ▄████████████▄     ",   #  3 shoulder line / traps
    "  ▐    ████████████   ▌ ",   #  4 chest + upper arms (cols 2/21)
    "   ▐   ██████████    ▌  ",   #  5 chest (V-taper) + arms (cols 3/20)
    "  ▐     ████████      ▌ ",   #  6 waist + forearms bent in (elbow)
    "        ██▓▓▓▓▓▓██      ",   #  7 belt
    "        ██      ██      ",   #  8 hips (legs start, separated)
    "        ██      ██      ",   #  9 thigh
    "        ██      ██      ",   # 10 shin
    "        ██      ██      ",   # 11 shin
    "       ███      ███     ",   # 12 boots (3 wide, clear of shins)
    "  ▄▄▄▄▒▒▒▒▒▒▒▒▒▒▄▄▄▄    ",   # 13 bright ground + ▒ cast shadow
)

V5 = {
    "w": 24,
    "head_rows": (0, 1),
    "neck_row": 2,
    "shoulder_row": 3,
    "chest_rows": (4, 5),
    "waist_row": 6,
    "belt_row": 7,
    "hip_row": 8,
    "leg_rows": (9, 10, 11),
    "boot_row": 12,
    "ground_row": 13,
    "legs_base": ((8, 9), (16, 17)),
    "legs_together": ((9, 10), (15, 16)),
    "legs_apart": ((6, 7), (18, 19)),
}


def to_grid5():
    rows = [list(row) for row in BASE5]
    if any(len(r) != V5["w"] for r in rows):
        raise SystemExit("evolve-operative: BASE5 rows must be 24 cols")
    return rows


def _mote5(grid):
    for y in V5["head_rows"]:
        for x, c in enumerate(grid[y]):
            if c == "•":
                return y, x
    return None


def _arm_zone(grid):
    for y in range(3, 8):
        for x in range(5):
            grid[y][x] = " "
        for x in range(19, 24):
            grid[y][x] = " "


def _arms_default(grid):
    """Two arms, upper + forearm, visible elbow jog on both sides."""
    _arm_zone(grid)
    grid[4][2], grid[4][21] = "▐", "▌"
    grid[5][3], grid[5][20] = "▐", "▌"
    grid[6][2], grid[6][21] = "▐", "▌"


def _arms_raised(grid):
    """Both arms raised high (a clear gesture)."""
    _arm_zone(grid)
    grid[3][1], grid[3][22] = "▐", "▌"
    grid[4][1], grid[4][22] = "▐", "▌"
    grid[5][1], grid[5][22] = "▐", "▌"
    grid[5][3], grid[5][20] = "▄", "▄"  # bent forearms
    grid[6][3], grid[6][20] = "▄", "▄"


def _arms_swing(grid):
    """Left arm raised, right arm lowered (asymmetric swing beat)."""
    _arm_zone(grid)
    grid[3][1], grid[4][1], grid[5][1] = "▐", "▐", "▐"
    grid[5][3], grid[6][3] = "▄", "▄"
    grid[5][21], grid[6][21], grid[7][21] = "▌", "▌", "▌"
    grid[4][22] = "▌"


def _legs_place(grid, left, right):
    """Exactly two separated legs at (LEFT, RIGHT) 2-wide column pairs with
    3-wide boots on the boot row. Keeps the pelvis (row 8) and clears only
    the leg rows below it."""
    # keep the base pelvis so legs stay attached to the torso
    grid[V5["hip_row"]][8] = "█"
    grid[V5["hip_row"]][9] = "█"
    grid[V5["hip_row"]][16] = "█"
    grid[V5["hip_row"]][17] = "█"
    for y in range(9, 13):
        for x in range(3, 21):
            if grid[y][x] == "█":
                grid[y][x] = " "
    l1, l2 = left
    r1, r2 = right
    for y in V5["leg_rows"]:
        grid[y][l1], grid[y][l2] = "█", "█"
        grid[y][r1], grid[y][r2] = "█", "█"
    b = V5["boot_row"]
    for x in range(max(0, l1 - 1), min(23, l2 + 1) + 1):
        grid[b][x] = "█"
    for x in range(max(0, r1 - 1), min(23, r2 + 1) + 1):
        grid[b][x] = "█"


def _step_left(grid):
    """The left foot steps down a row ahead of the right (asymmetric stride):
    left leg rides rows 10/11 with its boot on the boot row, the right leg
    rides 9/10 with its boot one row higher."""
    # keep the base pelvis
    grid[V5["hip_row"]][8] = "█"
    grid[V5["hip_row"]][9] = "█"
    grid[V5["hip_row"]][16] = "█"
    grid[V5["hip_row"]][17] = "█"
    for y in range(9, 13):
        for x in range(3, 21):
            if grid[y][x] == "█":
                grid[y][x] = " "
    # left (forward) leg rides rows 9/10, planted boot on the ground row
    for y in (9, 10):
        grid[y][8], grid[y][9] = "█", "█"
    for x in (7, 8, 9):
        grid[12][x] = "█"
    # right (back) leg rides rows 9/10, boot raised one row
    for y in (9, 10):
        grid[y][16], grid[y][17] = "█", "█"
    for x in (15, 16, 17):
        grid[11][x] = "█"
    _shadow5(grid, -1)


def _head_shift(grid, dx):
    # set-to-absolute: reset the head/neck from the base, then shift once
    for y in V5["head_rows"] + (V5["neck_row"],):
        grid[y] = list(BASE5[y])
    for y in V5["head_rows"] + (V5["neck_row"],):
        row = grid[y]
        cells = [(x, c) for x, c in enumerate(row) if c != " "]
        for x, _ in cells:
            row[x] = " "
        for x, c in cells:
            _put(grid, y, x + dx, c)


def _chest_breath(grid, direction):
    # set-to-absolute: reset the chest rows from the base, then one step
    for y in V5["chest_rows"]:
        grid[y] = list(BASE5[y])
    for y in V5["chest_rows"]:
        row = grid[y]
        xs = [x for x, c in enumerate(row) if c == "█"]
        if not xs:
            continue
        if direction == "in":
            a, b = min(xs), max(xs)
            _put(grid, y, a - 1, "█")
            _put(grid, y, b + 1, "█")
        else:
            a, b = min(xs), max(xs)
            if b - a + 1 <= 8:
                continue
            row[a] = " "
            row[b] = " "


def _chest_reset(grid):
    for y, (a, b) in ((4, (7, 18)), (5, (7, 16))):
        row = grid[y]
        for x in range(4, 20):
            if row[x] == "█" and not (a <= x <= b):
                row[x] = " "


def _shadow5(grid, dx):
    """Shift the v5 cast shadow (ground row 13) DX columns."""
    row = grid[V5["ground_row"]]
    xs = [x for x, c in enumerate(row) if c == "▒"]
    if not xs:
        return
    a, b = min(xs), max(xs)
    for x in range(a, b + 1):
        row[x] = "▄"
    na, nb = a + dx, b + dx
    if na < 0 or nb >= len(row) or (nb - na + 1) < 4:
        return
    for x in range(na, nb + 1):
        row[x] = "▒"


def frame_close(grid, rng):
    """Pose A: legs together, arms hanging bent."""
    _legs_place(grid, *V5["legs_together"])
    _arms_default(grid)


def gesture_raise(grid, rng):
    """A distinct two-arm raise with a head cant."""
    _arms_raised(grid)
    _head_shift(grid, -1)


def blink_inhale(grid, rng):
    """Blink (slit closes, the mote persists as eyelight) + an inhale."""
    for x, c in enumerate(grid[1]):
        if c == "▀":
            grid[1][x] = "█"
    _chest_breath(grid, "in")


def frame_open(grid, rng):
    """Pose B: legs apart (weight transfer), arms back to hanging."""
    _legs_place(grid, *V5["legs_apart"])
    _arms_default(grid)


def swing_arms(grid, rng):
    """Asymmetric arm swing with a shadow shift."""
    _arms_swing(grid)
    _shadow5(grid, -1)


def step_left(grid, rng):
    """The left foot steps forward; shadow shifts with it."""
    _step_left(grid)


def exhale_tilt(grid, rng):
    """Exhale (chest narrows) and the head tilts the other way."""
    _chest_breath(grid, "out")
    _head_shift(grid, 1)


def settle(grid, rng):
    """Return to the symmetric base pose, closing the loop."""
    for y in range(len(grid)):
        grid[y] = list(BASE5[y])


MUTATIONS5 = (
    ("frame-close", frame_close),
    ("gesture-raise", gesture_raise),
    ("blink-inhale", blink_inhale),
    ("frame-open", frame_open),
    ("swing-arms", swing_arms),
    ("step-left", step_left),
    ("exhale-tilt", exhale_tilt),
    ("settle", settle),
)

# The 8-beat loop: weight transfer (A/B), an arm-raise gesture, blink +
# breathe, an arm swing, a stepping foot, and a settle back to base. Each
# phase pool is a single composite so the rng draw pattern (and gens 1-4
# output) is untouched: every frame is base + exactly one directed pose.
PHASES5 = (
    ("frame-close",),   # pose A: legs together
    ("gesture-raise",),  # raise both arms
    ("blink-inhale",),   # blink + inhale
    ("frame-open",),     # pose B: legs apart (weight transfer)
    ("swing-arms",),     # asymmetric arm swing
    ("step-left",),      # foot steps forward
    ("exhale-tilt",),    # exhale + tilt
    ("settle",),         # return to base
)

GENERATIONS = {
    "1": {"family": "operative-v1", "canvas_w": CANVAS_W, "base": BASE,
          "grid": to_grid, "mutations": MUTATIONS},
    "2": {"family": "operative-v2", "canvas_w": CANVAS_W, "base": BASE2,
          "grid": to_grid2, "mutations": MUTATIONS2},
    "3": {"family": "operative-v3", "canvas_w": V3["w"], "base": BASE3,
          "grid": to_grid3, "mutations": MUTATIONS3},
    "4": {"family": "operative-v4", "canvas_w": V4["w"], "base": BASE4,
          "grid": to_grid4, "mutations": MUTATIONS4, "phases": PHASES4},
    "5": {"family": "operative-v5", "canvas_w": V5["w"], "base": BASE5,
          "grid": to_grid5, "mutations": MUTATIONS5, "phases": PHASES5},
}


def breed(seed, frames_n, gen="1"):
    """Produce the full frame-set document for a seed and generation."""
    spec = GENERATIONS[gen]
    rng = random.Random(seed)
    doc = {"family": spec["family"], "seed": seed, "frames": []}
    doc["frames"].append({
        "name": "idle-0",
        "art": to_art(spec["grid"]()),
        "mutations": ["base"],
    })
    for i in range(1, frames_n):
        grid = spec["grid"]()
        applied = []
        pool = spec["mutations"]
        phases = spec.get("phases")
        if phases:
            # looped motion arc: draw from the phase for this frame index
            phase = phases[(i - 1) % len(phases)]
            pool = [m for m in spec["mutations"] if m[0] in phase]
        # fixed rng call sequence: count, then one pick per mutation
        for _ in range(rng.randint(1, 3)):
            name, fn = pool[rng.randrange(len(pool))]
            fn(grid, rng)
            applied.append(name)
        doc["frames"].append({
            "name": f"idle-{i}",
            "art": to_art(grid),
            "mutations": applied,
        })
    return doc


def doc_to_json(doc):
    return json.dumps(doc, indent=2, ensure_ascii=False)


def rig_check(doc):
    """Automated standardized-rig audit: every frame must show exactly two
    separated legs, both arm sides with a visible elbow bend, the head +
    eye mote, and the ground + cast shadow."""
    problems = []
    for frame in doc["frames"]:
        rows = frame["art"].splitlines()
        # legs: cluster non-space █ columns in the leg band (rows 8-12)
        cols = set()
        for y in range(8, 13):
            if y < len(rows):
                for x, ch in enumerate(rows[y]):
                    if ch == "█" and 3 <= x <= 20:
                        cols.add(x)
        runs = []
        for x in sorted(cols):
            if runs and x == runs[-1][-1] + 1:
                runs[-1].append(x)
            else:
                runs.append([x])
        if len(runs) != 2:
            problems.append(f"{frame['name']}: {len(runs)} leg clusters")
        elif runs[1][0] - runs[0][-1] - 1 < 2:
            problems.append(f"{frame['name']}: leg gap < 2 cols")
        # arms: at least one upper/forearm cell per side, bend on a side
        left = {x for y in range(3, 8) for x, c in enumerate(rows[y])
                if c in "▐▌▄" and x < 12}
        right = {x for y in range(3, 8) for x, c in enumerate(rows[y])
                 if c in "▐▌▄" and x >= 12}
        if not left or not right:
            problems.append(f"{frame['name']}: missing arm side")
        elif not (len(left) > 1 or len(right) > 1):
            problems.append(f"{frame['name']}: no visible elbow bend")
        # head, mote, ground, shadow
        if not rows[0].strip() or "•" not in rows[1]:
            problems.append(f"{frame['name']}: head/mote missing")
        if "▄" not in rows[-1] or "▒" not in rows[-1]:
            problems.append(f"{frame['name']}: ground/shadow missing")
    return "pass" if not problems else "fail: " + "; ".join(problems)


def self_grade(gen, seed, frames):
    """The fitness journal: the exact critique as the target, plus a
    computable self-check for the requested generation (bounds, glyphs,
    dimensions, live determinism). Pure and deterministic — no timestamps."""
    doc = breed(seed, frames, gen)
    first = doc["frames"][0]["art"].splitlines()
    bounds_ok = True
    try:
        check_bounds(doc)
    except SystemExit:
        bounds_ok = False
    max_cols = max((len(r) for f in doc["frames"]
                    for r in f["art"].splitlines()), default=0)
    journal5 = {
        "journal": "generation-5 fitness journal",
        "critique": "slightly more interesting avatar, but still not "
                    "animated enough, not recognizable enough, needs more "
                    "of a standardized appearance — as in two arms and two "
                    "legs",
        "targets": [
            "standardized rig: exactly two arms (upper + lower arm with a "
            "visible elbow bend) and exactly two separated legs (thigh + "
            "shin + boot, clear gap)",
            "recognizable at a glance: small head with eye-slit mote, "
            "visible shoulder line, central axis, bilateral symmetry, "
            "balanced 1:1:1 head-torso-legs (no coat-heavy shape)",
            "animation louder: an 8-phase loop with weight transfer, an "
            "arm-raise gesture, blink + breathe, arm swing, a stepping "
            "foot, and a settle — clearly different frames at 0.3-0.5 s",
            "terminal-safe: <=18 rows, <=24 cols, approved glyphs only",
            "deterministic: same seed -> byte-identical JSON",
        ],
    }
    journal4 = {
        "journal": "generation-4 fitness journal",
        "critique": "still pretty Atari, not terribly well animated ... no "
                    "more ball-shaped heads on awkward-proportioned "
                    "Atari-style figures; fluid but pixellated renders with "
                    "artistic tricks and finesse points in an evolutionary "
                    "manner",
        "targets": [
            "Nihei proportions: tiny 2-row flat wedge head, long neck with "
            "void, narrow sloping shoulders, coat-dominant body, narrow legs "
            "with a huge gap",
            "fluid pixel tricks: anti-aliased feathered edges, motion-blur "
            "drag-tails, squash-and-stretch breath, anticipation lean, "
            "staggered limb motion",
            "no ball heads: a flat helmet wedge, never round",
            "detail finesse: interior coat shading gradient, secondary edge "
            "light, persistent eye mote, shifting ground shadow",
            "loop arc: anticipation -> action -> settle across 4 frames",
            "terminal-safe: <=18 rows, <=24 cols, approved glyphs only",
            "deterministic: same seed -> byte-identical JSON",
        ],
    }
    journal = journal5 if gen == "5" else journal4 if gen == "4" else {
        "journal": "generation-3 fitness journal",
        "critique": "grey pixelated faceless humanoid, crude low-resolution "
                    "sprite, jagged edges, lacks detail, feels like a "
                    "placeholder",
        "targets": [
            "smooth silhouette: no hard 90-degree corners; rounded head and "
            "shoulders, feathered edges",
            "visible detail: mote of light in the eye-slit, coat seams, belt "
            "line, cuffs and hem accents",
            "deliberate art: subtle asymmetry and shading gradation, not a "
            "uniform block",
            "grounded: bright ground slab with a cast shadow under the "
            "figure",
            "terminal-safe: <=18 rows, <=24 cols, approved glyphs only",
            "deterministic: same seed -> byte-identical JSON",
        ],
    }
    base_self = {
        "mode": "self-grade",
        "journal": journal["journal"],
        "critique": journal["critique"],
        "targets": journal["targets"],
        "generation": gen,
        "family": doc["family"],
        "seed": seed,
        "frames": len(doc["frames"]),
    }
    self_check = {
        "bounds": "pass" if bounds_ok else "fail",
        "max_cols": max_cols,
        "rows": len(first),
        "deterministic": doc_to_json(doc) == doc_to_json(
            breed(seed, frames, gen)),
    }
    if gen == "5":
        self_check["rig"] = rig_check(doc)
    base_self["self_check"] = self_check
    return base_self


def check_bounds(doc):
    """Fail closed: every frame must fit the terminal safety envelope
    (<=18 rows, <=24 cols) using only the approved glyph set."""
    allowed = set(" █▀▄░▒▓▐ ▌▗▖▝▘•")
    for frame in doc["frames"]:
        rows = frame["art"].splitlines()
        if len(rows) > 18:
            raise SystemExit(
                f"evolve-operative: frame {frame['name']} is {len(rows)} rows")
        for row in rows:
            if len(row) > 24:
                raise SystemExit(
                    f"evolve-operative: frame {frame['name']} row exceeds "
                    f"24 cols: {len(row)}")
            if any(c not in allowed for c in row):
                raise SystemExit(
                    f"evolve-operative: frame {frame['name']} has a "
                    f"disallowed glyph: {row!r}")


def positive_int(raw):
    value = int(raw)
    if value < 1:
        raise argparse.ArgumentTypeError("must be >= 1")
    return value


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="evolve-operative",
        description="Breed evolutionary pixel-art frame-sets for the "
                    "hngh operative (deterministic per seed).")
    ap.add_argument("--gen", choices=("1", "2", "3", "4", "5"), default="1",
                    help="generation: 1 = operative-v1 slab (default), "
                         "2 = operative-v2 humanoid, "
                         "3 = operative-v3 deliberate, "
                         "4 = operative-v4 fluid Nihei, "
                         "5 = operative-v5 standardized rig")
    ap.add_argument("--frames", type=positive_int, default=3,
                    help="number of frames in the mutation walk (default 3)")
    ap.add_argument("--seed", type=int, default=1,
                    help="random seed; same seed -> identical JSON")
    ap.add_argument("--out", metavar="FILE", default=None,
                    help="write the JSON document to FILE instead of stdout")
    ap.add_argument("--self-grade", action="store_true",
                    help="print the fitness journal (critique, targets, "
                         "self-check) for the requested generation")
    args = ap.parse_args(argv)

    if args.self_grade:
        sys.stdout.write(
            json.dumps(self_grade(args.gen, args.seed, args.frames),
                       indent=2, ensure_ascii=False) + "\n")
        return 0

    doc = breed(args.seed, args.frames, args.gen)
    check_bounds(doc)
    payload = doc_to_json(doc) + "\n"
    if args.out:
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(payload)
        print(f"wrote {args.out}", file=sys.stderr)
    else:
        sys.stdout.write(payload)
    return 0


if __name__ == "__main__":
    sys.exit(main())