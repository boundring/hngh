#!/usr/bin/env python3
"""dashboard-tui: the full-screen watch (textual).

A quiet, minimal full-screen TUI over the same committed spine
dashboard-readout renders: the queue ledger, live sessions, the lone
operative with a state-driven caption, and a one-line status. No
daemon, no watcher: one read per tick, read-only.

Data readers are imported from scripts/dashboard-readout (same
SourceFileLoader pattern as generate-publication) so the data layer is
never duplicated. Import safety: that module's top level only scans
sys.argv for its own flags (--watch/--json/--export-html/--theme/...);
none of those match this script's argv, and even a hit would only set
a boolean or dict, never print or read stdin — loading it here cannot
crash or emit.

Usage:
  dashboard-tui [--theme=hngh|matrix|ocean|paper] [--interval N]
                [--no-sessions] [--help]

Bindings: q quit, r refresh now, t cycle theme. Exit 2 when textual
is not importable.
"""

import argparse
import importlib.machinery
import importlib.util
import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

_HINT = ("dashboard-tui: textual not available — pip install --user "
         "--break-system-packages textual (or pacman -S python-textual)")

if os.environ.get("HNGH_NO_TEXTUAL") == "1":
    sys.stderr.write(_HINT + "\n")
    sys.exit(2)
try:
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical
    from textual.theme import Theme
    from textual.widgets import DataTable, Footer, Header, Static
    from rich.text import Text
except ImportError:
    sys.stderr.write(_HINT + "\n")
    sys.exit(2)

_loader = importlib.machinery.SourceFileLoader(
    "dashboard_readout", str(ROOT / "scripts" / "dashboard-readout"))
_spec = importlib.util.spec_from_loader("dashboard_readout", _loader)
dash = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(dash)

# Active-lanes reader — reuse backlog-lanes' parser via the same
# SourceFileLoader pattern (like dashboard-readout above). Import-safe:
# the module only defines functions and ROOT/BACKLOG/QUEUE path
# constants at top level; main() runs only under __main__, never reads
# sys.argv at import, so loading it here cannot crash or emit.
_loader = importlib.machinery.SourceFileLoader(
    "backlog_lanes", str(ROOT / "scripts" / "backlog-lanes"))
_spec = importlib.util.spec_from_loader("backlog_lanes", _loader)
lanes_mod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(lanes_mod)

# The operative — sprite-evolution generation 4 (operative-v4,
# docs/design/operative-frames.md, scripts/evolve-operative --gen 4
# --frames 4 --seed 7): anticipation → action → settle motion arcs with
# anti-aliased edges — rounded head with the eye-slit mote, shoulder
# pads, open coat with belt and hem accents, lit ground slab with cast
# shadow. Four-beat loop: idle-0 base, idle-1 weight shift, idle-2
# motion/breath, idle-3 settle. Embedded verbatim from the generator's
# JSON, driven by the ANIM sequence player below (dwells + breathe
# overlay); every frame is 17 rows tall so cycling never reflows.
FIGURES = [
    """        ██████
       █▀▀•▀▀█
         ██
         ██
    ▐    ██     ▌
    ▐  ▄██████▄ ▌
    ▐ ██████████ ▌
    ▐ ▓████████▓ ▌
     ▓▓████████▓▓
     ████▓▓  ▓▓████
     ▒███▓    ▓███▒
     ▓██░      ░██▓
    ░░██        ██░░
     ██          ██
     ██          ██
     ███        ███
  ▄▄▄▄▒▒▒▒▒▒▒▒▒▒▄▄▄▄""",
    """         ██████
        █▀▀•▀▀█
          ██
          ██
    ▐     ██     ▌
    ▐   ▄██████▄ ▌
    ▐ ██████████ ▌
    ▐ ▓████████▓ ▌
     ▓▓████████▓▓
     ████▓▓  ▓▓████
     ▒███▓    ▓███▒
     ▓██░      ░██▓
    ░░██        ██░░
     ██          ██
     ██          ██
     ███        ███
  ▄▄▒▒▒▒▒▒▒▒▒▒▄▄▄▄▄▄""",
    """        ██████
       █▀▀•▀▀█
         ██
         ██
    ▐    ██     ▌
    ▐  ▄██████▄ ▌
    ▐ ██████████ ▌
    ▐ ▓████████▓ ▌
     ▓▓███░░███▓▓
     ████▓░░ ▓▓████
     ▒███▓░░  ▓███▒
     ▓██░ ░░   ░██▓
    ░░██        ██░░
     ██          ██
     ██          ██
     ███        ███
  ▄▄▄▄▒▒▒▒▒▒▒▒▒▒▄▄▄▄""",
    """        ██████
       █▀▀•▀▀█
         ██
         ██
    ▐    ██     ▌
    ▐  ▄██████▄ ▌
    ▐ ██████████ ▌
    ▐ ▓████████▓ ▌
     ▓▓████████▓▓
     ████▓▓  ▓▓████
     ▒███▓    ▓███▒
     ▓██░      ░██▓
    ░░██        ██░░
    ██           ██
    ██           ██
    ███          ███
  ▄▄▄▄▒▒▒▒▒▒▒▒▒▒▄▄▄▄""",
]

# The sequence player. Each step picks a frame (int index into FIGURES,
# or an inline multi-line art string) and a dwell in seconds; the player
# advances on a monotonic deadline, independent of the data refresh
# interval, and wraps around to loop the idle. v4 is a phase loop —
# base → anticipation → action → settle — with per-phase dwells; long
# base/settle dwells carry the breathe overlay so the figure is never
# frozen, reading anticipation→action→settle rather than a 1s blink.
ANIM_IDLE = [
    {"frame": 0, "dwell": 1.4},   # base
    {"frame": 1, "dwell": 0.25},  # anticipation (lean right, coat lags)
    {"frame": 2, "dwell": 0.3},   # action (seams open)
    {"frame": 3, "dwell": 1.2},   # settle (stance wide)
]
ANIM_ACTIVE = [
    {"frame": 1, "dwell": 0.12},   # anticipation, quickened
    {"frame": 2, "dwell": 0.2},    # action
    {"frame": 3, "dwell": 0.18},   # settle
    {"frame": 0, "dwell": 0.3},    # base
]

# Theme presets: quiet dark is the default; the rest are the named
# alternatives. All four are registered so `t` is native theme switching.
THEMES = [
    Theme(name="hngh", primary="#5af78e", secondary="#3d9c78",
          accent="#5af78e", foreground="#c8d0d8", background="#0b0e11",
          surface="#11151a", panel="#14181e", warning="#e6b450",
          error="#e06c6c", success="#5af78e", dark=True),
    Theme(name="matrix", primary="#00ff9f", secondary="#00b36b",
          accent="#00ff9f", foreground="#9fffbf", background="#050805",
          surface="#08120b", panel="#0a160d", warning="#d4ff00",
          error="#ff4444", success="#00ff9f", dark=True),
    Theme(name="ocean", primary="#4fc3ff", secondary="#2d7dab",
          accent="#4fc3ff", foreground="#a8d8f0", background="#04121f",
          surface="#071d2e", panel="#082336", warning="#ffb454",
          error="#ff6b6b", success="#4fc3ff", dark=True),
    Theme(name="paper", primary="#2f6fb0", secondary="#4a90c2",
          accent="#b03030", foreground="#1f2328", background="#f4f1ea",
          surface="#ffffff", panel="#efece4", warning="#8a6d1a",
          error="#b03030", success="#2f6fb0", dark=False),
]
PRESETS = [t.name for t in THEMES]

# State coloring for sessions; everything else stays plain.
_STATE_COLOR = {"running": None, "evacuated": "warning",
                "cancelled": "text-muted", "dead": "error"}


def _cut(text, n):
    """Truncate to N cells with an ellipsis; None-safe."""
    if not text:
        return ""
    text = str(text)
    return text if len(text) <= n else text[: max(0, n - 1)] + "…"


def _kw_text(text, accent):
    """Render TEXT with domain keywords tinted in the accent, with a
    leading space for column breathing room."""
    out = Text(" ")
    words = sorted(dash.KEYWORD_HIGHLIGHT, key=len, reverse=True)
    i, n = 0, len(text)
    while i < n:
        for w in words:
            if text.startswith(w, i):
                out.append(w, f"bold {accent}")
                i += len(w)
                break
        else:
            out.append(text[i])
            i += 1
    return out


def _styled(text, style):
    """Render TEXT with an explicit style as a rich Text cell."""
    return Text(text, style=style) if style else text


def _frame_art(step):
    """Resolve an ANIM step's frame: an int indexes FIGURES, a string is
    inline art used as-is."""
    f = step["frame"]
    return f if isinstance(f, str) else FIGURES[f]


def _breathe_art(base, inhale):
    """A subtle 2-frame breathe overlay: find the rows (torso band) whose
    longest contiguous █ run is widest and widen/narrow it by one cell
    per side. Only the single widest torso row changes, so the figure
    breathes ±1 cell without mangling the fragmented ▓░▒ garment rows.
    Lines are left as-is (already uniform width), so the panel never
    reflows."""
    rows = base.splitlines()
    width = max(len(r) for r in rows)
    best = None  # (run_len, row_idx, start, end) of the widest clean run
    for idx in range(5, 10):
        row = rows[idx]
        start = run = 0
        for col, ch in enumerate(row):
            if ch == "█":
                if run == 0:
                    start = col
                run += 1
            elif run:
                hit = (run >= 6 and start > 0
                       and col < len(row.rstrip()))
                if hit and (best is None or run > best[0]):
                    best = (run, idx, start, col)
                run = 0
        if run and (best is None or run > best[0]) \
                and start > 0 and len(row.rstrip()) > start + run:
            best = (run, idx, start, start + run)
    out = []
    for idx, row in enumerate(rows):
        if best and idx == best[1]:
            _, _, start, end = best
            if inhale:
                # widen one each side: swap the flanking spaces to █
                row = row[: start - 1] + "█" + row[start:]
                row = row[:end] + "█" + row[end:]
            else:
                # narrow one each side: swap a run-edge █ to space
                row = row[:start] + " " + row[start + 1:]
                row = row[: end - 1] + " " + row[end - 1:]
        out.append(row.ljust(width))
    return "\n".join(out)


def _dance_level():
    """Audio pulse 0..10, mirroring dashboard-readout.dance_level()'s
    auto branch (not importable as-is: it keys off --dance in argv).
    Fails safe to 0 — no sound system, no number, no crash."""
    try:
        out = subprocess.run(
            [sys.executable, str(ROOT / "scripts" / "audio-intensity")],
            capture_output=True, text=True, timeout=2)
        return int(out.stdout.strip() or 0)
    except Exception:
        return 0


def _lanes(max_rows=10):
    """Active backlog lanes (done ✓ / queued ▪ / open ·, Q = in queue,
    date). Bounded and non-fatal: a missing backlog or parse error yields
    an empty list, never a crash. Open lanes (the active-development
    view) first, then queued, then done."""
    try:
        lanes = lanes_mod.parse_backlog([])
    except Exception:
        return []
    order = {"open": 0, "queued": 1, "done": 2}
    lanes.sort(key=lambda l: (order.get(l.get("status"), 3),
                              l.get("date") or ""))
    return lanes[:max_rows]


def _state(queued, done, sessions):
    """Same state selection dashboard-readout's rich watch uses."""
    if any(s.get("state") == "running" for s in sessions):
        return "active"
    if not queued and done:
        return "done"
    if queued:
        return "idle"
    return "empty"


class HnghTUI(App):
    TITLE = "hngh"
    CSS = """
    #operative {
        width: 28;
        border: round $primary;
        padding: 0 1 1 1;
    }
    #figure {
        color: $primary;
        text-style: bold;
        height: auto;
    }
    #caption {
        color: $text-muted;
        height: auto;
        text-wrap: wrap;
    }
    #right {
        height: 1fr;
    }
    DataTable {
        border: round $primary;
        height: 1fr;
        padding: 0 1;
    }
    DataTable > .datatable--header {
        text-style: bold;
        color: $primary;
    }
    DataTable > .datatable--cursor {
        background: $primary 12%;
    }
    #status {
        color: $text-muted;
        height: 1;
    }
    """
    BINDINGS = [
        Binding("q", "quit", "quit"),
        Binding("ctrl+c", "quit", "quit", show=False),
        Binding("r", "refresh", "refresh"),
        Binding("t", "cycle_theme", "theme"),
    ]

    def __init__(self, interval=4, no_sessions=False, theme="hngh"):
        super().__init__()
        for preset in THEMES:
            self.register_theme(preset)
        self.theme = theme if theme in PRESETS else "hngh"
        self.interval = max(1, int(interval))
        self.no_sessions = no_sessions
        self._tick = 0

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Horizontal():
            with Vertical(id="operative"):
                yield Static(FIGURES[0], id="figure")
                yield Static("", id="caption")
            with Vertical(id="right"):
                yield DataTable(id="queue", cursor_type="none")
                yield DataTable(id="sessions", cursor_type="none")
                yield DataTable(id="lanes", cursor_type="none")
                yield Static("", id="status")
        yield Footer()

    def on_mount(self):
        # Sequence-player state (UI thread): the anim sequence, a
        # monotonic deadline, and the last art shown (dedupe).
        self._anim_seq = ANIM_IDLE
        self._anim_index = 0
        self._anim_next_at = 0.0
        self._state_now = "idle"
        self._pace = 1.0
        self._last_art = FIGURES[0]
        self.set_interval(0.1, self._anim_tick)
        self.query_one("#operative").border_title = "operative"
        queue = self.query_one("#queue", DataTable)
        queue.border_title = "queue"
        id_key, _, eta_key = queue.add_columns("ID", "glyph", "ETA")
        queue.columns[id_key].width = 26
        queue.columns[eta_key].width = 50
        sessions = self.query_one("#sessions", DataTable)
        sessions.border_title = "sessions"
        keys = sessions.add_columns("run", "store", "state", "age", "mission")
        for key, width in zip(keys[:4], (6, 26, 11, 7)):
            sessions.columns[key].width = width
        lanes = self.query_one("#lanes", DataTable)
        lanes.border_title = "active lanes"
        lanes.add_columns("id", "glyph", "Q", "date")
        self.set_interval(self.interval, self.refresh_tick)
        self.refresh_tick()

    def _anim_tick(self):
        """Sequence player, on the UI thread (10Hz decision tick).
        Static.update fires only when the art actually changes, so the
        tick never churns the screen. Beats advance on a monotonic
        deadline; between long base dwells a 3s breathe overlay keeps the
        figure moving."""
        now = time.monotonic()
        step = self._anim_seq[self._anim_index]
        dwell = step["dwell"] * self._pace
        if now >= self._anim_next_at:
            # advance to the next beat (wraps around to loop the idle)
            self._anim_index = (self._anim_index + 1) % len(self._anim_seq)
            self._anim_next_at = now + dwell
            self._show(_frame_art(step))
        elif step["frame"] in (0, 3) and dwell >= 0.8:
            # long base/settle dwell: breathe (torso ±1 on a 3s cycle)
            age = now - (self._anim_next_at - dwell)
            self._show(_breathe_art(_frame_art(step), (age % 3.0) < 1.5))

    def _show(self, art):
        if art != self._last_art:
            self._last_art = art
            self.query_one("#figure", Static).update(art)

    def _switch_seq(self, active):
        """Restart the sequence at a pace matching the session state:
        running = quicker, more energetic beats; idle = long dwells."""
        want = ANIM_ACTIVE if active else ANIM_IDLE
        pace = 0.65 if active else 1.0
        if want is not self._anim_seq or pace != self._pace:
            self._anim_seq = want
            self._pace = pace
            self._anim_index = 0
            self._anim_next_at = 0.0  # restart on the next tick

    def refresh_tick(self):
        # Heavy reads (session_rows can spawn sbcl) stay off the UI
        # thread; exclusive so slow ticks never stack.
        self.run_worker(self._gather, thread=True, exclusive=True)

    def _gather(self):
        items = dash.queue_items()
        etas = dash.queue_etas()
        # ttl=15 leans on dashboard-readout's own session cache.
        sessions = ([] if self.no_sessions
                    else dash.session_rows(limit=5, ttl=15))
        lanes = _lanes()
        dance = _dance_level()
        self.call_from_thread(self._paint, items, etas, sessions, lanes,
                              dance)

    def _paint(self, items, etas, sessions, lanes, dance):
        self._tick += 1
        vars_ = self.theme_variables
        accent = vars_.get("primary", "#5af78e")
        dim = vars_.get("text-muted", "#888888")
        glyph = {"queued": ("▪", dim), "active": ("+", f"bold {accent}"),
                 "done": ("✓", accent)}

        queue = self.query_one("#queue", DataTable)
        queue.clear()
        for i, status in items:
            mark, style = glyph.get(status, ("▪", dim))
            eta = _kw_text(_cut(etas.get(i, ""), 50), accent)
            queue.add_row(f" {_cut(i, 24)}",
                          _styled(f" {mark}", style), eta)

        sessions_w = self.query_one("#sessions", DataTable)
        sessions_w.clear()
        for s in sessions:
            state = s.get("state", "?")
            color = _STATE_COLOR.get(state)
            state_text = _styled(f" {state}", color)
            store = s.get("store", "").removeprefix("run-")
            mission = _kw_text(_cut(s.get("mission", ""), 44), accent)
            sessions_w.add_row(f" {_cut(s.get('run', '?'), 6)}",
                               f" {_cut(store, 24)}", state_text,
                               f" {dash.age_text(s.get('age'))}", mission)

        lanes_w = self.query_one("#lanes", DataTable)
        lanes_w.clear()
        lg = {"done": ("✓", accent), "queued": ("▪", dim),
              "open": ("·", dim)}
        for ln in lanes:
            mark, style = lg.get(ln.get("status", "open"), ("·", dim))
            lanes_w.add_row(f" {_cut(ln.get('id', ''), 30)}",
                            _styled(f" {mark}", style),
                            " Q" if ln.get("in_queue") else " ",
                            f" {ln.get('date') or '—'}")

        queued = [i for i, st in items if st == "queued"]
        done = [i for i, st in items if st == "done"]
        state = _state(queued, done, sessions)
        # state-reactive pacing: running sessions pick the energetic
        # sequence and a quicker pulse (UI thread; timer only reads it)
        self._state_now = state
        self._switch_seq(state == "active")
        line = dash.SPEECH[state][self._tick % len(dash.SPEECH[state])]
        caption = self.query_one("#caption", Static)
        caption.update(line + (f"  music {dance}/10" if dance else ""))

        status = (f"updated {datetime.now().strftime('%H:%M:%S')} · "
                  f"every {self.interval}s · dance {dance}/10 · "
                  f"{len(sessions)} session(s)")
        self.query_one("#status", Static).update(status)

    def action_cycle_theme(self):
        self.theme = PRESETS[(PRESETS.index(self.theme) + 1) % len(PRESETS)]

    def action_refresh(self):
        self.refresh_tick()


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False, prog="dashboard-tui")
    parser.add_argument("--help", action="store_true")
    parser.add_argument("--theme",
                        help="initial preset: hngh|matrix|ocean|paper")
    parser.add_argument("--interval", type=int, default=4,
                        help="refresh seconds (default 4)")
    parser.add_argument("--no-sessions", action="store_true",
                        help="omit the live sessions table")
    args = parser.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0
    HnghTUI(interval=args.interval, no_sessions=args.no_sessions,
            theme=args.theme or "hngh").run()
    return 0


if __name__ == "__main__":
    sys.exit(main())