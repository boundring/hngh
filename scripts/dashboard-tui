          surface="#ffffff", panel="#efece4", warning="#8a6d1a",
          error="#b03030", success="#2f6fb0", dark=False),
]
PRESETS = [t.name for t in THEMES]

# Evolve-dashboard-style mount: if a fittest overlay was bred, apply its
# color fields to the matching preset so the accepted variant is live.
EVOLVE_OVERLAY = ROOT / "docs" / "design" / "ui-evolve" / "current-overlay.json"


def _apply_overlay():
    if not EVOLVE_OVERLAY.exists():
        return
    try:
        doc = json.loads(EVOLVE_OVERLAY.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    fields = doc.get("fields") or {}
    name = doc.get("preset")
    if not name:
        return
    for t in THEMES:
        if t.name == name:
            for attr in ("primary", "secondary", "accent", "foreground",
                         "background", "surface", "panel", "warning",
                         "error", "success"):
                if attr in fields:
                    setattr(t, attr, fields[attr])
            if "dark" in fields:
                t.dark = bool(fields["dark"])
            break


_apply_overlay()

# State coloring for sessions. Beacon runs (scheduled pings that
# lib/hngh-record.sh closes cancelled BY DESIGN) render dim/green as
# "beacon" so the panel doesn't read as a wall of alarming cancellations;
# true failures (dead/evacuated/non-beacon cancelled) stay distinctly
# colored so they still read.
_STATE_COLOR = {"running": "bold", "evacuated": "warning",
                "cancelled": "warning", "dead": "error"}

# Scheduled-beacon mission kinds (from the research: 42 store runs, all
# hourly-ping beacons closed cancelled by design; 7 healthy timers). The
# known jobs were cancelled; the automation fix now closes exit-0 runs
# evacuated, so both states classify as beacon. Any other mission that
# reads as a timed beacon (clock tail) is classified generically so
# newer automation labels are covered without knowing their names.
BEACON_KINDS = ("hourly research ping", "morning digest", "security check",
                "night agent", "night research", "model benchmark",
                "morning report")
_CLOCK_TAIL = re.compile(r"\s(\d{1,2}[:.]?\d{2}(?::\d{2})?)\s*$")


def _beacon_kind(mission):
    """Return the beacon kind text (string) when MISSION is a scheduled
    ping/check, else None. Known kinds match by prefix; every other
    mission ending in a clock token (e.g. 'security check 2000',
    'nightly audit 02:00') is a beacon whose kind is the leading prose."""
    m = (mission or "").strip()
    if not m:
        return None
    low = m.lower()
    for kind in BEACON_KINDS:
        if low.startswith(kind):
            return kind
    if _CLOCK_TAIL.search(m):
        return m[:_CLOCK_TAIL.search(m).start()].strip() or "scheduled check"
    return None


def _cut(text, n):
    """Truncate to N cells with an ellipsis; None-safe."""
    if not text:
        return ""
    text = str(text)
    return text if len(text) <= n else text[: max(0, n - 1)] + "…"


def _kw_text(text, accent):
    """Render TEXT with domain keywords tinted in the accent, with a
    leading space for column breathing room."""
    out = Text(" ")
    words = sorted(dash.KEYWORD_HIGHLIGHT, key=len, reverse=True)
    i, n = 0, len(text)
    while i < n:
        for w in words:
            if text.startswith(w, i):
                out.append(w, f"bold {accent}")
                i += len(w)
                break
        else:
            out.append(text[i])
            i += 1
    return out


def _styled(text, style):
    """Render TEXT with an explicit style as a rich Text cell."""
    return Text(text, style=style) if style else text


def _frame_art(step):
    """Resolve an ANIM step's frame: an int indexes FIGURES, a string is
    inline art used as-is."""
    f = step["frame"]
    return f if isinstance(f, str) else FIGURES[f]


def _breathe_art(base, inhale):
    """A subtle 2-frame breathe overlay: find the rows (torso band) whose
    longest contiguous █ run is widest and widen/narrow it by one cell
    per side. Only the single widest torso row changes, so the figure
    breathes ±1 cell without mangling the fragmented ▓░▒ garment rows.
    Lines are left as-is (already uniform width), so the panel never
    reflows."""
    rows = base.splitlines()
    width = max(len(r) for r in rows)
    best = None  # (run_len, row_idx, start, end) of the widest clean run
    for idx in range(5, 10):
        row = rows[idx]
        start = run = 0
        for col, ch in enumerate(row):
            if ch == "█":
                if run == 0:
                    start = col
                run += 1
            elif run:
                hit = (run >= 6 and start > 0
                       and col < len(row.rstrip()))
                if hit and (best is None or run > best[0]):
                    best = (run, idx, start, col)
                run = 0
        if run and (best is None or run > best[0]) \
                and start > 0 and len(row.rstrip()) > start + run:
            best = (run, idx, start, start + run)
    out = []
    for idx, row in enumerate(rows):
        if best and idx == best[1]:
            _, _, start, end = best
            if inhale:
                # widen one each side: swap the flanking spaces to █
                row = row[: start - 1] + "█" + row[start:]
                row = row[:end] + "█" + row[end:]
            else:
                # narrow one each side: swap a run-edge █ to space
                row = row[:start] + " " + row[start + 1:]
                row = row[: end - 1] + " " + row[end - 1:]
        out.append(row.ljust(width))
    return "\n".join(out)


def _dance_level():
    """Audio pulse 0..10, mirroring dashboard-readout.dance_level()'s
    auto branch (not importable as-is: it keys off --dance in argv).
    Fails safe to 0 — no sound system, no number, no crash."""
    try:
        out = subprocess.run(
            [sys.executable, str(ROOT / "scripts" / "audio-intensity")],
            capture_output=True, text=True, timeout=2)
        return int(out.stdout.strip() or 0)
    except Exception:
        return 0


def _lanes(max_rows=10):
    """Active backlog lanes (done ✓ / queued ▪ / open ·, Q = in queue,
    date). Bounded and non-fatal: a missing backlog or parse error yields
    an empty list, never a crash. Open lanes (the active-development
    view) first, then queued, then done."""
    try:
        lanes = lanes_mod.parse_backlog([])
    except Exception:
        return []
    order = {"open": 0, "queued": 1, "done": 2}
    lanes.sort(key=lambda l: (order.get(l.get("status"), 3),
                              l.get("date") or ""))
    return lanes[:max_rows]


REPORT_QUEUE = ROOT / "scripts" / "report-queue"
_REPORT_BODIES = ROOT / "docs" / "project" / "report-bodies"
_REPORT_GLYPH = {"progress": "⚙", "expense": "₹", "optimization": "↑",
                 "scheduled": "⏰", "alert": "⚠"}


def _reports(maxrows=5, timeout=4):
    """The newest report rows, the unread count, and whether the queue
    answered at all. Fail closed: a missing script, timeout, or bad
    payload yields ([], 0, False) — the dashboards never crash on the
    queue's absence (it is another lane's in-flight work)."""
    try:
        out = subprocess.run(
            [sys.executable, str(REPORT_QUEUE), "--json", "--unread"],
            capture_output=True, text=True, timeout=timeout)
        if out.returncode != 0:
            return [], 0, False
        doc = json.loads(out.stdout)
        reports = doc.get("reports") or []
        unread = int(doc.get("unread") or len(reports))
    except Exception:
        return [], 0, False
    return reports[:maxrows], unread, True


def _newest_unseen(seen, reports):
    """The newest report whose id is not in SEEN (REPORTS are
    newest-first), else None. Pure, so the unit test drives it without
    a running TUI."""
    for r in reports:
        if r.get("id") not in seen:
            return r
    return None


def _report_body_text(report):
    """The full body of REPORT: the report-bodies file named by the
    body key when present, else the first line. Fail closed — any
    missing/unreadable body falls back to the first line."""
    first = report.get("first_line") or ""
    key = report.get("body")
    if key:
        name = Path(str(key).removesuffix(".md")).name
        for cand in (_REPORT_BODIES / f"{name}.md", Path(str(key))):
            try:
                if cand.is_file():
                    text = cand.read_text(encoding="utf-8").strip()
                    if text:
                        return text
            except OSError:
                pass
    return first


def _state(queued, done, sessions):
    """Same state selection dashboard-readout's rich watch uses."""
    if any(s.get("state") == "running" for s in sessions):
        return "active"
    if not queued and done:
        return "done"
    if queued:
        return "idle"
    return "empty"


class ReportModal(ModalScreen):
    """Pop-in report viewer: rounded border, keyword-tinted full body.
    Dismiss with r / ESC / a click on the dimmed backdrop. Nothing here
    ever advances the queue cursor (the operator's --mark-read owns
    that) — the app records the id in its in-session seen set."""
    CSS = """
    ReportModal {
        align: center middle;
    }
    #report-modal {
        width: 78;
        max-height: 80%;
        border: round $primary;
        padding: 1 2;
        background: $surface;
        color: $text;
    }
    #report-title {
        text-style: bold;
        color: $primary;
    }
    #report-body {
        height: auto;
        text-wrap: wrap;
        margin-top: 1;
    }
    """
    BINDINGS = [
        Binding("r", "dismiss_modal", "close"),
        Binding("escape", "dismiss_modal", "close", show=False),
    ]

    def __init__(self, report, accent):
        super().__init__()
        self._report = report
        self._accent = accent
        self._text = _report_body_text(report)

    def compose(self) -> ComposeResult:
        kind = (self._report.get("kind") or "report").upper()
        with Vertical(id="report-modal"):
            yield Static(f"report · {kind}", id="report-title")
            yield Static("", id="report-body")

    def on_mount(self):
        self.query_one("#report-body", Static).update(
            _kw_text(self._text, self._accent))

    def action_dismiss_modal(self):
        self.dismiss(self._report)

    def on_click(self, event):
        # a click on the dimmed backdrop (not the box) dismisses
        if event.widget is self:
            self.dismiss(self._report)


class HnghTUI(App):
    TITLE = "hngh"
    CSS = """
    #operative {
        width: 32;
        border: round $primary;
        padding: 0 1 1 1;
    }
    #figure {
        color: $primary;
        text-style: bold;
        height: auto;
    }
    #caption {
        color: $text-muted;
        height: auto;
        text-wrap: wrap;
    }
    #right {
        height: 1fr;
    }
    DataTable {
        border: round $primary;
        height: 1fr;
        padding: 0 1;
    }
    DataTable > .datatable--header {
        text-style: bold;
        color: $primary;
    }
    DataTable > .datatable--cursor {
        background: $primary 12%;
    }
    #reports {
        height: auto;
        max-height: 8;
    }
    #roster {
        height: auto;
        max-height: 10;
    }
    #status {
        color: $text-muted;
        height: 2;
    }
    """
    BINDINGS = [
        Binding("q", "quit", "quit"),
        Binding("ctrl+c", "quit", "quit", show=False),
        Binding("r", "refresh", "refresh"),
        Binding("t", "cycle_theme", "theme"),
    ]

    def __init__(self, interval=4, no_sessions=False, theme="hngh"):
        super().__init__()
        for preset in THEMES:
            self.register_theme(preset)
        self.theme = theme if theme in PRESETS else "hngh"
        self.interval = max(1, int(interval))
        self.no_sessions = no_sessions
        self._tick = 0
        self._seen_reports = set()
        self._modal_open = False

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Horizontal():
            with Vertical(id="operative"):
                yield Static(FIGURES[0], id="figure")
                yield Static("", id="caption")
            with Vertical(id="right"):
                yield DataTable(id="queue", cursor_type="none")
                yield DataTable(id="sessions", cursor_type="none")
                yield DataTable(id="lanes", cursor_type="none")
                yield DataTable(id="reports", cursor_type="none")
                yield DataTable(id="roster", cursor_type="none")
                yield Static("", id="status")
        yield Footer()

    def on_mount(self):
        # Sequence-player state (UI thread): the anim sequence, a
        # monotonic deadline, and the last art shown (dedupe).
        self._anim_seq = ANIM_IDLE
        self._anim_index = 0
        self._anim_next_at = 0.0
        self._state_now = "idle"
        self._pace = 1.0
        self._last_art = FIGURES[0]
        self.set_interval(0.1, self._anim_tick)
        self.query_one("#operative").border_title = "operative"
        queue = self.query_one("#queue", DataTable)
        queue.border_title = "queue"
        id_key, _, eta_key = queue.add_columns("ID", "glyph", "ETA")
        queue.columns[id_key].width = 26
        queue.columns[eta_key].width = 50
        sessions = self.query_one("#sessions", DataTable)
        sessions.border_title = "sessions"
        keys = sessions.add_columns("run", "store", "state", "age", "mission")
        for key, width in zip(keys[:4], (6, 26, 11, 7)):
            sessions.columns[key].width = width
        lanes = self.query_one("#lanes", DataTable)
        lanes.border_title = "active lanes"
        lanes.add_columns("id", "glyph", "Q", "date")
        reports = self.query_one("#reports", DataTable)
        reports.border_title = "reports"
        keys = reports.add_columns("kind", "latest")
        reports.columns[keys[0]].width = 6
        roster = self.query_one("#roster", DataTable)
        roster.border_title = "live agents"
        keys = roster.add_columns("id", "state", "source", "mission")
        for key, width in zip(keys[:3], (20, 11, 11)):
            roster.columns[key].width = width
        self.set_interval(self.interval, self.refresh_tick)
        self.refresh_tick()

    def _anim_tick(self):
        """Sequence player, on the UI thread (10Hz decision tick).
        Static.update fires only when the art actually changes, so the
        tick never churns the screen. Beats advance on a monotonic
        deadline; between long base dwells a 3s breathe overlay keeps the
        figure moving."""
        now = time.monotonic()
        step = self._anim_seq[self._anim_index]
        dwell = step["dwell"] * self._pace
        if now >= self._anim_next_at:
            # advance to the next beat (wraps around to loop the idle)
            self._anim_index = (self._anim_index + 1) % len(self._anim_seq)
            self._anim_next_at = now + dwell
            self._show(_frame_art(step))
        elif step["frame"] in (0, len(FIGURES) - 1) and dwell >= 0.4:
            # long base/exhale dwell: breathe (torso ±1 on a 3s cycle)
            age = now - (self._anim_next_at - dwell)
            self._show(_breathe_art(_frame_art(step), (age % 3.0) < 1.5))

    def _show(self, art):
        if art != self._last_art:
            self._last_art = art
            self.query_one("#figure", Static).update(art)

    def _switch_seq(self, active):
        """Restart the sequence at a pace matching the session state:
        running = quicker, more energetic beats; idle = long dwells."""
        want = ANIM_ACTIVE if active else ANIM_IDLE
        pace = 0.65 if active else 1.0
        if want is not self._anim_seq or pace != self._pace:
            self._anim_seq = want
            self._pace = pace
            self._anim_index = 0
            self._anim_next_at = 0.0  # restart on the next tick

    def refresh_tick(self):
        # Heavy reads (session_rows can spawn sbcl) stay off the UI
        # thread; exclusive so slow ticks never stack.
        self.run_worker(self._gather, thread=True, exclusive=True)

    def _gather(self):
        items = dash.queue_items()
        etas = dash.queue_etas()
        # ttl=15 leans on dashboard-readout's own session cache.
        sessions = ([] if self.no_sessions
                    else dash.session_rows(limit=5, ttl=15))
        roster = dash.roster_rows(ttl=15)
        lanes = _lanes()
        dance = _dance_level()
        reports, unread, alive = _reports()
        self.call_from_thread(self._paint, items, etas, sessions, roster,
                              lanes,
                              dance, reports, unread, alive)

    def _paint(self, items, etas, sessions, roster, lanes, dance,
               reports, unread, alive):
        self._tick += 1
        vars_ = self.theme_variables
        accent = vars_.get("primary", "#5af78e")
        dim = vars_.get("text-muted", "#888888")
        glyph = {"queued": ("▪", dim), "active": ("+", f"bold {accent}"),
                 "done": ("✓", accent)}

        queue = self.query_one("#queue", DataTable)
        queue.clear()
        for i, status in items:
            mark, style = glyph.get(status, ("▪", dim))
            eta = _kw_text(_cut(etas.get(i, ""), 50), accent)
            queue.add_row(f" {_cut(i, 24)}",
                          _styled(f" {mark}", style), eta)

        sessions_w = self.query_one("#sessions", DataTable)
        sessions_w.clear()
        kinds_seen = set()
        for s in sessions:
            state = s.get("state", "?")
            store = s.get("store", "").removeprefix("run-")
            mission_text = s.get("mission", "")
            kind = _beacon_kind(mission_text)
            if state in ("cancelled", "evacuated") and kind:
                # a scheduled beacon closed cancelled/evacuated BY DESIGN
                # (the automation records exit-0 jobs either way): dim
                # "beacon", mission truncated to its kind prefix + time
                kinds_seen.add(kind)
                state_text = _styled(" beacon", "dim")
                mission = _kw_text(
                    _cut(mission_text[: len(kind) + 6], 44), accent)
            else:
                color = _STATE_COLOR.get(state, "text-muted")
                state_text = _styled(f" {state}", color)
                mission = _kw_text(_cut(mission_text, 44), accent)
            sessions_w.add_row(f" {_cut(s.get('run', '?'), 6)}",
                               f" {_cut(store, 24)}", state_text,
                               f" {dash.age_text(s.get('age'))}", mission)

        lanes_w = self.query_one("#lanes", DataTable)
        lanes_w.clear()
        lg = {"done": ("✓", accent), "queued": ("▪", dim),
              "open": ("·", dim)}
        for ln in lanes:
            mark, style = lg.get(ln.get("status", "open"), ("·", dim))
            lanes_w.add_row(f" {_cut(ln.get('id', ''), 30)}",
                            _styled(f" {mark}", style),
                            " Q" if ln.get("in_queue") else " ",
                            f" {ln.get('date') or '—'}")

        reports_w = self.query_one("#reports", DataTable)
        reports_w.clear()
        for r in reports:
            kind = r.get("kind") or "?"
            glyph = _REPORT_GLYPH.get(kind, "•")
            style = f"bold {accent}" if kind == "alert" else accent
            reports_w.add_row(_styled(f" {glyph}", style),
                              _kw_text(_cut(r.get("first_line") or "", 50),
                                       accent))

        roster_w = self.query_one("#roster", DataTable)
        roster_w.clear()
        for rr in roster:
            state = rr.get("state", "?")
            mission_text = rr.get("mission", "")
            if state in ("cancelled", "evacuated") \
                    and _beacon_kind(mission_text):
                # a scheduled beacon closed cancelled/evacuated BY DESIGN
                state_text = _styled(" beacon", "dim")
                mission = _kw_text(_cut(mission_text, 44), accent)
            else:
                color = _STATE_COLOR.get(state, "text-muted")
                state_text = _styled(f" {state}", color)
                mission = _kw_text(_cut(mission_text, 44), accent)
            roster_w.add_row(f" {_cut(rr.get('id', '?'), 20)}", state_text,
                             f" {rr.get('source', '')}",
                             mission)

        queued = [i for i, st in items if st == "queued"]
        done = [i for i, st in items if st == "done"]
        state = _state(queued, done, sessions)
        # state-reactive pacing: running sessions pick the energetic
        # sequence and a quicker pulse (UI thread; timer only reads it)
        self._state_now = state
        self._switch_seq(state == "active")
        line = dash.SPEECH[state][self._tick % len(dash.SPEECH[state])]
        caption = self.query_one("#caption", Static)
        caption.update(line + (f"  music {dance}/10" if dance else ""))

        status = (f"updated {datetime.now().strftime('%H:%M:%S')} · "
                  f"every {self.interval}s · dance {dance}/10 · "
                  f"{len(sessions)} session(s)")
        # scheduled strip: the healthy timer set, driven by beacon kinds
        # present this refresh; the known job set is hardcoded for now
        # (7 timers) and any extra present kind is appended generically.
        known = [k for k in BEACON_KINDS if k in kinds_seen]
        extra = sorted(k for k in kinds_seen if k not in BEACON_KINDS)
        jobs = known + extra
        strip = f"7 timers · " + " · ".join(f"{k} ✓" for k in jobs) \
            if jobs else "7 timers"
        status_t = Text(f"{status}\n{strip}")
        if alive:
            # unread count; the ⚠ glyph, accent-styled, when an alert
            # kind is among the shown reports
            tail = Text(f" · reports {unread}")
            if any(r.get("kind") == "alert" for r in reports):
                tail = Text(f" · reports ⚠{unread}")
                tail.stylize(f"bold {accent}")
            status_t.append_text(tail)
        self.query_one("#status", Static).update(status_t)
        self._maybe_report_modal(reports)

    def _maybe_report_modal(self, reports):
        """Pop-in: the newest unseen report opens once as a modal. The
        first run may open the newest unread once; afterwards only new
        ids. Seen ids are remembered in-session only — the queue cursor
        stays the operator's, never touched here."""
        if self._modal_open or not reports:
            return
        report = _newest_unseen(self._seen_reports, reports)
        if report is None:
            return
        self._seen_reports.add(report.get("id"))
        self._modal_open = True
        accent = self.theme_variables.get("primary", "#5af78e")
        self.push_screen(ReportModal(report, accent),
                         callback=self._modal_closed)

    def _modal_closed(self, _=None):
        self._modal_open = False

    def action_cycle_theme(self):
        self.theme = PRESETS[(PRESETS.index(self.theme) + 1) % len(PRESETS)]

    def action_refresh(self):
        self.refresh_tick()


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False, prog="dashboard-tui")
    parser.add_argument("--help", action="store_true")
    parser.add_argument("--theme",
                        help="initial preset: hngh|matrix|ocean|paper")
    parser.add_argument("--interval", type=int, default=4,
                        help="refresh seconds (default 4)")
    parser.add_argument("--no-sessions", action="store_true",
                        help="omit the live sessions table")
    args = parser.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0
    HnghTUI(interval=args.interval, no_sessions=args.no_sessions,
            theme=args.theme or "hngh").run()
    return 0


if __name__ == "__main__":
    sys.exit(main())