# The sequence player. Each step picks a frame (int index into FIGURES,
# or an inline multi-line art string) and a dwell in seconds; the player
# advances on a monotonic deadline, independent of the data refresh
# interval, and wraps around to loop the idle. v5 is the full 8-frame
# walk-cycle rig: base → frame-close → gesture-raise → blink-inhale →
# frame-open → swing-arms → step-left → exhale-tilt, all frames active
# with beat dwells so the loop visibly moves (not a 4-frame + breathe
# blink). Breathe overlays the long base/exhale dwells only.
ANIM_IDLE = [
    {"frame": 0, "dwell": 0.45},  # base
    {"frame": 1, "dwell": 0.3},   # frame-close
    {"frame": 2, "dwell": 0.35},  # gesture-raise (two-arm)
    {"frame": 3, "dwell": 0.3},   # blink-inhale
    {"frame": 4, "dwell": 0.35},  # frame-open
    {"frame": 5, "dwell": 0.3},   # swing-arms
    {"frame": 6, "dwell": 0.35},  # step-left
    {"frame": 7, "dwell": 0.45},  # exhale-tilt
]
ANIM_ACTIVE = [
    {"frame": 1, "dwell": 0.14},   # frame-close, quickened
    {"frame": 2, "dwell": 0.2},    # gesture-raise
    {"frame": 5, "dwell": 0.18},   # swing-arms
    {"frame": 6, "dwell": 0.22},   # step-left
    {"frame": 3, "dwell": 0.2},    # blink-inhale
    {"frame": 0, "dwell": 0.24},   # base
    {"frame": 4, "dwell": 0.18},   # frame-open
    {"frame": 7, "dwell": 0.26},   # exhale-tilt
]

# Theme presets: quiet dark is the default; the rest are the named
# alternatives. All four are registered so `t` is native theme switching.
THEMES = [
