        "Another candidate bound. The ledger grows.",
        "Sealed with a certificate. That is how the world ends quietly.",
    ],
    "empty": [
        "The queue is empty. This is also a fact.",
        "Nothing queued. The city is still.",
    ],
}

KEYWORD_HIGHLIGHT = {
    "rotation": "bold cyan", "candidate": "bold magenta",
    "certificate": "bold yellow", "heartbeat": "bold green",
    "wake": "bold red", "commit": "bold cyan",
}


def timeline_rows():
    rows = []
    for line in TIMELINE.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] in {"done", "event", "rotation"}:
            rows.append(parts)
    return rows


def queue_items():
    items = []
    for line in QUEUE.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] in {"queued", "done", "active"}:
            items.append((parts[0], parts[1]))
    return items


_session_cache = {"at": 0.0, "rows": None}


def _strip_nesting(value):
    """Scrub bracket/quote nesting from a field value so no cell ever
    shows raw plist/array text (e.g. station=['0','0',0,'1'])."""
    return re.sub(r"[\[\](){}'\"]", "", value)


def _parse_present(fields, store_name):
    """Parse one `present run-1` line's whitespace tokens into a session
    dict. Every `key=value` token becomes its own field (state/role/
    loadout/route/station/...), and values are scrubbed of bracket/quote
    nesting so nothing raw leaks to a column. `mission` is the explicit
    mission= value joined with the trailing non-field prose, in order —
    a value carrying spaces (mission=deploy the thing) reads back whole.
    `store_name` (the store directory base name) is kept so repeated
    run-N rows stay distinguishable."""
    info = {"run": fields[1], "store": store_name}
    mission_value = None
    prose = []
    for tok in fields[2:]:
        key, eq, value = tok.partition("=")
        if eq and key and not any(ch in key for ch in "[](){}'\""):
            value = _strip_nesting(value)
            if key == "mission":
                mission_value = value
            else:
                info[key] = value
        else:
            prose.append(_strip_nesting(tok))
    mission = ([mission_value] if mission_value is not None else []) + prose
    info["mission"] = " ".join(m for m in mission if m)
    return info


def session_rows(limit=5, ttl=0.0):
    """Live session store: the newest STORE_ROOT sub-stores rendered
    through scripts/hngh present (the canonical renderer). Read-only,
    bounded, and non-fatal — a missing store or a failed render yields
    an empty list, never a crash. TTL lets the watch loop avoid
    hammering the store on every tick."""
    if ttl > 0 and _session_cache["rows"] is not None \
            and time.time() - _session_cache["at"] < ttl:
        return _session_cache["rows"]
    if not STORE_ROOT.is_dir():
        _session_cache.update(at=time.time(), rows=[])
        return []
    stores = sorted(
        (d for d in STORE_ROOT.iterdir()
         if d.is_dir() and (d / "record.lisp").exists()),
        key=lambda d: (d / "record.lisp").stat().st_mtime_ns, reverse=True)
    rows = []
    for store in stores[:limit]:
        try:
            age = time.time() - (store / "record.lisp").stat().st_mtime
        except OSError:
            age = None
        try:
            out = subprocess.run(
                ["sbcl", "--script", str(PRESENT), f"--store={store}",
                 "present", "run-1"],
                capture_output=True, text=True, timeout=4)
        except Exception:
            continue
        line = (out.stdout or "").strip().splitlines()
        if not line:
            continue
        text = line[0]
        if not text.startswith("run "):
            continue
        fields = text.split()
        if len(fields) < 4 or fields[0] != "run":
            continue
        info = _parse_present(fields, store.name)
        info["age"] = age
        rows.append(info)
    _session_cache.update(at=time.time(), rows=rows)
    return rows


def data_spine():
    """The shared read-only data dict for JSON, HTML, and live modes."""
    return {
        "timeline": timeline_rows(),
        "queue": [{"id": i, "status": s} for i, s in queue_items()],
        "etas": queue_etas(),
        "sessions": session_rows(),
        "generated": datetime.now().astimezone().isoformat(timespec="seconds"),
    }


def render_json(spine):
    return json.dumps(spine, indent=2, ensure_ascii=False)


def render_html(spine):
    timeline = "".join(
        f"<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td>"
        f"<td><code>{r[3]}</code></td></tr>"
        for r in spine["timeline"])
    qrows = "".join(
        f"<tr><td>{q['id']}</td><td>{q['status']}</td>"
        f"<td>{spine['etas'].get(q['id'], '')}</td></tr>"
        for q in spine["queue"])
    srows = "".join(
        f"<tr><td>{s.get('run', '')}</td><td>{s.get('state', '')}</td>"
        f"<td>{s.get('loadout', '')}</td><td>{s.get('mission', '')}</td></tr>"
        for s in spine["sessions"])
    return f"""<!doctype html>
<html lang="en">
<head><meta charset="utf-8">
<title>hngh dashboard</title>
<style>
body {{ font-family: monospace; margin: 2em; }}
table {{ border-collapse: collapse; width: 100%; }}
th, td {{ border: 1px solid #ccc; padding: 4px 8px; text-align: left; }}
</style></head>
<body>
<h1>hngh dashboard</h1>
<p>generated <code>{spine['generated']}</code></p>
<h2>timeline</h2>
<table><tr><th>date</th><th>kind</th><th>item</th><th>hash</th></tr>{timeline}
</table>
<h2>queue</h2>
<table><tr><th>id</th><th>status</th><th>eta</th></tr>{qrows}
</table>
<h2>live sessions</h2>
<table><tr><th>run</th><th>state</th><th>loadout</th><th>mission</th></tr>{srows}
</table>
</body></html>"""


def flag_value(flag, argv=sys.argv):
    """Read --flag=N or --flag N from ARGV; None when absent."""
    for arg in argv:
        if arg.startswith(flag + "="):
            return arg.split("=", 1)[1]
        if arg == flag:
            i = argv.index(arg)
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                return argv[i + 1]
            return ""
    return None


WATCH_ARG = "--watch" if "--watch" in sys.argv else "--live" if "--live" in sys.argv else None
WATCH_SECONDS = int(flag_value(WATCH_ARG) or 5) if WATCH_ARG else None
NO_SESSIONS = "--no-sessions" in sys.argv
EXPORT_HTML = flag_value("--export-html")
AS_JSON = "--json" in sys.argv

def queue_etas():
    etas = {}
    text = QUEUE.read_text()
    # the LAST ETA section wins; a stray duplicate can never split the parse
    section = text.rsplit("## ETA", 1)[-1]
    # the section ends at the next '## ' heading, never at EOF
    tail = section.split("\n## ", 1)[0]
    for line in tail.splitlines():
        if "\t" in line or line.startswith("#") or line.startswith("```") or "- " not in line:
            continue
        name = line.split("- ", 1)[1].split(" —", 1)[0]
        window = line.split("—", 1)[1].strip() if "—" in line else ""
        # a completed item's ETA reads "DONE ..." — never draw it as a bar
        if name and "—" in line and not window.startswith("DONE"):
            etas[name.strip()] = window
    return etas


def dance_mark(intensity, base="---"):
    """Deterministic wobble: the marker grows/shrinks with intensity."""
    i = max(0, min(9, int(intensity or 0)))
    if i == 0:
        return base
    widen = 1 + (i % 3)       # 1..3 extra chars
    return base[0] + ("-") * (len(base) - 1)  + ("·" * widen)


def tone(code):
    """Wrap with an ANSI color if tone is on, else identity."""
    return (lambda s: f"\x1b[{code}m{s}\x1b[0m") if TONE else (lambda s: s)


def theme_set():
    """--theme=NAME maps names to accent codes; default plain."""
    name = "plain"
    for arg in sys.argv:
        if arg.startswith("--theme="):
            name = arg.split("=", 1)[1]
            break
    if "--theme" in sys.argv:
        i = sys.argv.index("--theme")
        if i + 1 < len(sys.argv):
            name = sys.argv[i + 1]
    table = {
        "matrix": {"accent": 92, "dim": 90, "bg": 40},
        "sunset": {"accent": 93, "dim": 33, "bg": 41},
        "ocean":  {"accent": 96, "dim": 34, "bg": 44},
        "paper":  {"accent": 97, "dim": 90, "bg": 40},
    }
    return table.get(name, {})


THEME = theme_set()
TONE = "--tone" in sys.argv or bool(THEME)


BANNER = "--banner" in sys.argv
QUIET = "--quiet" in sys.argv


def banner():
    if not BANNER:
        return ""
    art = r"""
   _   _   _   _   _   _   _   _   _   _   _  _
  / \ / \ / \ / \ / \ / \ / \ / \ / \ / \ / \/ \
 ( H|n|g|h | t|r|a|c|e|d | d|a|s|h|b|o|a|r|d )
  \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/\_/
"""
    return art if not THEME else tone(THEME.get("accent", 92))(art)


def framed(text, accent=None):
    """Draw TEXT inside a unicode panel when a theme is on."""
    if not THEME:
        return text
    a = THEME.get("accent", 92)
    lines = text.splitlines()
    w = max((len(l) for l in lines), default=0)
    bar = tone(a)("─" * (w + 2))
    return (tone(a)("┌") + bar + tone(a)("┐")
            + "\n".join(tone(a)("│") + l.ljust(w) + tone(a)("│") for l in lines)
            + tone(a)("└") + bar + tone(a)("┘"))


def paint(marker):
    """Colorize the common markers when --tone is on."""
    if not TONE:
        return marker
    accent = THEME.get("accent", 32)
    if marker.startswith("#"):
        return tone(accent)(marker)  # done (theme accent)
    if "+" in marker:
        return tone(36)(marker)      # cyan active
    if marker.startswith("-"):
        return tone(33)(marker)      # amber ETA
    if marker.startswith("…") or marker.startswith("..."):
        return tone(90)(marker)      # dim queued
    return marker


def animated_bar(label, count, status, tone_on):
    """A colorized bar for the wave renderer."""
    body = "#" * count
    if status == "queued":
        body += " ..."
    elif status == "active":
        body += " +"
    if tone_on:
        ch = len(body) % 3
        body = tone(["32", "36", "33"][ch])(body)
    return f"{label} {body}"


def linear_render(items, rows, etas, dance=0):
    print("hngh timeline (gantt-ish)" + ("  ::dance" if dance else ""))
    print("legend: '#' done  '...' queued  '---' ETA window  '+' active")
    dm = dance_mark(dance)
    for i, status in items:
        eta = etas.get(i, "")
        if i not in [r[2] for r in rows]:
            if eta:
                print(f"{i:22s} {dm}  {eta}")
                continue
            if status == "queued":
                print(f"{i:22s} {paint('...')}")
            else:
                print(f"{i:22s} {paint('....')}")
            continue
        n = sum(1 for r in rows if r[2] == i)
        bar = "#" * n
        if status == "queued":
            bar += " ..."
        elif status == "active":
            bar += " +"
        if eta:
            bar += f"  {eta}"
        print(f"{i:22s} {paint(bar)}")
    for r in rows:
        if r[2] not in [i for i, _ in items] and r[1] != "rotation":
            print(f"{r[2]:22s} {paint('#')} (event)")
    print(f"\n{len(rows)} timeline rows; {len(items)} queue items")


def spiral_render(rows, items, etas, intensity=0):
    width, height = 60, 30
    grid = [[" "] * width for _ in range(height)]
    cx, cy = width // 2, height // 2
    n_done = len(rows)
    future = [(a, b) for a, b in items if b == "queued"]
    n_future = len(future) or 1
    total = n_done + n_future
    jit = intensity if intensity else 0
    for idx, r in enumerate(rows):
        theta = 2 * math.pi * (1 - idx / max(total, 1))
        radius = 1.0 + 2.5 * (1 - idx / max(n_done, 1))
        x = int(cx + radius * math.cos(theta))
        y = int(cy + radius * 0.5 * math.sin(theta))
        if 0 <= x < width and 0 <= y < height:
            grid[y][x] = "#"
    for idx, (name, _) in enumerate(future):
        theta = 2 * math.pi * (0.05 + idx / max(n_future, 1))
        radius = 3.0 + 2.0 * (idx / max(n_future, 1)) + (jit and idx % 2 or 0)
        x = int(cx + radius * math.cos(theta))
        y = int(cy + radius * 0.5 * math.sin(theta))
        if 0 <= x < width and 0 <= y < height:
            grid[y][x] = "o"
    print("hngh spiral (past in, future out)" + ("  # dance" if jit else ""))
    print("legend: '#' = timeline event  'o' = queued/future")
    for line in grid:
        print("".join(line).rstrip())
    print(f"{len(rows)} timeline rows; {len(items)} queue items")


def circular_render(rows, items, etas, intensity=0):
    """Clock-face rings: done rings are inner, ETA windows are outer rings."""
    future = [(a, b, etas.get(a, "")) for a, b in items if b == "queued"]
    done = [r for r in rows if r[1] == "rotation"]
    size = 40  # half-width of the ring plane
    cx = cy = size
    lines = []
    for idx, label in enumerate(["".join(r[2][:1]) for r in done] + ["." for _ in future]):
        r = idx + 1.5
        # place a ring token at angle 0 and 180 for a "clock-face" feel
        for ang in (0, math.pi / 2, math.pi, 3 * math.pi / 2):
            x = int(cx + r * math.cos(ang))
            y = int(cy + r * math.sin(ang))
            if 0 <= x <= 2 * size and 0 <= y <= 2 * size:
                lines.append((x, y, "#" if idx < len(done) else "o"))
    grid = [[" "] * (2 * size + 1) for _ in range(2 * size + 1)]
    for x, y, ch in lines:
        grid[y][x] = ch
    print("hngh circular (clock-face rings)" + ("  # dance" if intensity else ""))
    for line in grid:
        print("".join(line).rstrip())
    print(f"{len(rows)} timeline rows; {len(items)} queue items; rings inner→outer")


def burst_render(rows, items, etas, intensity=0):
    """A radial starburst: done items near center, future items at the rim."""
    size = 36
    cx = cy = size
    grid = [[" "] * (2 * size + 1) for _ in range(2 * size + 1)]
    done = [r for r in rows if r[1] == "rotation"]
    future = [a for a, b in items if b == "queued"]
    all_items = [(r[2], "#") for r in done] + [("queued:" + a, "o") for a in future]
    n = max(1, len(all_items))
    for idx, (name, ch) in enumerate(all_items):
        ang = 2 * math.pi * idx / n
        radius = 2 + 1.4 * idx
        x = int(cx + radius * math.cos(ang))
        y = int(cy + radius * 0.7 * math.sin(ang))
        if 0 <= x < 2 * size and 0 <= y < 2 * size:
            grid[y][x] = paint("#") if ch == "#" else "o"
    print("hngh burst (radial)" + ("  # dance" if intensity else ""))
    for line in grid:
        print("".join(line).rstrip())
    print(f"{len(rows)} timeline rows; {len(items)} queue items")


def wave_render(items, rows, etas, intensity=0):
    """A bouncing equalizer: each item's bar is a column whose height
    rides the music intensity (the equalizer that dances)."""
    print("hngh wave (equalizer)" + ("  ::dance" if intensity else ""))
    col = ""
    for i, status in items[:int(len(items) * 0.4)]:
        h = (intensity or 1)
        bar = "#" * min(6, h + (2 if status == "active" else 0))
        if status == "done":
            bar += "|"
        col += f"{i[:9]:10s} {bar}\n"
    print(col)
    print(f"{len(rows)} timeline rows; {len(items)} queue items; equalizer to music")


def dance_level():
    if "--dance" not in sys.argv:
        return 0
    i = sys.argv.index("--dance")
    if i + 1 < len(sys.argv) and sys.argv[i + 1] == "auto":
        try:
            return int(subprocess.run(
                [sys.executable, str(ROOT / "scripts" / "audio-intensity")],
                capture_output=True, text=True, timeout=2).stdout.strip() or 0)
        except Exception:
            return 0
    if i + 1 < len(sys.argv):
        try:
            return int(sys.argv[i + 1])
        except ValueError:
            return 0
    return 0


def choose_renderer():
    if "--circular" in sys.argv:
        return "circular"
    if "--spiral" in sys.argv:
        return "spiral"
    if "--burst" in sys.argv:
        return "burst"
    if "--wave" in sys.argv:
        return "wave"
    return "linear"


SESSION_STATE_COLORS = {
    "created": "36", "armed": "36", "running": "92", "checkpointed": "36",
    "evacuated": "33", "cancelled": "90", "dead": "91",
}


def age_text(seconds):
    if seconds is None:
        return "?"
    if seconds < 60:
        return f"{int(seconds)}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    return f"{seconds / 3600:.1f}h"


def session_block(sessions):
    """Live session lines: state color-coded when tone is on, age shown."""
    lines = []
    for s in sessions:
        state = s.get("state", "?")
        color = SESSION_STATE_COLORS.get(state)
        state_text = tone(color)(state) if color else state
        mission = s.get("mission", "").strip()
        lines.append(
            f"session {s.get('run', '?')} state={state_text} "
            f"loadout={s.get('loadout', '?')} age={age_text(s.get('age'))}"
            + (f" {mission}" if mission else ""))
    return "\n".join(lines)


def render_body(rows, items, etas, dance, sessions):
    style = choose_renderer()
    if style == "circular":
        func = lambda: circular_render(rows, items, etas, dance)
    elif style == "spiral":
        func = lambda: spiral_render(rows, items, etas, dance)
    elif style == "burst":
        func = lambda: burst_render(rows, items, etas, dance)
    elif style == "wave":
        func = lambda: wave_render(items, rows, etas, dance)
    else:
        func = lambda: linear_render(items, rows, etas, dance)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        func()
    body = buf.getvalue()
    if sessions:
        body += "\n" + session_block(sessions)
    if BANNER:
        body = banner() + "\n" + body
    if QUIET:
        body = "\n".join(l for l in body.splitlines()
                         if not (l.startswith("hngh ") or l.startswith("legend")))
    return framed(body) if THEME else body


def watch_loop(interval):
    """One foreground TUI refresh loop: cursor hidden, in-place repaint,
    no scrollback wipe, a live status footer; Ctrl-C restores the cursor."""
    sys.stdout.write("\x1b[?25l")  # hide cursor
    sys.stdout.flush()
    last_sessions = None
    last_at = 0.0
    def _term(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, _term)
    try:
        while True:
            if time.time() - last_at >= 15:
                last_sessions = session_rows(ttl=15)
                last_at = time.time()
            dance = dance_level()
            sessions = [] if NO_SESSIONS else last_sessions or []
            body = render_body(timeline_rows(), queue_items(), queue_etas(),
                               dance, sessions)
            footer = (f"updated {datetime.now().strftime('%H:%M:%S')} "
                      f"· every {interval}s · dance {dance}/10 "
                      f"· {len(sessions)} session(s) · Ctrl-C to exit")
            sys.stdout.write("\x1b[H\x1b[0J" + body + "\n" + footer)
            sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[?25h\n")  # restore cursor
        sys.stdout.flush()
    return 0


def keyword_mark(text):
    """Highlight domain keywords in a line via rich markup; everything
    else is escaped so operator data can never inject markup."""
    out = r_escape(text)
    for word, style in KEYWORD_HIGHLIGHT.items():
        out = out.replace(word, f"[{style}]{word}[/{style.split()[0]}]")
    return out


def rich_theme_colors():
    name = "plain"
    for arg in sys.argv:
        if arg.startswith("--theme="):
            name = arg.split("=", 1)[1]
    return {
        "matrix": "green", "sunset": "orange_red1", "ocean": "cyan",
        "paper": "white", "plain": "cyan",
    }.get(name, "cyan")


def rich_dashboard(rows, items, etas, sessions, dance):
    """The framed, width-aware watch render: queue, timeline, sessions,
    and the lone operative with a state-driven line."""
    accent = rich_theme_colors()
    header = Panel.fit(
        f"[bold {accent}]hngh[/] — the queue runs itself",
        border_style=accent)

    queue_table = Table(box=None, show_header=False, expand=True,
                        padding=(0, 1))
    queue_table.add_column(style="bold")   # id
    queue_table.add_column(width=3)        # glyph
    queue_table.add_column()               # eta
    queued = [i for i, s in items if s == "queued"]
    done = [i for i, s in items if s == "done"]
    active = [i for i, s in items if s == "active"]
    for i in active:
        queue_table.add_row(i, "[bold yellow]+[/]", "")
    for i in queued:
        queue_table.add_row(i, "[dim]·[/]",
                            etas.get(i, "")[:60])
    for i in done:
        queue_table.add_row(f"[dim]{i}[/]", "[green]✓[/]", "")
    queue_panel = Panel(
        queue_table, title=f"[{accent}]queue[/]", border_style=accent,
        subtitle=f"{len(queued)} queued · {len(active)} active · "
                 f"{len(done)} done")

    recent = [r for r in rows if r[1] in ("rotation", "event")][-6:]
    t_table = Table(box=None, show_header=False, expand=True, padding=(0, 1))
    t_table.add_column(width=10)
    t_table.add_column(width=8)
    t_table.add_column()
    for date, kind, item, h in recent:
        t_table.add_row(date, kind, f"{item[:24]} [dim]{h[:8]}[/]")
    timeline_panel = Panel(t_table, title=f"[{accent}]timeline[/]",
                           border_style=accent)

    s_table = Table(box=None, show_header=False, expand=True, padding=(0, 1))
    s_table.add_column(width=7)
    s_table.add_column(width=12)
    s_table.add_column(width=9)
    s_table.add_column()
    for s in sessions:
        state = s.get("state", "?")
        color = {"running": "bold green", "created": "cyan",
                 "armed": "cyan", "checkpointed": "cyan",
                 "evacuated": "yellow", "cancelled": "dim",
                 "dead": "red"}.get(state, "dim")
        s_table.add_row(s.get("run", "?"), f"[{color}]{state}[/]",
                        f"age {age_text(s.get('age'))}",
                        keyword_mark(s.get("mission", ""))[:70])
    sessions_panel = Panel(s_table, title=f"[{accent}]sessions[/]",
                           border_style=accent,
                           subtitle=f"{len(sessions)} recent")

    state = "active" if any(s.get("state") == "running" for s in sessions) \
        else "done" if not queued and done else \
        "idle" if queued else "empty"
    line = SPEECH[state][dance % len(SPEECH[state])]
    if dance:
        line = f"{line}  [dim]music {dance}/10[/]"
    assistant = Panel(
        Group(
            f"[{accent}]{KILLY}[/]",
            Panel.fit(keyword_mark(line), border_style=accent,
                      title="[dim]operative[/]")),
        border_style=accent)

    return Group(header, queue_panel, timeline_panel, sessions_panel,
                 assistant)


def rich_watch(interval):
    """The Live watch loop: one repaint per tick, 'q'/'ESC' quits,
    cursor restored on exit. Falls back gracefully when stdin is not
    an interactive terminal."""
    console = Console()
    last_sessions = None
    last_at = 0.0
    try:
        old = termios.tcgetattr(sys.stdin.fileno())
        tty.setraw(sys.stdin.fileno())
    except (OSError, ValueError, termios.error):
        # not an interactive terminal: the stdlib loop keeps the
        # refresh contract without the raw-key layer
        return watch_loop(interval)
    try:
        with Live(console=console, refresh_per_second=4, screen=False) as live:
            while True:
                if time.time() - last_at >= 15:
                    last_sessions = session_rows(ttl=15)
                    last_at = time.time()
                dance = dance_level()
                sessions = [] if NO_SESSIONS else last_sessions or []
                body = rich_dashboard(timeline_rows(), queue_items(),
                                      queue_etas(), sessions, dance)
                footer = (f"[dim]{datetime.now().strftime('%H:%M:%S')} · "
                          f"every {interval}s · q to quit[/]")
                live.update(Group(body, footer))
                r, _, _ = select.select([sys.stdin], [], [], interval)
                if r:
                    key = os.read(sys.stdin.fileno(), 1)
                    if key in (b"q", b"Q", b"\x1b"):
                        break
    except (OSError, ValueError):
            pass
    finally:
        try:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        except (OSError, ValueError):
            pass
    return 0


def main():
    if AS_JSON:
        sys.stdout.write(render_json(data_spine()) + "\n")
        return 0
    if EXPORT_HTML:
        target = Path(EXPORT_HTML)
        target.write_text(render_html(data_spine()))
        print(f"exported dashboard HTML -> {target}")
        return 0
    if WATCH_ARG:
        if RICH and "--plain" not in sys.argv:
            return rich_watch(max(1, WATCH_SECONDS))
        return watch_loop(max(1, WATCH_SECONDS))
    sys.stdout.write(render_body(
        timeline_rows(), queue_items(), queue_etas(), dance_level(),
        [] if NO_SESSIONS else session_rows()) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())