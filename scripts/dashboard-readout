    "   ██        ██\n"
    "  █            █\n"
    " █▄▄▄▄▄▄▄▄▄▄▄▄▄▄█"
)

SPEECH = {
    "idle": [
        "The queue holds its breath. The lattice listens.",
        "Nothing turning. The wall is quiet.",
        "Evidence sleeps until it is asked.",
    ],
    "active": [
        "A cycle turns. Evidence before noise.",
        "The record is being written. Do not interrupt it.",
        "One slice at a time. That is the discipline.",
    ],
