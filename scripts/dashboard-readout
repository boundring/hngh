#!/usr/bin/env python3
"""dashboard-readouts: a growing family of gantt-style renderers.

Reads only committed data (no daemon). Renderers all read the same
timeline spine + ETA windows:
  (default) linear  — bars: '#' done, '...' queued, '-' ETA
  --spiral          — Archimedean spiral, past in / future out
  --circular        — clock-face rings: done rings inner, planned outer
  --dance N         — bump ANY renderer with a music intensity 0..9
                      (experimental: deterministic wobble, no data change)

This is deliberately a little silly — "practical nonsense" is the
point; the shorthand for our bigger crazy is real but honed.
"""

import sys
import math
import io
import json
import contextlib
import os
import re
import select
import signal
import subprocess
import time
import termios
import tty
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TIMELINE = ROOT / "docs" / "project" / "timeline.md"
QUEUE = ROOT / "docs" / "project" / "queue.md"
STORE_ROOT = Path.home() / ".hngh-automation" / "store"
PRESENT = ROOT / "scripts" / "hngh"

# Rich is the quality-of-life TUI layer (optional): when present the
# watch loop renders framed panels, colored states, and the assistant;
# when absent (or --plain) the stdlib renderer takes over. The gate
# stays green in both worlds.
try:
    from rich.console import Console, Group
    from rich.panel import Panel
    from rich.table import Table
    from rich.live import Live
    from rich.markup import escape as r_escape
    RICH = True
except ImportError:
    RICH = False

