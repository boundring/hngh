#!/usr/bin/env python3
"""dashboard-readouts: a growing family of gantt-style renderers.

Reads only committed data (no daemon). Renderers all read the same
timeline spine + ETA windows:
  (default) linear  — bars: '#' done, '...' queued, '-' ETA
  --spiral          — Archimedean spiral, past in / future out
  --circular        — clock-face rings: done rings inner, planned outer
  --dance N         — bump ANY renderer with a music intensity 0..9
                      (experimental: deterministic wobble, no data change)

This is deliberately a little silly — "practical nonsense" is the
point; the shorthand for our bigger crazy is real but honed.
"""

import sys
import math
import io
import json
import contextlib
import subprocess
import time
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TIMELINE = ROOT / "docs" / "project" / "timeline.md"
QUEUE = ROOT / "docs" / "project" / "queue.md"
STORE_ROOT = Path.home() / ".hngh-automation" / "store"
PRESENT = ROOT / "scripts" / "hngh"


def timeline_rows():
    rows = []
    for line in TIMELINE.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] in {"done", "event", "rotation"}:
            rows.append(parts)
    return rows


def queue_items():
    items = []
    for line in QUEUE.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] in {"queued", "done", "active"}:
            items.append((parts[0], parts[1]))
    return items


_session_cache = {"at": 0.0, "rows": None}


def session_rows(limit=3, ttl=0.0):
    """Live session store: the newest STORE_ROOT sub-stores rendered
    through scripts/hngh present (the canonical renderer). Read-only,
    bounded, and non-fatal — a missing store or a failed render yields
    an empty list, never a crash. TTL lets the watch loop avoid
    hammering the store on every tick."""
    if ttl > 0 and _session_cache["rows"] is not None \
            and time.time() - _session_cache["at"] < ttl:
        return _session_cache["rows"]
    if not STORE_ROOT.is_dir():
        _session_cache.update(at=time.time(), rows=[])
        return []
    stores = sorted(
        (d for d in STORE_ROOT.iterdir()
         if d.is_dir() and (d / "record.lisp").exists()),
        key=lambda d: (d / "record.lisp").stat().st_mtime_ns, reverse=True)
    rows = []
    for store in stores[:limit]:
        try:
            out = subprocess.run(
                ["sbcl", "--script", str(PRESENT), f"--store={store}",
                 "present", "run-1"],
                capture_output=True, text=True, timeout=4)
        except Exception:
            continue
        line = (out.stdout or "").strip().splitlines()
        if not line:
            continue
        text = line[0]
        if not text.startswith("run "):
            continue
        fields = text.split()
        if len(fields) < 4 or fields[0] != "run":
            continue
        info = {"run": fields[1]}
        parts = []
        for field in fields[2:]:
            if "=" in field and (not parts or " " not in field):
                info[field.split("=", 1)[0]] = field.split("=", 1)[1]
            else:
                parts.append(field)
        info["mission"] = " ".join(parts).lstrip("mission=")
        rows.append(info)
    _session_cache.update(at=time.time(), rows=rows)
    return rows


def data_spine():
    """The shared read-only data dict for JSON, HTML, and live modes."""
    return {
        "timeline": timeline_rows(),
        "queue": [{"id": i, "status": s} for i, s in queue_items()],
        "etas": queue_etas(),
        "sessions": session_rows(),
        "generated": datetime.now().astimezone().isoformat(timespec="seconds"),
    }


def render_json(spine):
    return json.dumps(spine, indent=2, ensure_ascii=False)


def render_html(spine):
    timeline = "".join(
        f"<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td>"
        f"<td><code>{r[3]}</code></td></tr>"
        for r in spine["timeline"])
    qrows = "".join(
        f"<tr><td>{q['id']}</td><td>{q['status']}</td>"
        f"<td>{spine['etas'].get(q['id'], '')}</td></tr>"
        for q in spine["queue"])
    srows = "".join(
        f"<tr><td>{s.get('run', '')}</td><td>{s.get('state', '')}</td>"
        f"<td>{s.get('loadout', '')}</td><td>{s.get('mission', '')}</td></tr>"
        for s in spine["sessions"])
    return f"""<!doctype html>
<html lang="en">
<head><meta charset="utf-8">
<title>hngh dashboard</title>
<style>
body {{ font-family: monospace; margin: 2em; }}
table {{ border-collapse: collapse; width: 100%; }}
th, td {{ border: 1px solid #ccc; padding: 4px 8px; text-align: left; }}
</style></head>
<body>
<h1>hngh dashboard</h1>
<p>generated <code>{spine['generated']}</code></p>
<h2>timeline</h2>
<table><tr><th>date</th><th>kind</th><th>item</th><th>hash</th></tr>{timeline}
</table>
<h2>queue</h2>
<table><tr><th>id</th><th>status</th><th>eta</th></tr>{qrows}
</table>
<h2>live sessions</h2>
<table><tr><th>run</th><th>state</th><th>loadout</th><th>mission</th></tr>{srows}
</table>
</body></html>"""


def flag_value(flag, argv=sys.argv):
    """Read --flag=N or --flag N from ARGV; None when absent."""
    for arg in argv:
        if arg.startswith(flag + "="):
            return arg.split("=", 1)[1]
        if arg == flag:
            i = argv.index(arg)
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                return argv[i + 1]
            return ""
    return None


WATCH_ARG = "--watch" if "--watch" in sys.argv else "--live" if "--live" in sys.argv else None
WATCH_SECONDS = int(flag_value(WATCH_ARG) or 5) if WATCH_ARG else None
NO_SESSIONS = "--no-sessions" in sys.argv
EXPORT_HTML = flag_value("--export-html")
AS_JSON = "--json" in sys.argv

def queue_etas():
    etas = {}
    text = QUEUE.read_text()
    section = text.split("## ETA", 1)[-1]
    for line in section.splitlines():
        if "\t" in line or line.startswith("#") or line.startswith("```") or "- " not in line:
            continue
        name = line.split("- ", 1)[1].split(" —", 1)[0]
        window = line.split("—", 1)[1].strip() if "—" in line else ""
        if name and "—" in line and not name.startswith("DONE"):
            etas[name.strip()] = window
    return etas


def dance_mark(intensity, base="---"):
    """Deterministic wobble: the marker grows/shrinks with intensity."""
    i = max(0, min(9, int(intensity or 0)))
    if i == 0:
        return base
    widen = 1 + (i % 3)       # 1..3 extra chars
    return base[0] + ("-") * (len(base) - 1)  + ("·" * widen)


def tone(code):
    """Wrap with an ANSI color if tone is on, else identity."""
    return (lambda s: f"\x1b[{code}m{s}\x1b[0m") if TONE else (lambda s: s)


TONE = "--tone" in sys.argv


def theme_set():
    """--theme=NAME maps names to accent codes; default plain."""
    name = "plain"
    for arg in sys.argv:
        if arg.startswith("--theme="):
            name = arg.split("=", 1)[1]
            break
    if "--theme" in sys.argv:
        i = sys.argv.index("--theme")
        if i + 1 < len(sys.argv):
            name = sys.argv[i + 1]
    table = {
        "matrix": {"accent": 92, "dim": 90, "bg": 40},
        "sunset": {"accent": 93, "dim": 33, "bg": 41},
        "ocean":  {"accent": 96, "dim": 34, "bg": 44},
        "paper":  {"accent": 97, "dim": 90, "bg": 40},
    }
    return table.get(name, {})


THEME = theme_set()


BANNER = "--banner" in sys.argv
QUIET = "--quiet" in sys.argv


def banner():
    if not BANNER:
        return ""
    art = r"""
   _   _   _   _   _   _   _   _   _   _   _  _
  / \ / \ / \ / \ / \ / \ / \ / \ / \ / \ / \/ \
 ( H|n|g|h | t|r|a|c|e|d | d|a|s|h|b|o|a|r|d )
  \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/ \_/\_/
"""
    return art if not THEME else tone(THEME.get("accent", 92))(art)


def framed(text, accent=None):
    """Draw TEXT inside a unicode panel when a theme is on."""
    if not THEME:
        return text
    a = THEME.get("accent", 92)
    lines = text.splitlines()
    w = max((len(l) for l in lines), default=0)
    bar = tone(a)("─" * (w + 2))
    return (tone(a)("┌") + bar + tone(a)("┐")
            + "\n".join(tone(a)("│") + l.ljust(w) + tone(a)("│") for l in lines)
            + tone(a)("└") + bar + tone(a)("┘"))


def paint(marker):
    """Colorize the common markers when --tone is on."""
    if not TONE:
        return marker
    accent = THEME.get("accent", 32)
    if marker.startswith("#"):
        return tone(accent)(marker)  # done (theme accent)
    if "+" in marker:
        return tone(36)(marker)      # cyan active
    if marker.startswith("-"):
        return tone(33)(marker)      # amber ETA
    if marker.startswith("…") or marker.startswith("..."):
        return tone(90)(marker)      # dim queued
    return marker


def animated_bar(label, count, status, tone_on):
    """A colorized bar for the wave renderer."""
    body = "#" * count
    if status == "queued":
        body += " ..."
    elif status == "active":
        body += " +"
    if tone_on:
        ch = len(body) % 3
        body = tone(["32", "36", "33"][ch])(body)
    return f"{label} {body}"


def linear_render(items, rows, etas, dance=0):
    print("hngh timeline (gantt-ish)" + ("  ::dance" if dance else ""))
    print("legend: '#' done  '...' queued  '---' ETA window  '+' active")
    dm = dance_mark(dance)
    for i, status in items:
        eta = etas.get(i, "")
        if i not in [r[2] for r in rows]:
            if eta:
                print(f"{i:22s} {dm}  {eta}")
                continue
            if status == "queued":
                print(f"{i:22s} {paint('...')}")
            else:
                print(f"{i:22s} {paint('....')}")
            continue
        n = sum(1 for r in rows if r[2] == i)
        bar = "#" * n
        if status == "queued":
            bar += " ..."
        elif status == "active":
            bar += " +"
        if eta:
            bar += f"  {eta}"
        print(f"{i:22s} {paint(bar)}")
    for r in rows:
        if r[2] not in [i for i, _ in items] and r[1] != "rotation":
            print(f"{r[2]:22s} {paint('#')} (event)")
    print(f"\n{len(rows)} timeline rows; {len(items)} queue items")


def spiral_render(rows, items, etas, intensity=0):
    width, height = 60, 30
    grid = [[" "] * width for _ in range(height)]
    cx, cy = width // 2, height // 2
    n_done = len(rows)
    future = [(a, b) for a, b in items if b == "queued"]
    n_future = len(future) or 1
    total = n_done + n_future
    jit = intensity if intensity else 0
    for idx, r in enumerate(rows):
        theta = 2 * math.pi * (1 - idx / max(total, 1))
        radius = 1.0 + 2.5 * (1 - idx / max(n_done, 1))
        x = int(cx + radius * math.cos(theta))
        y = int(cy + radius * 0.5 * math.sin(theta))
        if 0 <= x < width and 0 <= y < height:
            grid[y][x] = "#"
    for idx, (name, _) in enumerate(future):
        theta = 2 * math.pi * (0.05 + idx / max(n_future, 1))
        radius = 3.0 + 2.0 * (idx / max(n_future, 1)) + (jit and idx % 2 or 0)
        x = int(cx + radius * math.cos(theta))
        y = int(cy + radius * 0.5 * math.sin(theta))
        if 0 <= x < width and 0 <= y < height:
            grid[y][x] = "o"
    print("hngh spiral (past in, future out)" + ("  # dance" if jit else ""))
    print("legend: '#' = timeline event  'o' = queued/future")
    for line in grid:
        print("".join(line).rstrip())
    print(f"{len(rows)} timeline rows; {len(items)} queue items")


def circular_render(rows, items, etas, intensity=0):
    """Clock-face rings: done rings are inner, ETA windows are outer rings."""
    future = [(a, b, etas.get(a, "")) for a, b in items if b == "queued"]
    done = [r for r in rows if r[1] == "rotation"]
    size = 40  # half-width of the ring plane
    cx = cy = size
    lines = []
    for idx, label in enumerate(["".join(r[2][:1]) for r in done] + ["." for _ in future]):
        r = idx + 1.5
        # place a ring token at angle 0 and 180 for a "clock-face" feel
        for ang in (0, math.pi / 2, math.pi, 3 * math.pi / 2):
            x = int(cx + r * math.cos(ang))
            y = int(cy + r * math.sin(ang))
            if 0 <= x <= 2 * size and 0 <= y <= 2 * size:
                lines.append((x, y, "#" if idx < len(done) else "o"))
    grid = [[" "] * (2 * size + 1) for _ in range(2 * size + 1)]
    for x, y, ch in lines:
        grid[y][x] = ch
    print("hngh circular (clock-face rings)" + ("  # dance" if intensity else ""))
    for line in grid:
        print("".join(line).rstrip())
    print(f"{len(rows)} timeline rows; {len(items)} queue items; rings inner→outer")


def burst_render(rows, items, etas, intensity=0):
    """A radial starburst: done items near center, future items at the rim."""
    size = 36
    cx = cy = size
    grid = [[" "] * (2 * size + 1) for _ in range(2 * size + 1)]
    done = [r for r in rows if r[1] == "rotation"]
    future = [a for a, b in items if b == "queued"]
    all_items = [(r[2], "#") for r in done] + [("queued:" + a, "o") for a in future]
    n = max(1, len(all_items))
    for idx, (name, ch) in enumerate(all_items):
        ang = 2 * math.pi * idx / n
        radius = 2 + 1.4 * idx
        x = int(cx + radius * math.cos(ang))
        y = int(cy + radius * 0.7 * math.sin(ang))
        if 0 <= x < 2 * size and 0 <= y < 2 * size:
            grid[y][x] = paint("#") if ch == "#" else "o"
    print("hngh burst (radial)" + ("  # dance" if intensity else ""))
    for line in grid:
        print("".join(line).rstrip())
    print(f"{len(rows)} timeline rows; {len(items)} queue items")


def wave_render(items, rows, etas, intensity=0):
    """A bouncing equalizer: each item's bar is a column whose height
    rides the music intensity (the equalizer that dances)."""
    print("hngh wave (equalizer)" + ("  ::dance" if intensity else ""))
    col = ""
    for i, status in items[:int(len(items) * 0.4)]:
        h = (intensity or 1)
        bar = "#" * min(6, h + (2 if status == "active" else 0))
        if status == "done":
            bar += "|"
        col += f"{i[:9]:10s} {bar}\n"
    print(col)
    print(f"{len(rows)} timeline rows; {len(items)} queue items; equalizer to music")


def dance_level():
    if "--dance" not in sys.argv:
        return 0
    i = sys.argv.index("--dance")
    if i + 1 < len(sys.argv) and sys.argv[i + 1] == "auto":
        try:
            return int(subprocess.run(
                [sys.executable, str(ROOT / "scripts" / "audio-intensity")],
                capture_output=True, text=True, timeout=2).stdout.strip() or 0)
        except Exception:
            return 0
    if i + 1 < len(sys.argv):
        try:
            return int(sys.argv[i + 1])
        except ValueError:
            return 0
    return 0


def choose_renderer():
    if "--circular" in sys.argv:
        return "circular"
    if "--spiral" in sys.argv:
        return "spiral"
    if "--burst" in sys.argv:
        return "burst"
    if "--wave" in sys.argv:
        return "wave"
    return "linear"


def render_body(rows, items, etas, dance, sessions):
    style = choose_renderer()
    if style == "circular":
        func = lambda: circular_render(rows, items, etas, dance)
    elif style == "spiral":
        func = lambda: spiral_render(rows, items, etas, dance)
    elif style == "burst":
        func = lambda: burst_render(rows, items, etas, dance)
    elif style == "wave":
        func = lambda: wave_render(items, rows, etas, dance)
    else:
        func = lambda: linear_render(items, rows, etas, dance)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        func()
    body = buf.getvalue()
    if sessions:
        body += "\n" + "\n".join(
            f"session {s.get('run', '?')} state={s.get('state', '?')} "
            f"loadout={s.get('loadout', '?')} {s.get('mission', '')}".rstrip()
            for s in sessions)
    if BANNER:
        body = banner() + "\n" + body
    if QUIET:
        body = "\n".join(l for l in body.splitlines()
                         if not (l.startswith("hngh ") or l.startswith("legend")))
    return framed(body) if THEME else body


def main():
    if AS_JSON:
        sys.stdout.write(render_json(data_spine()) + "\n")
        return 0
    if EXPORT_HTML:
        target = Path(EXPORT_HTML)
        target.write_text(render_html(data_spine()))
        print(f"exported dashboard HTML -> {target}")
        return 0
    if WATCH_ARG:
        interval = max(1, WATCH_SECONDS)
        try:
            last_sessions = None
            last_at = 0.0
            while True:
                if time.time() - last_at >= 15:
                    last_sessions = session_rows(ttl=15)
                    last_at = time.time()
                body = render_body(
                    timeline_rows(), queue_items(), queue_etas(),
                    dance_level(), [] if NO_SESSIONS else last_sessions or [])
                sys.stdout.write("\x1b[H\x1b[2J" + body)
                sys.stdout.flush()
                time.sleep(interval)
        except KeyboardInterrupt:
            return 0
    sys.stdout.write(render_body(
        timeline_rows(), queue_items(), queue_etas(), dance_level(),
        [] if NO_SESSIONS else session_rows()) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())