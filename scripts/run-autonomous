#!/usr/bin/env python3
"""run-autonomous — one no-prompt ceremony tick for the continual cadence.

A single-tick orchestration layer, invoked by the operator's hourly
systemd timer (the no-daemon boundary: this script never backgrounds
itself). Each invocation performs ONE tick and exits. The tick:

  (a) if today's docs/journal/YYYY-MM-DD.md is absent, generate it by
      running `generate-publication --daily`, then record a progress
      report whose first line is the journal's first narrative sentence;

  (b) read the Next item from docs/project/queue.md; when it exists AND
      the backlog-lanes summary shows >= 2 open lanes, choose a course:
      the pure kernel use case (`scripts/hngh select-course`, one
      candidate per in-queue lane scored by mounted .slice card, then
      ascending recency of last increment, tiebreak by queue priority)
      picks the lane; when the kernel CLI is unavailable or refuses,
      the internal rule falls back. Record the choice as a
      `course <id>: <reasons>` progress report, mount its card, and —
      when a check-in-scale card exists — run ONE ceremony-drive slice
      over the card's files from a fresh ephemeral /tmp/hngh-auto-<ts>
      store, then record progress (or optimization when the slice is a
      grade/bench change). Choice + mount only; a gate is never bypassed.

  (c) append a scheduled report whenever any timer-driven piece ran;

  (d) exit 0 even when nothing was due.

Fail closed: a report-cursor/body that disappears mid-run is treated as
empty, a malformed card fails the tick, and the date for "today" can be
overridden with HNGH_TICK_TS (used by the tests). No network is
required; the only subprocesses are the sibling scripts in this repo.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("HNGH_RUN_ROOT")
            or Path(__file__).resolve().parent.parent)
JOURNAL_DIR = ROOT / "docs" / "journal"
QUEUE = ROOT / "docs" / "project" / "queue.md"
LANES = ROOT / "scripts" / "backlog-lanes"
CARDS = ROOT / "docs" / "project" / "heartbeat"
GEN = ROOT / "scripts" / "generate-publication"
REPORT = ROOT / "scripts" / "report-queue"
CEREMONY = ROOT / "scripts" / "ceremony-drive"
HNGH = ROOT / "scripts" / "hngh"

NEXT_RE = re.compile(r"## Next\s*\n(?:.*\n)*?- \*\*(?P<id>[^*\n]+)\*\*")
KINDS = {"progress", "expense", "optimization", "scheduled", "alert"}
NEVER = "0000-01-01T00:00:00Z"  # never-incremented lanes rank as most due


def today():
    return os.environ.get("HNGH_TICK_TS") \
        or datetime.now(timezone.utc).strftime("%Y-%m-%d")


def git(*cmd):
    out = subprocess.run(["git", *cmd], capture_output=True, text=True, cwd=ROOT)
    return out.returncode, out.stdout.strip(), out.stderr.strip()


def worktree_clean():
    code, out, err = git("status", "--porcelain")
    if code != 0:
        return False, f"git status failed: {err}"
    return (not out), (out or "clean")


def journal_exists(day):
    return (JOURNAL_DIR / f"{day}.md").exists()


def first_narrative_line(day):
    """The journal's first narrative sentence: the first non-heading,
    non-empty line. Falls back to a neutral clause when unreadable."""
    path = JOURNAL_DIR / f"{day}.md"
    try:
        for line in path.read_text().splitlines():
            s = line.strip()
            if s and not s.startswith("#"):
                return s
    except OSError:
        pass
    return f"journal {day} generated"


def run_report(kind, text):
    out = subprocess.run(
        [sys.executable, str(REPORT), "--add", kind, text],
        capture_output=True, text=True, cwd=ROOT)
    return out.returncode, (out.stdout or "") + (out.stderr or "")


def generate_daily(day):
    out = subprocess.run(
        [sys.executable, str(GEN), "--daily", day],
        capture_output=True, text=True, cwd=ROOT)
    return out.returncode, (out.stdout or "") + (out.stderr or "")


def queue_next():
    if not QUEUE.exists():
        return None
    m = NEXT_RE.search(QUEUE.read_text())
    if m:
        return m.group("id").strip()
    # fall back to the first queued TSV row, like schedule-heartbeat
    for line in QUEUE.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] == "queued":
            return parts[0].strip()
    return None


def open_lane_count():
    """Open backlog lane count via the canonical parser (summary.open).
    Fail closed: an unreadable/erroring parser yields 0 open lanes, so
    the ceremony gate stays shut."""
    out = subprocess.run([sys.executable, str(LANES), "--json"],
                         capture_output=True, text=True, cwd=ROOT)
    if out.returncode != 0:
        return 0
    try:
        return json.loads(out.stdout).get("summary", {}).get("open", 0)
    except ValueError:
        return 0


def queue_order():
    """In-queue lane ids in priority order: the `## Next` block items
    first (in block order), then queued TSV rows (in file order). Empty
    when the queue is unreadable."""
    if not QUEUE.exists():
        return []
    text = QUEUE.read_text()
    order, seen = [], set()
    m = re.search(r"## Next\s*\n(.*?)(?=\n## |\Z)", text, re.S)
    next_text = m.group(1) if m else ""
    for mm in re.finditer(r"^- \*\*([^*\n]+)\*\*", next_text, re.M):
        lane = mm.group(1).strip()
        if lane and lane not in seen:
            seen.add(lane)
            order.append(lane)
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] == "queued":
            lane = parts[0].strip()
            if lane and lane not in seen:
                seen.add(lane)
                order.append(lane)
    return order


def last_increment_ts(lanes):
    """Map lane id -> ts of its most recent report-queue row whose body
    names the lane (its last increment). Rows are newest-first, so the
    first match per lane wins. A lane with no match stays unmapped and
    therefore ranks as most-due; a failing parser yields {} (nothing
    incremented)."""
    out = subprocess.run([sys.executable, str(REPORT), "--json"],
                         capture_output=True, text=True, cwd=ROOT)
    if out.returncode != 0:
        return {}
    try:
        reports = json.loads(out.stdout).get("reports", [])
    except ValueError:
        return {}
    inc = {}
    for row in reports:
        ts = row.get("ts")
        body = row.get("body", "")
        for lane in lanes:
            if lane in inc:
                continue
            if re.search(r"(?<![A-Za-z0-9-])" + re.escape(lane)
                         + r"(?![A-Za-z0-9-])", body):
                inc[lane] = ts
    return inc


def choose_course():
    """Machine-steered pick among in-queue lanes; returns (lane, reasons)
    or (None, "") when nothing is courseable. Scores by mounted .slice
    card (carded first), then ascending recency of last increment (most
    due first), tiebreaking by queue Next order then TSV order. Choice +
    card mount only — never bypasses a gate. The ranking is computed by
    the pure kernel selector when scripts/hngh is available; the
    internal rule serves as a fail-closed fallback."""
    lanes = queue_order()
    if not lanes:
        return None, ""
    mounted = {p.name[:-len(".slice")] for p in CARDS.glob("*.slice")}
    inc = last_increment_ts(lanes)
    rank = {lane: i for i, lane in enumerate(lanes)}

    chosen, reasons = kernel_course_select(
        [f"{lane}:{'true' if lane in mounted else 'false'}:"
         f"{inc.get(lane, '')}:{rank[lane]}" for lane in lanes])
    if chosen is not None:
        return chosen, reasons

    # kernel unavailable or refused: fall back to the internal rule
    def key(lane):
        return (0 if lane in mounted else 1,
                inc.get(lane, NEVER),
                rank[lane])

    chosen = min(lanes, key=key)
    ts = inc.get(chosen)
    reasons = ("card mounted" + (f", last increment {ts}" if ts
                                 else ", never incremented"))
    return chosen, reasons


def kernel_course_select(specs):
    """Ask the pure kernel selector (`scripts/hngh select-course`) for
    the next course among SPECS (id:mounted-p:last-increment:rank).
    Returns (chosen-id, reasons), or (None, None) when the kernel is
    unavailable or refuses — the cadence then falls back to the
    internal rule and never fabricates a choice."""
    if not HNGH.exists():
        return None, None
    try:
        out = subprocess.run([str(HNGH), "select-course", *specs],
                             capture_output=True, text=True, cwd=ROOT,
                             timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    if out.returncode != 0:
        return None, None
    m = re.match(r"course ([^:]+): (.*)", out.stdout.strip())
    if not m:
        return None, None
    return m.group(1), m.group(2).strip()


def slice_card(item):
    """The check-in-scale ceremony card for ITEM, or None. A card is
    heartbeat/<id>.slice: line 1 = objective, line 2 = kind
    (progress|optimization), rest = candidate files (one per line).
    Malformed cards fail closed (raise)."""
    card = CARDS / f"{item}.slice"
    if not card.exists():
        return None
    lines = [l.strip() for l in card.read_text().splitlines()
             if l.strip() and not l.strip().startswith("#")]
    if len(lines) < 3 or lines[1] not in KINDS:
        raise ValueError(f"{card.name}: needs objective + kind + file list")
    return ("ceremony-drive", lines[0], lines[1], lines[2:])


def provision_card(item, reason):
    """Self-start leg: when choose_course picks a lane that has NO
    mounted card, provision one so the NEXT beat can mount and drive it.
    The card objective is the queue row's title (or the item id) and
    kind is progress; the file list is the proposal's evidence paths
    when found in the queue TSV, else the item id as a placeholder
    candidate. Provisioning is advisory — the actual ceremony still
    runs only through the certificate gates on a later tick."""
    q = QUEUE.read_text().splitlines()
    title, evidence = item, ""
    for line in q:
        parts = line.split("\t")
        if len(parts) == 4 and parts[0].strip() == item:
            title = parts[2].strip() or item
            evidence = parts[3].strip()
    # Only trust evidence words that are real repo-relative paths; a
    # prose evidence field must degrade to the item-id placeholder, or
    # the card wedges every future tick with an invalid candidate
    # manifest (observed 2026-08-27: node-lattice-admission).
    files = [w for w in (p.strip() for p in evidence.split())
             if w and "/" in w and (ROOT / w).is_file()]
    card = CARDS / f"{item}.slice"
    card.write_text(f"{title}\nprogress\n" +
                    ("\n".join(files) if files else f"{item}") + "\n")
    return card


def drive_ceremony(store, item, objective, kind, files):
    out = subprocess.run(
        [str(CEREMONY), f"--store={store}", objective, *files],
        capture_output=True, text=True, cwd=ROOT, timeout=1800)
    return out.returncode, (out.stdout or "") + (out.stderr or "")


def tick(day):
    """One tick; returns exit code."""
    ran = False
    body = ""

    # (a) journal generation
    if not journal_exists(day):
        code, text = generate_daily(day)
        if code != 0:
            print(f"run-autonomous: journal generation refused:\n{text}",
                  file=sys.stderr)
            return 3
        first = first_narrative_line(day)
        code, text = run_report("progress", first)
        if code != 0:
            print(f"run-autonomous: progress report failed:\n{text}",
                  file=sys.stderr)
            return 3
        ran = True
        body += f"journal {day} generated; "

    # (b) one machine-coursed check-in-scale ceremony slice
    next_id = queue_next()
    if next_id and open_lane_count() >= 2:
        chosen, reasons = choose_course()
        item = chosen or next_id
        try:
            card = slice_card(item)
        except ValueError as exc:
            print(f"run-autonomous: malformed card: {exc}", file=sys.stderr)
            return 2
        if card is not None:
            if chosen:
                code, text = run_report(
                    "progress", f"course {chosen}: {reasons}")
                if code != 0:
                    print(f"run-autonomous: course report failed:\n{text}",
                          file=sys.stderr)
                    return 3
            _, objective, kind, files = card
            store = f"/tmp/hngh-auto-{int(time.time())}"
            os.makedirs(store, exist_ok=True)
            code, text = drive_ceremony(store, item, objective, kind, files)
            if code != 0:
                print(f"run-autonomous: ceremony refused:\n{text}",
                      file=sys.stderr)
                return 3
            code, text = run_report(kind, f"ceremony {item} complete")
            if code != 0:
                print(f"run-autonomous: ceremony report failed:\n{text}",
                      file=sys.stderr)
                return 3
            ran = True
            body += f"ceremony {item} complete; "
        elif chosen:
            # self-start: no card mounted for the chosen course — provision
            # one now so the next beat drives it (advisory; ceremony stays
            # certificate-gated on the later tick).
            try:
                provision_card(chosen, reasons)
                code, text = run_report(
                    "scheduled", f"course {chosen} provisioned: {reasons}")
                if code != 0:
                    print(f"run-autonomous: provision report failed:\n{text}",
                          file=sys.stderr)
                    return 3
                ran = True
                body += f"course {chosen} provisioned; "
            except OSError as exc:
                print(f"run-autonomous: provision refused:\n{exc}",
                      file=sys.stderr)
                return 3

    # (c) a scheduled report when any timer-driven piece ran
    if ran:
        code, text = run_report("scheduled",
                                f"autonomous cadence tick ran ({day})")
        if code != 0:
            print(f"run-autonomous: scheduled report failed:\n{text}",
                  file=sys.stderr)
            return 3

    # (d) exit 0 even when nothing was due
    print(f"run-autonomous ({day}): {'ran: ' + body if ran else 'nothing due'}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--help", action="store_true")
    args = parser.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0
    try:
        return tick(today())
    except OSError as exc:
        print(f"run-autonomous: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())