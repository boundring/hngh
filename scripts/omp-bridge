#!/usr/bin/env python3
"""omp-bridge — the Hngh-facing half of an oh-my-pi session bridge.

A session invoked THROUGH the bridge (an omp plugin, not yet built, calls
this script) gets three things without re-discovering them:

  (a) `--orient`   one project-state brief already ground from the repo —
                   roadmap Next, queue Next, working-tree dirty check, and
                   the last ceremony commit — so the agent does not waste
                   turns re-walking files it can simply be handed;
  (b) `--register` a ledger line proving the session became watchdog-
                   visible — written into the SAME handoff ledger the
                   roguelike watchdog (hngh-automation/jobs/agent-watchdog
                   .sh) appends to on detection, so this session is never
                   an invisible lane;
  (c) `--ceremony` a ceremony-invoke wrapper that commits FILES through
             scripts/ceremony-drive under a global flock (serial), a
             FRESH ephemeral store, and a generous timeout — certificate-
            gated, and ceremony-drive auto-pushes when origin exists;
  (d) `--run-start` opens a governed delegation: it creates a bounded
            hngh run for SESSION (fixed worker loadout, whose token/time
            limits ARE the session's delegated budget) and admits the
            worker transport, so the session's work rides run governance;
  (e) `--run-end`   closes the loop when that delegation dies or lands:
            it runs scripts/hngh close-run with a client-validated
            disposition (cancelled|evacuated|dead).
             Disposition honesty: a bridge run never enters :running in
             the kernel (the external work happens outside it), so the
             legal close from :created is `cancelled` (wrapped session
             withdrawn) — `evacuated` is only legal once the run has
             actually been driven through the lifecycle. The kernel
            refuses illegal transitions by design; that refusal is the
             contract working, not a bug (proven live 2026-08-27).
  (f) `--propose`   writes a NEW docs/project/plans/<UTC-date>-<slug>.plan.md
             with status=proposed front-matter -- the propose surface
             docs/project/plans/README.md promises; never overwrites.
  (g) `--plan-status [SLUG]` reads plan front-matter (+ step checkboxes)
             as JSON, cross-checked with the dashboard's plans.json when
             available. SLUG is a bare slug or the full date-prefixed stem.

             Post-hoc certification (2026-09-11): (f)/(g) landed
             2026-09-10 outside the loop (`a2f4d0e`, `31768d2`);
             declared in the loop-history guard and re-certified by the
             candidate commit carrying this note
             (docs/records/2026-09-11-omp-bridge-post-hoc-certification
             .md).

The bridge is an outer adapter: it only invokes the existing ceremony /
watchdog surfaces. It never imports or mutates the hngh kernel, and it
records no side effect beyond the handoff ledger line it is asked to
write. No daemon, no scheduler — every run is one explicit command.

Exit protocol (matches repo convention): 0 ok, 1 refused/conflict
(ceremony refused, lock held, hngh refusal), 2 malformed input, 3 fault
(ceremony fault/lock stuck, bridge store unwritable).
"""

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from fcntl import flock, LOCK_EX, LOCK_NB, LOCK_UN
from pathlib import Path

ROOT = Path(os.environ.get("HNGH_BRIDGE_ROOT")
            or Path(__file__).resolve().parent.parent)
SCRIPTS = ROOT / "scripts"
CEREMONY_DRIVE = SCRIPTS / "ceremony-drive"
HNGH_BIN = Path(os.environ.get("HNGH_BIN") or SCRIPTS / "hngh")
QUEUE = ROOT / "docs" / "project" / "queue.md"
ROADMAP = ROOT / "docs" / "project" / "roadmap.md"
PLANS = ROOT / "docs" / "project" / "plans"

# Where the roguelike watchdog writes the handoff it AND the operator /
# steering leg read. Default is the sibling hngh-automation repo's ledger;
# override for tests / alternate mounts.
AUTOMATION_ROOT = Path(os.environ.get("HNGH_AUTOMATION_ROOT")
                       or ROOT.parent / "hngh-automation")
PLANS_JSON = AUTOMATION_ROOT / "dashboard" / "plans.json"
LEDGER = Path(os.environ.get("OMP_HANDOFF_LEDGER")
              or AUTOMATION_ROOT / "agent-handoffs.md")
# Where delegated runs are recorded so --run-end can close them. One
# shared ledger: at check-in scale a single bridge run is in flight at a
# time, so every start/end pair lands in the same store.
# ponytail: single global bridge store; per-run stores if two delegated
# sessions ever need to be open concurrently.
BRIDGE_STORE = Path(os.environ.get("OMP_BRIDGE_STORE")
                    or AUTOMATION_ROOT / "bridge")
LOCK = Path(os.environ.get("OMP_CEREMONY_LOCK") or "/tmp/hngh-ceremony.lock")
CEREMONY_TIMEOUT = int(os.environ.get("OMP_CEREMONY_TIMEOUT") or 1800)

NEXT_RE = re.compile(r"## Next\s*\n(.*?)(?=\n## |\Z)", re.S)
BULLET_ITEM = re.compile(r"^\s*(?:-\s*\*\*|1\.\s*\*\*|-\s+|1\.\s+)"
                         r"(?P<item>[^\n]+)", re.M)
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
FRONT_RE = re.compile(r"<!--\s*plan:(.*?)-->", re.S)
KV_RE = re.compile(r"([a-z-]+)=\"([^\"]*)\"|([a-z-]+)=(\S+)")
STEPS_RE = re.compile(r"## Steps\s*\n(.*?)(?=\n## |\Z)", re.S)


def parse_plan(path):
    """Front-matter dict + (steps_total, steps_done) from a plan file.
    None if no first plan comment (unreadable front-matter)."""
    try:
        text = path.read_text()
    except OSError:
        return None
    m = FRONT_RE.search(text)
    if not m:
        return None
    meta = {}
    for ascii_k, q, k, v in KV_RE.findall(m.group(1)):
        meta[ascii_k or k] = q or v
    sm = STEPS_RE.search(text)
    body = sm.group(1) if sm else ""
    total = len(re.findall(r"^- \[[ x]\]", body, re.M))
    done = len(re.findall(r"^- \[x\]", body, re.M))
    return meta, total, done


def plan_slug(path):
    """<date>-<slug>.plan.md -> slug (the stem; the dashboard's
    plans.json keys rows by the same date-prefixed slug)."""
    return path.name[:-len(".plan.md")]


def dashboard_rows():
    """plans.json rows (slug-keyed) when the dashboard file is readable."""
    try:
        return {r["slug"]: r for r in json.load(PLANS_JSON.open())["plans"]}
    except (OSError, ValueError, KeyError, TypeError):
        return {}


def plan_row(slug, path, meta, total, done, rows):
    """One --plan-status JSON row: front-matter values, overridden by the
    dashboard's plans.json row when present (source flags which won)."""
    row = rows.get(slug)
    src = "dashboard" if row else "frontmatter"
    over = row or {}
    return {
        "slug": slug,
        "file": str(path.relative_to(ROOT)),
        "status": over.get("status", meta.get("status")),
        "risk": over.get("risk", meta.get("risk")),
        "accepted": over.get("accepted", meta.get("accepted")),
        "steps_total": over.get("steps_total", total),
        "steps_done": over.get("steps_done", done),
        "source": src,
    }


def plan_status_cmd(slug):
    """--plan-status [SLUG]: JSON on stdout. No slug: all plans, newest
    first. SLUG is a full date-prefixed stem or a bare slug (exact stem
    match preferred; else any stem ending -{slug}, newest wins -- dates
    are fixed-width prefixes so the suffix form is unambiguous).
    Exit 2 unknown slug, 3 unreadable front-matter, 0 otherwise."""
    rows = dashboard_rows()
    files = sorted(PLANS.glob("*.plan.md"), reverse=True) if PLANS.is_dir() else []
    if slug:
        matches = [f for f in files if plan_slug(f) == slug] or \
                  [f for f in files if plan_slug(f).endswith(f"-{slug}")]
        for f in matches:
            slug = plan_slug(f)
            parsed = parse_plan(f)
            if parsed is None:
                print(f"omp-bridge: unreadable plan front-matter: {f}",
                      file=sys.stderr)
                return 3
            meta, total, done = parsed
            print(json.dumps(plan_row(slug, f, meta, total, done, rows)))
            return 0
        print(f"omp-bridge: unknown plan slug: {slug}", file=sys.stderr)
        return 2
    arr = []
    for f in files:
        parsed = parse_plan(f)
        if parsed is None:
            continue
        meta, total, done = parsed
        arr.append(plan_row(plan_slug(f), f, meta, total, done, rows))
    print(json.dumps(arr))
    return 0


def propose_cmd(slug, title, risk):
    """--propose: write a NEW <UTC-date>-<slug>.plan.md with status=proposed
    front-matter (the propose surface plans/README.md promises). Proposing
    is free -- risk=critical is writable; acceptance never happens here."""
    if (not slug or not slug.isascii() or len(slug) > 64
            or not SLUG_RE.match(slug)):
        print("omp-bridge: slug must match ^[a-z0-9][a-z0-9-]*$ "
              f"(ASCII, <=64 chars): {slug!r}", file=sys.stderr)
        return 2
    if not (title or "").strip():
        print("omp-bridge: empty or missing --title refused", file=sys.stderr)
        return 2
    if risk not in ("normal", "critical"):
        print("omp-bridge: --risk must be normal|critical", file=sys.stderr)
        return 2
    target = PLANS / f"{datetime.now(timezone.utc).strftime('%Y-%m-%d')}-{slug}.plan.md"
    if target.exists():
        print(f"omp-bridge: plan already exists, never overwritten: {target}",
              file=sys.stderr)
        return 1
    front = f"<!-- plan: status=proposed risk={risk} accepted=- -->"
    body = (f"{front}\n# {title.strip()}\n\n"
            "Proposed via `omp-bridge --propose` (omp session propose surface;\n"
            "see docs/project/plans/README.md).\n")
    try:
        PLANS.mkdir(parents=True, exist_ok=True)
        target.write_text(body)
    except OSError as exc:
        print(f"omp-bridge: cannot write plan {target}: {exc}", file=sys.stderr)
        return 3
    print(target)
    print(front)
    return 0


def now_ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def git(*cmd):
    out = subprocess.run(["git", *cmd], capture_output=True, text=True, cwd=ROOT)
    return out.returncode, out.stdout.strip(), out.stderr.strip()


# --- orient ----------------------------------------------------------------

def queue_next():
    """The current queue Next item id (from the `## Next` block)."""
    if not QUEUE.exists():
        return None
    m = next(iter(NEXT_RE.finditer(QUEUE.read_text())), None)
    if m is None:
        return None
    mm = BULLET_ITEM.search(m.group(0))
    item = mm.group("item").strip() if mm else None
    return item.split("**")[0].strip() if item else None


def roadmap_next():
    """The roadmap `## Next` block's first item, trimmed to a line."""
    if not ROADMAP.exists():
        return None
    m = next(iter(NEXT_RE.finditer(ROADMAP.read_text())), None)
    if m is None:
        return None
    body = m.group(0)
    mm = next(iter(BULLET_ITEM.finditer(body)), None)
    if mm is None:
        return None
    item = re.sub(r"\s+", " ", mm.group("item")).strip()
    return item.split("**")[0].strip()[:220]


def dirty_state():
    """Working-tree dirty summary: (bool_dirty, first_line)."""
    code, out, err = git("status", "--porcelain")
    if code != 0:
        return None, f"git status failed: {err}"
    if not out:
        return False, "clean"
    lines = out.splitlines()
    return True, f"{len(lines)} uncommitted path{'s' if len(lines) != 1 else ''} (e.g. {lines[0][:60]}...)"


def last_ceremony():
    """The last ceremony commit: subject starts word-on 'hngh: candidate'
    (the certificate-bound commit message ceremony-drive writes)."""
    code, out, _ = git(
        "log", "--format=%H|%cs|%s", "-50")
    if code != 0:
        return None
    for line in out.splitlines():
        pieces = line.split("|", 2)
        if len(pieces) == 3 and pieces[2].startswith("hngh: candidate"):
            return {"hash": pieces[0], "date": pieces[1], "subject": pieces[2]}
    return None


def orient_cmd():
    """Emit the project-state brief the calling session is handed."""
    qn = queue_next()
    rm = roadmap_next()
    dirty, dirty_first = dirty_state()
    cer = last_ceremony()

    print(f"# hngh project brief ({ROOT}) — {now_ts()}")
    print()
    print("## Queue Next")
    print(qn if qn else "(none)")
    print()
    print("## Roadmap Next")
    print(rm if rm else "(none)")
    print()
    print("## Working tree")
    print(dirty_first if dirty is not None else "(unreadable)")
    print()
    print("## Last ceremony commit")
    if cer:
        print(f"{cer['date']}  {cer['hash']}")
        print(cer["subject"])
    else:
        print("(no ceremony commit found)")
    return 0


# --- register --------------------------------------------------------------

def register_cmd(session, note):
    """Append one session lane to the watchdog-visible handoff ledger.

    Same ledger the roguelike watchdog appends `session-drop` lines to; the
    class is `bridge-session-start` so an operator/steering reader sees a
    governed session going live, distinct from (and never colliding with) a
    death handoff. The subject is project-slug|session-id so it matches the
    watchdog's `| slug|session |` cells.
    """
    slug = os.environ.get("OMP_PROJECT", ROOT.name)
    sid = session or os.environ.get("OMP_SESSION", "")
    subj = f"{slug}|{sid}" if sid else slug
    note = (note or "session entered through omp-bridge").strip()
    if "|" in note:
        print("omp-bridge: note must not contain '|' (pipe-delimited ledger)",
              file=sys.stderr)
        return 2
    lead = ""
    if LEDGER.exists() and LEDGER.read_text() and not LEDGER.read_text().endswith("\n"):
        lead = "\n"
    line = (lead
            + f"bridge-register | {now_ts()} | {subj} | session-start: {note}\n")
    try:
        LEDGER.parent.mkdir(parents=True, exist_ok=True)
        with LEDGER.open("a") as fh:
            fh.write(line)
    except OSError as exc:
        print(f"omp-bridge: cannot write ledger {LEDGER}: {exc}",
              file=sys.stderr)
        return 3
    print(line.rstrip())
    return 0


# --- ceremony --------------------------------------------------------------

def ceremony_cmd(objective, files):
    """Run scripts/ceremony-drive over FILES from a fresh store, serialized.

    Global flock (default /tmp/hngh-ceremony.lock, non-blocking) keeps
    concurrent ceremony wraps from racing; a fresh ephemeral store
    (/tmp/hngh-cer-<ts>-<rand>) means no two runs share a receipt root; the
    generous timeout lets a full model-review loop finish. ceremony-drive
    auto-pushes when origin exists.
    """
    if not CEREMONY_DRIVE.exists():
        print(f"omp-bridge: ceremony-drive not found at {CEREMONY_DRIVE}",
              file=sys.stderr)
        return 3
    if not objective.strip():
        print("omp-bridge: empty OBJECTIVE refused", file=sys.stderr)
        return 2
    if not files:
        print("omp-bridge: no FILES given to commit", file=sys.stderr)
        return 2
    now = now_ts().replace(":", "").replace("-", "").replace("T", "-")[:-1]
    store = Path(os.environ.get("OMP_CEREMONY_STORE") or f"/tmp/hngh-cer-{now}")
    try:
        store.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"omp-bridge: cannot create store {store}: {exc}",
              file=sys.stderr)
        return 3
    lockfd = None
    try:
        lockfd = open(str(LOCK), "w")
    except OSError as exc:
        print(f"omp-bridge: cannot open lock {LOCK}: {exc}", file=sys.stderr)
        return 3
    try:
        try:
            flock(lockfd.fileno(), LOCK_EX | LOCK_NB)
        except BlockingIOError:
            print("omp-bridge: ceremony already in progress "
                  f"(lock {LOCK} held); try again when it lands",
                  file=sys.stderr)
            return 1
        cmd = [str(CEREMONY_DRIVE), f"--store={store}", objective, *files]
        try:
            proc = subprocess.run(cmd, cwd=ROOT, timeout=CEREMONY_TIMEOUT,
                                  capture_output=True, text=True)
        except subprocess.TimeoutExpired:
            print(f"omp-bridge: ceremony exceeded {CEREMONY_TIMEOUT}s; "
                  "store left at " + str(store), file=sys.stderr)
            return 3
        out = (proc.stdout or "") + (proc.stderr or "")
        if out:
            print(out, end="" if out.endswith("\n") else "\n")
        if proc.returncode not in (0,):
            print(f"omp-bridge: ceremony refused (exit {proc.returncode})",
                  file=sys.stderr)
        return proc.returncode
    finally:
        try:
            flock(lockfd.fileno(), LOCK_UN)
        except OSError:
            pass
        lockfd.close()


# --- run lifecycle (delegation loop) -------------------------------------

DISPOSITIONS = ("cancelled", "evacuated", "dead")


def _run_hngh(label, argv):
    """Invoke scripts/hngh with ARGV, relay its rendered output, and
    return its exit code unchanged (the house 0/1/2/3 protocol).
    No flock: run-start/run-end are independent, non-serial steps."""
    proc = subprocess.run([str(HNGH_BIN), *argv], cwd=ROOT,
                          capture_output=True, text=True)
    out = (proc.stdout or "") + (proc.stderr or "")
    if out:
        print(out, end="" if out.endswith("\n") else "\n")
    if proc.returncode not in (0,):
        print(f"omp-bridge: {label} refused (exit {proc.returncode})",
              file=sys.stderr)
    return proc.returncode


def run_start_cmd(session, objective, task_label):
    """Gate SESSION behind hngh admission: create a bounded builder run
    (whose loadout token/time limits are the session's delegated budget)
    and admit its worker transport."""
    session = session.strip()
    objective = objective.strip()
    if not session:
        print("omp-bridge: empty SESSION refused", file=sys.stderr)
        return 2
    if not objective:
        print("omp-bridge: empty OBJECTIVE refused", file=sys.stderr)
        return 2
    route = (task_label or "model").strip()
    if not route:
        print("omp-bridge: empty task label refused", file=sys.stderr)
        return 2
    try:
        BRIDGE_STORE.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"omp-bridge: cannot create store {BRIDGE_STORE}: {exc}",
              file=sys.stderr)
        return 3
    store_arg = f"--store={BRIDGE_STORE}"
    code = _run_hngh("create-run", [
        store_arg, "create-run", objective, "builder",
        f"loadout-route-label={route}",
        "loadout-context-limit=8000",
        "loadout-token-limit=8000",
        "loadout-cost-limit=2000",
        "loadout-time-limit=3600",
        "loadout-tool-labels=worker-task/mutation",
        "loadout-network-labels=model-review",
        "loadout-writable-scopes=repository"])
    if code:
        return code
    code = _run_hngh("admit-transport",
                     [store_arg, "admit-transport", "run-1", "worker"])
    if code:
        return code
    print(f"run run-1 session {session}")
    return 0


def run_end_cmd(run, disposition):
    """Close a dead/completed delegated run. DISPOSITION is validated
    client-side; hngh close-run renders the governing close."""
    run = run.strip()
    if not run:
        print("omp-bridge: empty RUN refused", file=sys.stderr)
        return 2
    if disposition not in DISPOSITIONS:
        print(f"omp-bridge: disposition must be one of "
              f"{'|'.join(DISPOSITIONS)}", file=sys.stderr)
        return 2
    return _run_hngh("close-run",
                     [f"--store={BRIDGE_STORE}", "close-run", run, disposition])


# --- main ------------------------------------------------------------------

def main(argv=None):
    p = argparse.ArgumentParser(prog="omp-bridge", add_help=False)
    p.add_argument("--help", action="store_true")
    p.add_argument("--orient", action="store_true")
    p.add_argument("--register", metavar="SESSION",
                   help="register SESSION (or $OMP_SESSION) into the handoff ledger")
    p.add_argument("--note", metavar="TEXT")
    p.add_argument("--task", metavar="LABEL",
                   help="run-start route label (default model)")
    p.add_argument("--run-start", nargs=2, metavar=("SESSION", "OBJECTIVE"),
                   help="open a bounded hngh run for SESSION and admit its "
                        "worker transport")
    p.add_argument("--run-end", nargs=2, metavar=("RUN", "DISPOSITION"),
                   help="close RUN with DISPOSITION (cancelled|evacuated|dead)")
    p.add_argument("--ceremony", action="store_true",
                   help="ceremony-commit the following OBJECTIVE and FILES")
    p.add_argument("--propose", metavar="SLUG",
                   help="write a new docs/project/plans/<date>-<slug>.plan.md "
                        "(status=proposed); never overwrites")
    p.add_argument("--title", metavar="TEXT",
                   help="one-line title for --propose")
    p.add_argument("--risk", metavar="RISK", default="normal",
                   help="normal|critical for --propose (default normal)")
    p.add_argument("--plan-status", nargs="?", const="", default=None,
                   metavar="SLUG",
                   help="emit plan status JSON (all plans, or one by slug)")
    p.add_argument("rest", nargs="*")
    args = p.parse_args(argv)

    if args.help:
        print(__doc__.strip())
        return 0
    if args.orient:
        return orient_cmd()
    if args.register:
        return register_cmd(args.register, args.note)
    if args.run_start:
        return run_start_cmd(args.run_start[0], args.run_start[1], args.task)
    if args.run_end:
        return run_end_cmd(args.run_end[0], args.run_end[1])
    if args.ceremony:
        if not args.rest:
            print("usage: omp-bridge --ceremony OBJECTIVE FILE...",
                  file=sys.stderr)
            return 2
        return ceremony_cmd(args.rest[0], args.rest[1:])
    if args.propose:
        return propose_cmd(args.propose, args.title, args.risk)
    if args.plan_status is not None:
        return plan_status_cmd(args.plan_status)
    print("usage: omp-bridge --orient | --register[=SESSION] [--note TEXT] | "
          "--ceremony OBJECTIVE FILE... | --run-start SESSION OBJECTIVE "
          "[--task LABEL] | --run-end RUN DISPOSITION | --propose SLUG "
          "--title TEXT [--risk normal|critical] | --plan-status [SLUG] "
          "| --help",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())