#!/usr/bin/env -S sbcl --script
;;; scripts/worker-driver --- the one continual-worker cycle driver.
;;;
;;; Runs the worker lane end to end in one explicit operation against a
;;; fresh store: create-run (worker-task label) -> admit-transport worker ->
;;; run one bounded read-only worker task -> close the run (evacuated).
;;; It is glue around the existing dispatch surface, NOT new authority:
;;; every step is the same closed command the operator would run directly,
;;; checked in order, and the receipt lives in the store under --store.
;;; The worker executes no mutation and carries no certificate; a
;;; self-report is evidence, never acceptance. The periodic invocation
;;; belongs to the operator's own scheduler, never inside Hngh (no daemon).
;;;
;;; Usage:
;;;   sbcl --script scripts/worker-driver --store=PATH OBJECTIVE TASK [PAYLOAD]
;;; Exit: 0 complete cycle, 1 refused, 2 malformed, 3 transport fault.

(require :asdf)
(require :uiop)

(let* ((script-path (or *load-truename* *compile-file-truename*
                        (truename (first sb-ext:*posix-argv*))))
       (repo-root (make-pathname :directory (butlast (pathname-directory script-path))))
       (asd-file (merge-pathnames "hngh.asd" repo-root)))
  (asdf:load-asd asd-file)
  (asdf:load-system :hngh))

;; Split --store=PATH out of the argv; the rest are positional.
(defun split-argv (argv)
  (loop for arg in argv
        if (and (> (length arg) 8) (string= arg "--store=" :end1 8))
          collect (subseq arg 8) into store
        else collect arg into positionals
        finally (return (values (first store) positionals))))

;; The closed step list: each is one explicit dispatch invocation; a
;; nonzero exit stops the cycle with that code and prints the refusal.
(defun run-cycle (store objective task payload)
  (let ((store-arg (format nil "--store=~A" store)))
    (labels ((do-step (argv)
               (multiple-value-bind (output code)
                   (hngh.main:dispatch-command (cons store-arg argv))
                 (format t "~A~%" output)
                 code)))
      (let ((code
              (do-step (list "create-run" objective "builder"
                          "loadout-route-label=local"
                          "loadout-context-limit=1000"
                          "loadout-token-limit=1000"
                          "loadout-cost-limit=1000"
                          "loadout-time-limit=1000"
                          "loadout-tool-labels=worker-task"
                          "loadout-network-labels=none"
                          "loadout-writable-scopes=repository"))))
        (when (plusp code) (return-from run-cycle code))
        (let ((code (do-step (list "admit-transport" "run-1" "worker"
                                "repository"))))
          (when (plusp code) (return-from run-cycle code))
          (let ((code (do-step (list "run-worker" "run-1"
                                  (format nil "task=~A" task)
                                  (and payload
                                       (format nil "payload=~A" payload))))))
            (when (plusp code) (return-from run-cycle code))
            (do-step (list "close-run" "run-1" "evacuated"))))))))

(when (member "--help" (uiop:raw-command-line-arguments) :test #'string=)
  (format *standard-output* "--help: run one continuous worker cycle; see header.~%")
  (uiop:quit 0))

(multiple-value-bind (store positionals)
    (split-argv (uiop:raw-command-line-arguments))
  (unless (and store (>= (length positionals) 2))
    (format *standard-output*
            "usage: sbcl --script scripts/worker-driver --store=PATH OBJECTIVE TASK [PAYLOAD]~%")
    (uiop:quit 2))
  (let ((code (run-cycle store (first positionals) (second positionals)
                         (third positionals))))
    (uiop:quit code)))