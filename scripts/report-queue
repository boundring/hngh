#!/usr/bin/env python3
"""report-queue — append-only report ledger with a dashboard / body split.

A report queue over repo files. Each report appends one markdown row to
docs/project/reports.md (table header `| timestamp | kind | id | first
line | body |`, one row per line), and its full body goes to
docs/project/report-bodies/<ts>-<kind>-<id>.md. KIND ∈
progress|expense|optimization|scheduled|alert.

Commands (exit 2 on malformed input, never crash on a missing
cursor/body — fail closed):

  --add KIND TEXT      append a row and write the body file; id = first 8
                       hex of sha256(TEXT); ts = UTC ISO second. Refuses a
                       bad KIND or empty TEXT (exit 2).
                       Alert and progress text are public-bound:
                       user-home path tokens (slash + home + slash +
                       user + rest) and /tmp/... tokens are rewritten
                       to ~/... and ~tmp/... before id/row/body are
                       derived (alert: 2026-09-16 boundary redaction;
                       progress: 2026-09-17, the sink control extends
                       to it). The rewrite only matches machine-local
                       absolute prefixes, so repo-relative paths — the
                       old progress carve-out's rationale — pass
                       through untouched, and mid-token forms
                       (/tmpfile, URL path components) stay as written.
                       With --identity KEY, dedup: when a row of the same
                       KIND within --window SECONDS (default 86400; 0 =
                       unlimited lookback) stores the same identity, no new
                       row is appended (newest match wins) — the
                       row's first line gains/updates a ` ×N` marker (N =
                       total occurrences) and `- <UTC ts> occurrence` is
                       appended to that row's body. The row keeps its
                       original ts/id. The identity is stored in the body
                       meta on first add (`identity: KEY`), so later adds
                       match on kind + stored identity even if TEXT
                       drifted. Naming: identity = stable kebab token
                       (e.g. 'stale-store:<path>', 'slow-unit:<unit>');
                       occurrences = body lines; count = the ×N marker.
                       Without --identity, behavior is unchanged.
                       With --evidence TOKEN, the underlying condition
                       must have RECURRED to re-fire: when the stored
                       last-evidence equals TOKEN, the occurrence is
                       suppressed with a body breadcrumb (no bump, no
                       new row) — only changed evidence bumps. The
                       evidence is stored as a `last-evidence` body
                       meta line and must be a token derived from fresh
                       failing state (e.g. the tail of the failing log
                       line), not a constant.
                       Boundary closure (2026-09-16): --identity and
                       --evidence are rewritten by the same guard as
                       alert TEXT at the argument boundary, BEFORE the
                       dedup window lookup — the dedup key is the
                       redacted form, on every kind (the keys are
                       ledger-bound, stored in the git-tracked body
                       meta). Rows filed before this guard are matched
                       through the same rewrite of their stored value,
                       so raw and redacted spellings of one identity
                       collide instead of stranding duplicate rows.
  --list [KIND]        rows, newest-first, optional KIND filter.
  --unread [KIND]      rows newer than the cursor (docs/project/
                       report-cursor). With no cursor file present, every
                       row is unread. The DISPLAY layer advances the
                       cursor, never the writer; --mark-read is how.
  --mark-read ID       write ID to the cursor (advance it past a report).
                       Refuses an unknown ID (exit 2).
  --prune --before TS --kinds KIND[,KIND...] [--archive PATH]
                       remove rows of the listed kinds older than TS from
                       reports.md and delete their body files; never
                       touches unlisted kinds. Refuses a missing or future
                       TS (exit 2). With --archive PATH, first appends a
                       `## pruned <TS>` section with the removed rows to
                       PATH. Prints `pruned N rows, M bodies[, archived
                       to PATH]`.
  --json               dashboard payload: {"reports":[{ts, kind, id,
                       first, body}, ...], "unread": N, "summary":{kind: n}}.

Fail closed: a missing cursor yields every row, a missing body yields
empty text, and any file fault exits 2. Paths are overridable for
tests via HNGH_REPORT_ROOT (points at the repo root).
"""

import argparse
import hashlib
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

KINDS = {"progress", "expense", "optimization", "scheduled", "alert"}
# kinds whose TEXT is public-bound and sink-redacted (alert was the
# 2026-09-16 original scope; progress joined 2026-09-17 — its old
# carve-out rested on repo-relative paths, which the rewrite preserves)
PUBLIC_KINDS = ("alert", "progress")

# Boundary redaction (2026-09-16; widened to progress 2026-09-17): the
# ledger is git-tracked and pushed to the public origin, so alert and
# progress text may never carry a machine-local path prefix. Sink-side
# backstop mirroring the ONE token family from
# automation/lib/scrub.py (llc-gate-scrub-site-divergence consolidation
# 2026-09-16; kernel code never imports automation/, so the family is
# mirrored here and pinned by tests both sides): "home" / "Users" /
# "root" / "tmp" absolute-prefix families (slash + name, optional user
# segment, optional rest) become ~/... with tmp rendered ~tmp/...
# scheme-relative //host/home/... becomes ~/..., and credential URL
# userinfo (user:pass@host) becomes [redacted]@host. Emitters
# (automation/lib/scrub.sh redact_home) redact before filing; this
# guard excludes a preceding [A-Za-z0-9.~/-] char so mid-token hits
# (e.g. a URL with a home-like path component) and word fragments
# (/rooted) stay untouched.
# Sink bypass closure (2026-09-16, this guard applies to): alert TEXT
# (the original scope), progress TEXT (2026-09-17 widening), --identity
# and --evidence keys (stored in the
# body meta), every body free-text write (direct write_body callers
# included), and the occurrence/suppressed appends. The rewrite is
# idempotent and runs BEFORE the dedup window scan, so the dedup key
# is the redacted form; stored pre-guard raw values are read back
# through the same rewrite (normalize_boundary) so they still match.
_REDACT_HOME = "/" + "home"  # split so this file stays gate-clean
_R = "/"  # same split-literal discipline for the extended families
_GUARD = r"(^|[^A-Za-z0-9.~/-])"  # mid-token guard, mirrors scrub.py
_TOK_END = r"(?![\w-])"  # /home-x and /homepage are words, not paths


def _tilde_rest(name):
    """Replacement factory: drop the consumed prefix, keep the rest."""
    return lambda m: m.group(1) + "~" + (m.group(name) or "")


REDACT_RES = (
    # /home[/user][/rest] -> ~/rest   (user segment consumed and dropped)
    (re.compile(_GUARD + _REDACT_HOME + r"(?:/[^/\s]+)?(?P<homerest>/\S*)?"
                + _TOK_END), _tilde_rest("homerest")),
    # /Users[/user][/rest] -> ~/rest
    (re.compile(_GUARD + _R + r"Users(?:/[^/\s]+)?(?P<usersrest>/\S*)?"
                + _TOK_END), _tilde_rest("usersrest")),
    # /root[/rest] -> ~/rest
    (re.compile(_GUARD + _R + r"root(?=[/\s]|\Z)(?P<rootrest>/\S*)?"),
     _tilde_rest("rootrest")),
    # //host/home[/user][/rest] -> ~/rest   (scheme-relative mounts; the
    # leading guard excludes ':' so a URL's scheme:// colon-slash pair
    # can never start this match — mid-token URL guard preserved)
    (re.compile(r"(^|[^A-Za-z0-9.~:/-])//[^/\s]+" + _REDACT_HOME
                + r"(?:/[^/\s]+)?(?P<srhrest>/\S*)?" + _TOK_END),
     _tilde_rest("srhrest")),
    # /tmp[/rest] -> ~tmp/rest
    (re.compile(_GUARD + _R + r"tmp(?=[/\s]|\Z)(?P<tmprest>/\S*)?"),
     lambda m: m.group(1) + "~tmp" + (m.group("tmprest") or "")),
)


def redact_boundary(text):
    """The boundary rewrite for any sink-carried string (alert TEXT,
    identity/evidence keys, body text, meta lines, appends)."""
    for rx, repl in REDACT_RES:
        text = rx.sub(repl, text)
    # credential URL userinfo dies AFTER the path families so a URL the
    # path rules preserved still loses user:pass@ (one family, kernel
    # rendering: [redacted]@host; mirrors automation/lib/scrub.py).
    text = re.sub(r"(?<=//)[^/@\s]+@", "[redacted]@", text)
    return text


def redact_public_text(text):
    """The public-bound TEXT rewrite for --add rows (alert and progress
    kinds; named redact_alert_text before the 2026-09-17 widening)."""
    return redact_boundary(text)


_RAW_BOUNDARY = re.compile(
    r"(?:^|[^A-Za-z0-9.~/-])" + _REDACT_HOME + r"/"
    r"|(?:^|[^A-Za-z0-9.~/-])/tmp(?=[/\s]|\Z)")


def boundary_dirty(text):
    """True when TEXT still carries a raw machine-local path token."""
    return bool(_RAW_BOUNDARY.search(text))


def normalize_boundary(text):
    """Comparison form for stored identity/evidence metas: clean values
    pass through byte-identical, raw (pre-guard) values get the
    rewrite. Applied on BOTH sides of every identity/evidence
    comparison, so redacted arguments still dedup against rows filed
    before the sink guard existed."""
    return redact_boundary(text) if boundary_dirty(text) else text

ROOT = Path(os.environ.get("HNGH_REPORT_ROOT")
            or Path(__file__).resolve().parent.parent)
REPORTS = ROOT / "docs" / "project" / "reports.md"
BODIES = ROOT / "docs" / "project" / "report-bodies"
CURSOR = ROOT / "docs" / "project" / "report-cursor"

HEADER = "| timestamp | kind | id | first line | body |"
HEADER_CELLS = [c.strip() for c in HEADER.strip("|").split("|")]


def sha8(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:8]


def now_ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_rows():
    """Return the report rows in file order (oldest first).

    Each row is a list of 5 strings parsed from a `| … ` line. Non-table
    lines (header, blank, prose) are skipped, so extra markdown never
    breaks the ledger.
    """
    if not REPORTS.exists():
        return []
    rows = []
    for line in REPORTS.read_text().splitlines():
        line = line.strip()
        if not (line.startswith("|") and line.endswith("|")):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) == 5 and cells != HEADER_CELLS:
            rows.append(cells)  # [ts, kind, id, first, body-name]
    return rows


def body_path(ts, kind, rid):
    return BODIES / f"{ts}-{kind}-{rid}.md"


def body_name(ts, kind, rid):
    return f"{ts}-{kind}-{rid}.md"


def write_body(ts, kind, rid, first, full, identity=None, evidence=None,
               redact_text=True, cls=None):
    """Write one body sidecar. The boundary rewrite applies to the
    identity/evidence metas unconditionally and to FIRST/FULL unless
    REDACT_TEXT is False -- the argv pass in add() sets that only for
    kinds outside PUBLIC_KINDS (alert and progress are redacted), so a
    direct caller (no --add argv pass) is guarded by construction."""
    BODIES.mkdir(parents=True, exist_ok=True)
    if redact_text:
        first = redact_boundary(first)
        full = redact_boundary(full)
    ident = (f"- **identity:** {redact_boundary(identity)}\n"
             if identity else "")
    ev = (f"- **last-evidence:** {redact_boundary(evidence)}\n"
          if evidence else "")
    cl = (f"- **class:** {cls}\n" if cls else "")
    body_path(ts, kind, rid).write_text(
        f"# {kind} — {rid}\n\n- **timestamp:** {ts}\n"
        f"- **kind:** {kind}\n- **first line:** {first}\n"
        f"{ident}{ev}{cl}\n{full}\n")


def parse_ts(s):
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc)
    except ValueError:
        raise ValueError(f"report-queue: bad timestamp {s!r} "
                         f"(expected YYYY-MM-DDTHH:MM:SSZ)")


def ensure_header():
    if not REPORTS.exists():
        REPORTS.parent.mkdir(parents=True, exist_ok=True)
        REPORTS.write_text(HEADER + "\n")
    elif not REPORTS.read_text().startswith(HEADER):
        REPORTS.write_text(HEADER + "\n" + REPORTS.read_text())


def row_identity(row):
    """The identity stored in a row's body meta, in comparison form
    (normalize_boundary), or None."""
    for line in body_text(*row[:3]).splitlines():
        if line.startswith("- **identity:** "):
            return normalize_boundary(
                line[len("- **identity:** "):].strip())
    return None


def body_evidence(ts, kind, rid):
    """The last-evidence token stored in a row's body, in comparison
    form (normalize_boundary), or None."""
    for line in body_text(ts, kind, rid).splitlines():
        if line.startswith("- **last-evidence:** "):
            return normalize_boundary(
                line[len("- **last-evidence:** "):].strip())
    return None


def body_class(ts, kind, rid):
    """The class meta stored in a row's body ('critical'), or None."""
    for line in body_text(ts, kind, rid).splitlines():
        if line.startswith("- **class:** "):
            return line[len("- **class:** "):].strip()
    return None


def set_body_evidence(ts, kind, rid, evidence):
    """Store/replace the `last-evidence` body meta line (rewritten)."""
    evidence = redact_boundary(evidence)
    p = body_path(ts, kind, rid)
    out, seen = [], False
    for ln in p.read_text().splitlines(keepends=True):
        if ln.startswith("- **last-evidence:** "):
            out.append(f"- **last-evidence:** {evidence}\n")
            seen = True
        else:
            out.append(ln)
    if not seen:
        out.append(f"- **last-evidence:** {evidence}\n")
    p.write_text("".join(out))


def within_window(ts_str, window):
    """True when the row ts is newer than now - window (0 = unlimited)."""
    if window <= 0:
        return True
    try:
        then = parse_ts(ts_str)
    except ValueError:
        return False
    return (datetime.now(timezone.utc) - then).total_seconds() <= window


def bump_row(row, ts):
    """Fold one occurrence into an existing row: ×N marker + body line."""
    ts0, kind, rid, first, _ = row
    m = re.search(r" ×(\d+)$", first)
    count = (int(m.group(1)) if m else 1) + 1
    new_first = f"{first[:m.start()] if m else first} ×{count}"
    lines = REPORTS.read_text().splitlines(keepends=True)
    for i, line in enumerate(lines):
        s = line.strip()
        if not (s.startswith("|") and s.endswith("|")):
            continue
        cells = [c.strip() for c in s.strip("|").split("|")]
        if len(cells) == 5 and cells[:3] == [ts0, kind, rid]:
            cells[3] = new_first
            lines[i] = "| " + " | ".join(cells) + " |\n"
            break
    else:
        raise ValueError(f"report-queue: row {rid!r} vanished mid-bump")
    REPORTS.write_text("".join(lines))
    with body_path(ts0, kind, rid).open("a") as fh:
        fh.write(redact_boundary(f"- {ts} occurrence\n"))


def add(kind, text, identity=None, window=86400, evidence=None, cls=None):
    if kind not in KINDS:
        print(f"report-queue: bad kind {kind!r} (expected "
              f"{'/'.join(sorted(KINDS))})", file=sys.stderr)
        return 2
    if not text.strip():
        print("report-queue: empty TEXT refused", file=sys.stderr)
        return 2
    text = text.strip()
    # durable alert class (2026-09-22-router-alert-class-channel):
    # only `critical` stores a class meta; `normal` and legacy filings
    # store none, so absence stays the default.
    cls = "critical" if cls == "critical" else None
    if kind in PUBLIC_KINDS:
        # boundary redaction before anything is derived from TEXT (id,
        # first line, body) — the public ledger never stores the raw
        # machine-local path (alert 2026-09-16; progress 2026-09-17)
        text = redact_boundary(text)
    # identity and evidence are ledger-bound dedup keys on every kind:
    # they are stored in the git-tracked body meta, so they are
    # rewritten at the argument boundary, BEFORE the window scan — the
    # dedup key is the redacted form (2026-09-16 sink bypass closure;
    # stored pre-guard raw values are matched via normalize_boundary).
    if identity:
        identity = redact_boundary(identity)
    if evidence is not None:
        evidence = redact_boundary(evidence)
    rid = sha8(text)
    first = text.splitlines()[0].strip()
    ts = now_ts()
    if identity:
        for r in reversed(read_rows()):
            if r[1] != kind:
                continue
            if row_identity(r) == identity and within_window(r[0], window):
                # Re-fire requires the condition to have recurred since
                # the last report: same evidence = a stale condition
                # re-alerting on a timer, suppress with a breadcrumb
                # (2026-09-13 email-send re-fires against a 16:24Z
                # failure).
                if evidence is not None and body_evidence(*r[:3]) == evidence:
                    with body_path(*r[:3]).open("a") as fh:
                        fh.write(redact_boundary(
                            f"- {ts} suppressed duplicate "
                            "(no new evidence)\n"))
                    print(f"report-queue: suppressed duplicate alert "
                          f"{r[2]} (no new evidence since {r[0]})")
                    return 0
                if (cls == "critical"
                        and body_class(*r[:3]) != "critical"):
                    # a critical re-fire never silently bumps a live
                    # non-critical row: file a distinct class-upgrade
                    # row so escalation is visible, not folded in
                    # (2026-09-22-router-alert-class-channel)
                    identity = f"class-upgrade:{identity}"
                    break
                try:
                    bump_row(r, ts)
                    if evidence is not None:
                        set_body_evidence(r[0], r[1], r[2], evidence)
                    return 0
                except (OSError, ValueError) as exc:
                    print(str(exc), file=sys.stderr)
                    return 2
    ensure_header()
    write_body(ts, kind, rid, first, text, identity, evidence,
               redact_text=(kind in PUBLIC_KINDS), cls=cls)
    with REPORTS.open("a") as fh:
        fh.write(f"| {ts} | {kind} | {rid} | {first} | {body_name(ts, kind, rid)} |\n")
    return 0


def newest_first(rows):
    return list(reversed(rows))


def filtered(rows, kind):
    if kind is None:
        return rows
    if kind not in KINDS:
        raise ValueError(f"report-queue: bad kind {kind!r}")
    return [r for r in rows if r[1] == kind]


def cursor_id():
    """The id stord in the cursor file, or None when absent."""
    if not CURSOR.exists():
        return None
    return CURSOR.read_text().strip() or None


def unread_rows(rows):
    """Rows newer than the cursor; every row when the cursor is absent.

    The cursor stores one report id; everything after that id's position
    in file order (newer writes) is unread. An unknown cursor id fails
    open — no report is silently hidden by a stale cursor.
    """
    cid = cursor_id()
    if cid is None:
        return list(rows)
    for i, r in enumerate(rows):
        if r[2] == cid:
            return list(rows[i + 1:])
    return list(rows)


def body_text(ts, kind, rid):
    p = body_path(ts, kind, rid)
    if not p.exists():
        return ""
    return p.read_text()


def mark_read(rid):
    rows = read_rows()
    if rid not in {r[2] for r in rows}:
        raise ValueError(f"report-queue: unknown report id {rid!r}")
    CURSOR.write_text(rid + "\n")


def list_cmd(kind):
    for cells in newest_first(filtered(read_rows(), kind)):
        print("| " + " | ".join(cells) + " |")
    return 0


def unread_cmd(kind):
    for cells in newest_first(filtered(unread_rows(read_rows()), kind)):
        print("| " + " | ".join(cells) + " |")
    return 0


def json_cmd():
    rows = read_rows()
    unread = unread_rows(rows)
    summary = {}
    for r in rows:
        summary[r[1]] = summary.get(r[1], 0) + 1
    reports = [{
        "ts": r[0], "kind": r[1], "id": r[2],
        "first": r[3], "body": body_text(r[0], r[1], r[2]),
    } for r in newest_first(unread)]
    print(json.dumps({
        "generated": now_ts(),
        "reports": reports,
        "unread": len(unread),
        "summary": summary,
    }))
    return 0


def prune_cmd(before, kinds, archive):
    if not before or not kinds:
        print("report-queue: --prune requires --before TS and "
              "--kinds KIND[,KIND...]", file=sys.stderr)
        return 2
    kind_list = [k.strip() for k in kinds.split(",") if k.strip()]
    bad = [k for k in kind_list if k not in KINDS]
    if bad:
        print(f"report-queue: bad kind(s) {'/'.join(bad)} (expected "
              f"{'/'.join(sorted(KINDS))})", file=sys.stderr)
        return 2
    try:
        bt = parse_ts(before)
        if bt > datetime.now(timezone.utc):
            print("report-queue: --before is in the future", file=sys.stderr)
            return 2
        rows = read_rows()
        doomed = [r for r in rows
                  if r[1] in set(kind_list) and r[0] < before]
        if doomed and archive:
            ap = Path(archive)
            ap.parent.mkdir(parents=True, exist_ok=True)
            with ap.open("a") as fh:
                fh.write(f"\n## pruned {before}\n\n{HEADER}\n")
                for r in doomed:
                    fh.write("| " + " | ".join(r) + " |\n")
        bodies = 0
        for r in doomed:
            bp = body_path(*r[:3])
            if bp.exists():
                bp.unlink()
                bodies += 1
        if doomed:
            drop = {tuple(r[:3]) for r in doomed}
            out = []
            for line in REPORTS.read_text().splitlines(keepends=True):
                s = line.strip()
                cells = ([c.strip() for c in s.strip("|").split("|")]
                         if s.startswith("|") and s.endswith("|") else None)
                if cells and len(cells) == 5 and tuple(cells[:3]) in drop:
                    continue
                out.append(line)
            REPORTS.write_text("".join(out))
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"report-queue: {exc}", file=sys.stderr)
        return 2
    tail = f", archived to {archive}" if archive else ""
    print(f"pruned {len(doomed)} rows, {bodies} bodies{tail}")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="report-queue", add_help=False,
        description="append-only report queue (see module docstring)")
    p.add_argument("--help", action="store_true")
    p.add_argument("--add", nargs=2, metavar=("KIND", "TEXT"))
    p.add_argument("--list", nargs="?", const="")
    p.add_argument("--unread", nargs="?", const="")
    p.add_argument("--mark-read", metavar="ID")
    p.add_argument("--json", action="store_true")
    p.add_argument("--identity", metavar="KEY")
    p.add_argument("--evidence", metavar="TOKEN")
    p.add_argument("--window", type=int, metavar="SECONDS")
    p.add_argument("--class", dest="alert_class",
                   choices=("critical", "normal"), metavar="CLASS")
    p.add_argument("--prune", action="store_true")
    p.add_argument("--before", metavar="TS")
    p.add_argument("--kinds", metavar="KIND[,KIND...]")
    p.add_argument("--archive", metavar="PATH")
    args = p.parse_args(argv)
    if args.help:
        print(__doc__.strip())
        return 0
    if args.prune:
        return prune_cmd(args.before, args.kinds, args.archive)
    if args.add:
        return add(args.add[0], args.add[1], args.identity,
                   86400 if args.window is None else args.window,
                   args.evidence, args.alert_class)
    if args.list is not None:
        return list_cmd(args.list or None)
    if args.unread is not None:
        return unread_cmd(args.unread or None)
    if args.mark_read:
        try:
            mark_read(args.mark_read)
            return 0
        except ValueError as exc:
            print(str(exc), file=sys.stderr)
            return 2
    if args.json:
        return json_cmd()
    print("usage: report-queue --add KIND TEXT [--identity KEY] "
          "[--evidence TOKEN] [--window SECONDS] "
          "[--class critical|normal] | --list[=KIND] | "
          "--unread[=KIND] | --json | "
          "--mark-read ID | --prune --before TS --kinds KIND[,KIND...] "
          "[--archive PATH] | --help",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())