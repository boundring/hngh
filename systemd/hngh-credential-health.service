[Unit]
Description=hngh credential health check (hourly token + reviewer probe)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=~/Projects/etc/hngh-automation/jobs/credential-health.sh
WorkingDirectory=~/Projects/etc/hngh-automation
Restart=no

[Install]
WantedBy=multi-user.target
