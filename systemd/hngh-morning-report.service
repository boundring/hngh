[Unit]
Description=hngh-automation morning report session (07:30)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=~/Projects/etc/hngh-automation/scripts/night-session.sh prompts/morning-report.md morning-report
ExecStartPost=~/Projects/etc/hngh-automation/jobs/refresh-dashboard.sh morning-report
WorkingDirectory=~/Projects/etc/hngh-automation
Restart=no
