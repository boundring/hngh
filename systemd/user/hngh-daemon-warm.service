# Hngh M7 Daemon warm-up — oneshot health ping after daemon start
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 boundring <boundring@gmail.com>

[Unit]
Description=Hngh daemon warm-up (health ping)
After=hngh-daemon.service
Requires=hngh-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hngh-client health

[Install]
WantedBy=default.target
