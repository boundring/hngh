#!/bin/bash
# hngh-look-laneprobe — Lane B vision capability probe (cu-stack design §2).
#
# Renders a 256x64 PNG with black "HNGH-VISION-OK 7" on white (ImageMagick
# `convert` if present, else a precomputed valid PNG with the same size —
# transcription will legitimately fail on the fallback, which is itself a
# truthful probe result), sends it to each cloud candidate lane with
# "transcribe the text exactly", and records the result to
# $HNGH_STATE_DIR/look/lanes.json for hngh-look --lane cloud.
#
# One JSON line per lane: {"lane":...,"ok":...,"answer_sha_or_note":...}
# Credential values are sourced from the house env files and NEVER printed.
# Exit 0 always.
set -u

state_dir=${HNGH_STATE_DIR:-$HOME/.local/state/hngh}
env_dir=${HNGH_ENV_DIR:-$HOME/.config/environment.d}
out_dir=$state_dir/look
out_file=$out_dir/lanes.json
mkdir -p "$out_dir" 2>/dev/null

probe_text="HNGH-VISION-OK 7"
probe_png=$(mktemp /tmp/hngh-look-probe-XXXXXX.png)
trap 'rm -f "$probe_png"' EXIT

if command -v convert >/dev/null 2>&1; then
	convert -size 256x64 xc:white -fill black -pointsize 28 -annotate +10+40 "$probe_text" "$probe_png" 2>/dev/null
fi
if [ ! -s "$probe_png" ]; then
	# minimal valid 1x1 white PNG (fallback: probe still tests image acceptance)
	printf 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4//8/AwAI/AL+hc2rNAAAAABJRU5ErkJggg==' | base64 -d > "$probe_png"
	probe_text=""
fi
b64=$(base64 -w0 "$probe_png")

probe_lane() { # probe_lane <provider> <env-file> <key-var> <base-url> <model>
	local provider=$1 env_file=$2 key_var=$3 base=$4 model=$5 key answer
	[ -f "$env_file" ] || { printf '{"lane":"%s","ok":false,"answer_sha_or_note":"no credential file"}\n' "$provider"; return; }
	key=$(set -a; . "$env_file"; eval "printf '%s' \"\$$key_var\"")
	if [ -z "$key" ]; then
		printf '{"lane":"%s","ok":false,"answer_sha_or_note":"%s empty"}\n' "$provider" "$key_var"
		return
	fi
	local payload
	# base64 via a temp file: a real capture's payload exceeds ARG_MAX in argv
	b64_file=$(mktemp /tmp/hngh-look-probe-b64-XXXXXX)
	printf '%s' "$b64" > "$b64_file"
	# MITM-whitelisted upstreams are reachable only through the bili proxy
	local proxy_args=()
	case "$base" in
		*api.z.ai*|*api.minimax.io*)
			bili_port=$(jq -r '.lanes.omp // empty' "$HOME/.local/state/billion-context/port-zone.json" 2>/dev/null)
			[ -n "$bili_port" ] && proxy_args=(--proxy "http://127.0.0.1:$bili_port" -k)
			;;
	esac
	payload=$(python3 - "$b64_file" "$model" <<'PY'
import json, sys
b64 = open(sys.argv[1]).read()
print(json.dumps({
    "model": sys.argv[2],
    "max_tokens": 3000,
    "messages": [{
        "role": "user",
        "content": [
            {"type": "image_url", "image_url": {"url": "data:image/png;base64," + b64}},
            {"type": "text", "text": "transcribe the text exactly"},
        ],
    }],
}))
PY
) || payload=
	rm -f "$b64_file"
	local body_file status
	body_file=$(mktemp /tmp/hngh-look-body-XXXXXX)
	payload_file=$(mktemp /tmp/hngh-look-payload-XXXXXX)
	printf '%s' "$payload" > "$payload_file"
	status=$(curl -sS --max-time 60 -o "$body_file" -w '%{http_code}' \
		-H "Authorization: Bearer $key" -H 'Content-Type: application/json' \
		"${proxy_args[@]}" --data-binary "@$payload_file" "$base/chat/completions" 2>/dev/null)
	rm -f "$payload_file"
	answer=$(python3 -c 'import json,sys
try:
    d = json.load(open(sys.argv[1]))
    print(d["choices"][0]["message"]["content"].strip())
except Exception:
    pass' "$body_file")
	if [ -z "$answer" ]; then
		if [ "${status:-000}" = "000" ]; then
			# no route from this host: those upstreams are reached only through the
			# billion-context MITM lane, so a direct probe cannot test them.
			printf '{"lane":"%s","ok":false,"answer_sha_or_note":"unreachable directly (bili-routed upstream; not probeable)"}\n' "$provider"
		else
			printf '{"lane":"%s","ok":false,"answer_sha_or_note":"http %s: %s"}\n' "$provider" "${status:-000}" \
				"$(head -c 160 "$body_file" | tr -d '\n' | sed 's/[A-Za-z0-9_-]\{24,\}/<redacted>/g')"
		fi
		rm -f "$body_file"
		return
	elif [ -n "$probe_text" ] && printf '%s' "$answer" | grep -q 'HNGH-VISION-OK *7'; then
		printf '{"lane":"%s","ok":true,"answer_sha_or_note":"%s"}\n' "$provider" "$(printf '%s' "$answer" | sha256sum | cut -c1-16)"
	elif [ -n "$probe_text" ]; then
		printf '{"lane":"%s","ok":false,"answer_sha_or_note":"VISION-WEAK (wrong transcription, %s bytes)"}\n' "$provider" "${#answer}"
	else
		# fallback image carries no text: accept = image content block accepted
		printf '{"lane":"%s","ok":true,"answer_sha_or_note":"fallback 1x1 png, image accepted"}\n' "$provider"
	fi
	rm -f "$body_file"
}

line_zai=$(probe_lane zai "$env_dir/84-zai.conf" ZAI_API_KEY \
	"https://api.z.ai/api/coding/paas/v4" "glm-5.3-flash")
line_minimax=$(probe_lane minimax "$env_dir/80-minimax.conf" MINIMAX_API_KEY \
	"https://api.minimax.io/v1" "MiniMax-M3.1-Flash-Preview")
line_gemini=$(probe_lane gemini "$env_dir/82-gemini.conf" GEMINI_API_KEY \
	"https://generativelanguage.googleapis.com/v1beta/openai" "gemini-3.8-flash")

printf '%s\n%s\n%s\n' "$line_zai" "$line_minimax" "$line_gemini"

python3 - "$out_file" "$line_zai" "$line_minimax" "$line_gemini" <<'PY'
import json, sys
lanes = {}
for line in sys.argv[2:]:
    try:
        d = json.loads(line)
        info = {
            "zai": ("glm-5.3-flash", "https://api.z.ai/api/coding/paas/v4"),
            "minimax": ("MiniMax-M3.1-Flash-Preview", "https://api.minimax.io/v1"),
            "gemini": ("gemini-3.8-flash", "https://generativelanguage.googleapis.com/v1beta/openai"),
        }[d["lane"]]
        lanes[d["lane"]] = {"ok": d["ok"], "model": info[0], "baseUrl": info[1]}
    except Exception:
        pass
try:
    prev = json.load(open(sys.argv[1]))
except Exception:
    prev = {}
prev.setdefault("lanes", {}).update(lanes)
prev["checked"] = prev.get("checked", {})
import datetime
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
for k in lanes:
    prev["checked"][k] = now
json.dump(prev, open(sys.argv[1], "w"), indent=1)
PY
exit 0
