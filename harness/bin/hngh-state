#!/bin/bash

# hngh-state — Hngh state store (Silent to write its OWN flags only).
# Shape follows /usr/share/omarchy/bin/omarchy-state; flag dir mirrors the
# Omarchy convention: ~/.local/state/hngh/ (toggles/, consent/, one file per fact).
#
# Second face: a GENERATOR of Lua modules consumable by Hyprland's config.
# Hyprland's bootstrap.lua puts ~/.local/state/?.lua FIRST on package.path, so a
# generated ~/.local/state/hngh/<x>.lua is directly require("hngh.<x>")-able —
# config-time state with no IPC.

set -u

# Overridable so self-checks sandbox their flags (mirrors hngh-act).
STATE_DIR="${HNGH_STATE_DIR:-$HOME/.local/state/hngh}"
mkdir -p "$STATE_DIR"

cmd="${1:-}"

case "$cmd" in
  set)
    mkdir -p "$(dirname "$STATE_DIR/$2")"; touch "$STATE_DIR/$2" ;;
  clear)
    find "$STATE_DIR" -maxdepth 3 -type f -name "${2##*/}" -path "*${2%/*}*" -delete 2>/dev/null \
      || find "$STATE_DIR" -maxdepth 1 -type f -name "$2" -delete ;;
  test)
    [[ -e "$STATE_DIR/$2" ]] ;;
  toggle)
    if [[ -e "$STATE_DIR/$2" ]]; then rm -f "$STATE_DIR/$2"; echo "cleared $2"; else mkdir -p "$(dirname "$STATE_DIR/$2")"; touch "$STATE_DIR/$2"; echo "set $2"; fi ;;
  generate)
    # Idempotent regeneration of hngh/posture.lua from hngh-act posture.refresh's
    # stored blob. Header names the generator, per design contract.
    blob="$STATE_DIR/posture.json"
    if [[ ! -s $blob ]]; then echo "no posture blob yet; run: hngh-act posture.refresh" >&2; exit 1; fi
    # One level only: require("hngh.posture") resolves to
    # ~/.local/state/hngh/posture.lua via bootstrap's ~/.local/state/?.lua
    # (the extra hngh/ level broke the require — Hyprland banner 2026-10-21).
    lua="$STATE_DIR/posture.lua"
    jq -r '. as $root |
      "local posture = {\n" +
      (["generated_at", "theme", "network", "session_locked", "updates", "system_stats"]
        | map(. as $k | "  [\($k|tojson)] = \(if $root[$k] == null then "nil" else ($root[$k]|tojson) end),")
        | join("\n")) + "\n" +
      "  [\"monitor_count\"] = \(if .hyprland_monitors == null then "nil" else (.hyprland_monitors|length) end),\n" +
      "  [\"client_count\"] = \(if .hyprland_clients == null then "nil" else (.hyprland_clients|length) end),\n" +
      "}\n" +
      "return posture"' "$blob" > "$lua.tmp" \
    && { printf -- '-- Generated by hngh-state generate. Do not edit by hand.\n-- Regenerate with: hngh-act posture.refresh\n' > "$lua"; cat "$lua.tmp" >> "$lua"; rm -f "$lua.tmp"; }
    echo "wrote $lua"
    ;;
  *)
    echo "Usage: hngh-state <set|clear|test|toggle> <flag-path> | hngh-state generate"
    exit 1
    ;;
esac
