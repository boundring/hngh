#!/usr/bin/env python3
"""hngh-digest-moved — "what moved in words" over the portfolio state.

Folds two sibling readers (invoked via PATH, so sandbox selfchecks stub them):
  hngh-digest-rollup --last <days+1> --json  -> per-day movement deltas
  hngh-sessions --json                       -> milestone events in the window
Text output capped at 12 lines. Reporting tool: always exits 0; an unavailable
or malformed source degrades to `(unavailable)`, never a traceback.
"""

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone

MILESTONE_EVENTS = ("deliverable", "blocked", "awaiting_gate", "done", "aborted")
FIELDS = ("sessions", "agents", "active_agents")
MAX_LINES = 12
MAX_MILESTONES = 6


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="hngh-digest-moved",
        description="What moved in words: daily movement + session milestones (read-only).",
    )
    p.add_argument("--days", type=int, default=1, metavar="N",
                   help="window in days (default 1)")
    p.add_argument("--since", metavar="ISO", default=None,
                   help="passed to hngh-digest-rollup: only days whose last record is at or after this UTC stamp")
    p.add_argument("--json", action="store_true", help="emit {at, window, movement, milestones}")
    try:
        return p.parse_args(argv)
    except SystemExit:
        raise SystemExit(0)  # reporting tool: bad flags reported, never a failing exit


def run_json(cmd):
    """Run a sibling reader, parse its JSON array; None on any failure."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        data = json.loads(out.stdout)
    except Exception:
        return None
    return data if isinstance(data, list) else None


def movement_rows(days, since):
    """Per-day movement, newest first. With a multi-day window, zero-delta
    days are dropped first (unless every day is flat) so the newest `days`
    moving days survive the truncation."""
    rows = run_json(["hngh-digest-rollup", "--last", str(days + 1), "--json"])
    if rows is None:
        return None
    kept = [r for r in rows
            if isinstance(r, dict)
            and isinstance(r.get("day"), str)
            and isinstance(r.get("delta"), dict)
            and all(isinstance(r["delta"].get(f), int) for f in FIELDS)
            and (since is None or str(r.get("last", {}).get("at", "")) >= since)]
    kept.sort(key=lambda r: r["day"], reverse=True)
    if days > 1:
        nonzero = [r for r in kept if any(r["delta"][f] for f in FIELDS)]
        if nonzero:
            kept = nonzero
    return kept[:days]


def milestone_rows(days):
    rows = run_json(["hngh-sessions", "--json"])
    if rows is None:
        return None
    max_age = 24 * 60 * days
    hits = []
    for r in rows:
        if not isinstance(r, dict):
            continue
        if r.get("event") not in MILESTONE_EVENTS:
            continue
        age = r.get("age_minutes")
        if not isinstance(age, (int, float)) or age > max_age:
            continue
        hits.append({"session": str(r.get("session", "?")),
                     "event": r["event"],
                     "age_minutes": age})
    hits.sort(key=lambda r: r["age_minutes"])
    return hits[:MAX_MILESTONES]


def main(argv):
    args = parse_args(argv)
    days = args.days if args.days and args.days > 0 else 1
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    mv = movement_rows(days, args.since)
    ms = milestone_rows(days)

    if args.json:
        print(json.dumps({
            "at": now,
            "window": days,
            "movement": mv if mv is not None else [],
            "milestones": ms if ms is not None else [],
        }, indent=1))
        return 0

    lines = [f"hngh moved @ {now} window={days}d"]
    lines.append("MOVEMENT")
    if mv is None:
        lines.append("  (unavailable)")
    else:
        # keep the whole report within MAX_LINES: header + 2 section headers
        # + milestones (or the `none` line) are fixed overhead
        overhead = 4 + min(len(ms) if ms else 0, MAX_MILESTONES)
        budget = max(1, MAX_LINES - overhead)
        if not mv:
            lines.append("  no change")
        for r in mv[:budget]:
            d = r["delta"]
            lines.append(f"  {r['day']}: sessions {d['sessions']:+d}, "
                         f"agents {d['agents']:+d}, active {d['active_agents']:+d}")
    lines.append("MILESTONES")
    if ms is None:
        lines.append("  (unavailable)")
    elif not ms:
        lines.append("  none")
    else:
        for m in ms:
            lines.append(f"  {m['session']} {m['event']}")
    print("\n".join(lines[:MAX_LINES] if len(lines) > MAX_LINES else lines))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except BrokenPipeError:
        sys.exit(0)
    except Exception as e:  # reporting tool: degrade, never fail
        print(f"warning: {e}", file=sys.stderr)
        sys.exit(0)
