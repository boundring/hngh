#!/usr/bin/env bash
# hngh-digest-note-selfcheck — sandboxed checks for the digest ledger writer.
# The ledger lives in a temp dir (HNGH_DIGESTS_DIR, or a sandboxed HOME for the
# default path); the real ~/.local/state/hngh/digests is never touched.
set -u

selfcheck_dir=/home/bricker/Projects/hngh/bin
tool="$selfcheck_dir/hngh-digest-note"
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT
failures=0

check() {
	if [ "$2" = 0 ]; then
		echo "ok: $1"
	else
		echo "FAIL: $1" >&2
		failures=$((failures + 1))
	fi
}

export HNGH_DIGESTS_DIR="$sandbox/digests"
mkdir -p "$HNGH_DIGESTS_DIR"
ledger="$HNGH_DIGESTS_DIR/digests.jsonl"

# ---- 1. happy path: one row lands in the ledger -----------------------------
out=$(bash "$tool" --sessions 3 --agents 5 --active-agents 2 2>&1); rc=$?
[ $rc -eq 0 ] &&
	[ "$(wc -l < "$ledger")" = 1 ] &&
	printf '%s' "$out" | jq -e '.sessions == 3 and .agents == 5 and .active_agents == 2' >/dev/null &&
	grep -q '"active_agents":2' "$ledger"
check "a digest is stored as one JSON row and echoed on stdout" $?

# ---- 2. the row carries the server stamp -----------------------------------
jq -r '.at' "$ledger" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
check "the row carries a server-side UTC stamp" $?

# ---- 3. the optional summary is omitted when absent -------------------------
jq -e 'has("summary") | not' "$ledger" >/dev/null
check "an absent summary is omitted from the row" $?

# ---- 4. a supplied summary is stored ---------------------------------------
bash "$tool" --sessions 1 --agents 1 --active-agents 0 --summary '2 sessions, 3 agents, 1 active' >/dev/null
jq -e 'select(.summary == "2 sessions, 3 agents, 1 active")' "$ledger" >/dev/null
check "a supplied summary is stored" $?

# ---- 5. a missing required argument -> usage, exit 2 -----------------------
out=$(bash "$tool" --sessions 1 --agents 1 2>&1); rc=$?
[ $rc -eq 2 ] && printf '%s' "$out" | grep -q 'usage:'
check "a missing --active-agents is refused (exit 2, usage)" $?

# ---- 6. an unknown flag is refused -----------------------------------------
out=$(bash "$tool" --bogus 1 2>&1); rc=$?
[ $rc -eq 2 ] && printf '%s' "$out" | grep -q 'usage:'
check "an unknown flag is refused (exit 2, usage)" $?

# ---- 7. non-integer counts are rejected ------------------------------------
out=$(bash "$tool" --sessions x --agents 1 --active-agents 0 2>&1); rc=$?
[ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'must be integers'
check "a non-integer --sessions is rejected (exit 1)" $?

# ---- 8. state isolation: the default path follows a sandboxed HOME ---------
before=$(wc -l < "$ledger")
env -u HNGH_DIGESTS_DIR HOME="$sandbox/home" bash "$tool" --sessions 1 --agents 1 --active-agents 1 >/dev/null
[ -f "$sandbox/home/.local/state/hngh/digests/digests.jsonl" ] &&
	[ "$(wc -l < "$ledger")" = "$before" ]
check "with no override the row lands under the sandboxed HOME, not the override dir" $?

if [ $failures = 0 ]; then
	echo "SELF-CHECK GREEN"
	exit 0
fi
echo "SELF-CHECK FAILED ($failures)" >&2
exit 1
