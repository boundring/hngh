#!/usr/bin/env bash
# hngh-state-selfcheck — sandboxed checks for the hngh state store.
# Every flag lives under HNGH_STATE_DIR (a temp dir), so the real
# ~/.local/state/hngh flag tree is never touched.
set -u

selfcheck_dir=/home/bricker/Projects/hngh/bin
tool="$selfcheck_dir/hngh-state"
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT
failures=0

check() {
	if [ "$2" = 0 ]; then
		echo "ok: $1"
	else
		echo "FAIL: $1" >&2
		failures=$((failures + 1))
	fi
}

export HNGH_STATE_DIR="$sandbox/state"
mkdir -p "$HNGH_STATE_DIR"

# ---- 1. set creates the flag file ------------------------------------------
bash "$tool" set toggles/demo >/dev/null
[ -f "$HNGH_STATE_DIR/toggles/demo" ]
check "set creates the flag file under the state dir" $?

# ---- 2. test finds a set flag ----------------------------------------------
bash "$tool" test toggles/demo
check "test on a set flag exits 0" $?

# ---- 3. test on a missing flag exits nonzero --------------------------------
bash "$tool" test toggles/absent 2>/dev/null
[ $? -ne 0 ]
check "test on a missing flag exits nonzero" $?

# ---- 4. toggle sets then clears, saying which it did ------------------------
rm -f "$HNGH_STATE_DIR/toggles/demo"
out=$(bash "$tool" toggle toggles/demo)
[ "$out" = "set toggles/demo" ] && [ -f "$HNGH_STATE_DIR/toggles/demo" ]
check "toggle on an unset flag reports 'set' and creates it" $?

out=$(bash "$tool" toggle toggles/demo)
[ "$out" = "cleared toggles/demo" ] && [ ! -e "$HNGH_STATE_DIR/toggles/demo" ]
check "toggle on a set flag reports 'cleared' and removes it" $?

# ---- 5. clear removes a set flag -------------------------------------------
bash "$tool" set toggles/gone >/dev/null
bash "$tool" clear toggles/gone
[ ! -e "$HNGH_STATE_DIR/toggles/gone" ]
check "clear removes the named flag" $?

# ---- 6. an unknown command is refused --------------------------------------
out=$(bash "$tool" frobnicate 2>&1); rc=$?
[ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'Usage: hngh-state'
check "an unknown command is refused (exit 1, usage)" $?

# ---- 7. generate without a posture blob fails loudly ------------------------
out=$(bash "$tool" generate 2>&1); rc=$?
[ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'no posture blob yet'
check "generate without a posture blob fails loudly (exit 1)" $?

# ---- 8. generate writes a Lua module from the blob --------------------------
cat > "$HNGH_STATE_DIR/posture.json" <<'JSON'
{"generated_at":"2026-11-01T00:00:00Z","theme":"tokyonight","network":"wifi","session_locked":false,
 "updates":{"count":2},"system_stats":{"cpu":3},
 "hyprland_monitors":[{"name":"eDP-1"}],"hyprland_clients":[{"addr":"0x1"}]}
JSON
out=$(bash "$tool" generate 2>&1); rc=$?
[ $rc -eq 0 ] && printf '%s' "$out" | grep -q "wrote $HNGH_STATE_DIR/posture.lua" &&
	grep -q 'return posture' "$HNGH_STATE_DIR/posture.lua" &&
	grep -q 'Generated by hngh-state generate' "$HNGH_STATE_DIR/posture.lua" &&
	grep -q 'tokyonight' "$HNGH_STATE_DIR/posture.lua" &&
	grep -q 'monitor_count' "$HNGH_STATE_DIR/posture.lua"
check "generate writes a posture.lua module from the stored blob" $?

# ---- 9. state isolation: the real flag tree is untouched --------------------
realhome="$HOME"
env -u HNGH_STATE_DIR HOME="$sandbox/realhome" bash "$tool" set toggles/selftest-probe >/dev/null
[ ! -e "$realhome/.local/state/hngh/toggles/selftest-probe" ]
[ -f "$sandbox/realhome/.local/state/hngh/toggles/selftest-probe" ]
check "with no override the flag lands under the sandboxed HOME, not the real tree" $?

if [ $failures = 0 ]; then
	echo "SELF-CHECK GREEN"
	exit 0
fi
echo "SELF-CHECK FAILED ($failures)" >&2
exit 1
