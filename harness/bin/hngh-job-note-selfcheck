#!/usr/bin/env bash
# hngh-job-note-selfcheck — sandboxed checks for the job ledger writer.
# The registry lives in a temp dir (HNGH_JOBS_DIR, or a sandboxed HOME for the
# default path); the real ~/.local/state/hngh/jobs is never touched.
set -u

selfcheck_dir=/home/bricker/Projects/hngh/bin
tool="$selfcheck_dir/hngh-job-note"
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT
failures=0

check() {
	if [ "$2" = 0 ]; then
		echo "ok: $1"
	else
		echo "FAIL: $1" >&2
		failures=$((failures + 1))
	fi
}

export HNGH_JOBS_DIR="$sandbox/jobs"
mkdir -p "$HNGH_JOBS_DIR"
ledger="$HNGH_JOBS_DIR/jobs.jsonl"

# ---- 1. happy path: one row lands in the registry ---------------------------
out=$(bash "$tool" --job job-7 --event started 2>&1); rc=$?
[ $rc -eq 0 ] &&
	[ "$(wc -l < "$ledger")" = 1 ] &&
	printf '%s' "$out" | jq -e '.job == "job-7" and .event == "started"' >/dev/null &&
	grep -q '"job":"job-7"' "$ledger"
check "a job event is stored as one JSON row and echoed on stdout" $?

# ---- 2. the row carries the server stamp -----------------------------------
jq -r '.at' "$ledger" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
check "the row carries a server-side UTC stamp" $?

# ---- 3. optional fields are omitted when absent -----------------------------
jq -e 'has("outcome") | not' "$ledger" >/dev/null &&
	jq -e 'has("tier") | not' "$ledger" >/dev/null
check "absent optional fields are omitted from the row" $?

# ---- 4. supplied optional fields are stored ---------------------------------
bash "$tool" --job job-8 --event outcome --outcome shipped --tier T1 --source plan >/dev/null
jq -e 'select(.job == "job-8") | .outcome == "shipped" and .tier == "T1" and .source == "plan"' "$ledger" >/dev/null
check "outcome, tier and source are stored when given" $?

# ---- 5. a missing required argument -> usage, exit 2 -----------------------
out=$(bash "$tool" --job job-7 2>&1); rc=$?
[ $rc -eq 2 ] && printf '%s' "$out" | grep -q 'usage:'
check "a missing --event is refused (exit 2, usage)" $?

# ---- 6. an unknown flag is refused -----------------------------------------
out=$(bash "$tool" --bogus 1 2>&1); rc=$?
[ $rc -eq 2 ] && printf '%s' "$out" | grep -q 'usage:'
check "an unknown flag is refused (exit 2, usage)" $?

# ---- 7. an unknown event is rejected ---------------------------------------
out=$(bash "$tool" --job j --event bogus 2>&1); rc=$?
[ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'must be started, gate or outcome'
check "an unknown --event is rejected (exit 1)" $?

# ---- 8. state isolation: the default path follows a sandboxed HOME ---------
before=$(wc -l < "$ledger")
env -u HNGH_JOBS_DIR HOME="$sandbox/home" bash "$tool" --job j --event gate >/dev/null
[ -f "$sandbox/home/.local/state/hngh/jobs/jobs.jsonl" ] &&
	[ "$(wc -l < "$ledger")" = "$before" ]
check "with no override the row lands under the sandboxed HOME, not the override dir" $?

if [ $failures = 0 ]; then
	echo "SELF-CHECK GREEN"
	exit 0
fi
echo "SELF-CHECK FAILED ($failures)" >&2
exit 1
