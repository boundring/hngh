#!/bin/bash
# hngh-fill-selfcheck — sandboxed checks for the local-fill runner.
# Everything is sandboxed: the queue root is overridden via HNGH_FILL_DIR, the
# credential file via HNGH_ENV_DIR, and `curl` is a STUB on PATH — no model call
# ever leaves the box and the real queue is never touched.
set -u

selfcheck_dir=/home/bricker/Projects/hngh/bin
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT
failures=0

export HNGH_FILL_DIR="$sandbox/queue"
export HNGH_ENV_DIR="$sandbox/env"
export STUB_STATE="$sandbox/stub"
# The VRAM gate runs before every preload: sandbox its inputs so this
# selfcheck never reads the real card and never depends on the real budget.
export HNGH_VRAM_FILE="$sandbox/vram_used"
export HNGH_VRAM_BUDGET=100000000000
printf '0\n' > "$sandbox/vram_used"
# A fake HOME: the VRAM gate's fallback estimate looks the model's GGUF up in
# the HF cache, so give it a tiny local one instead of the real 10 GB file.
export HOME="$sandbox/home"
mkdir -p "$HOME/.cache/huggingface/hub/models--unsloth--NVIDIA-Nemotron-3.5-Bolt-E4B-GGUF/snapshots/x"
head -c 4096 /dev/zero > "$HOME/.cache/huggingface/hub/models--unsloth--NVIDIA-Nemotron-3.5-Bolt-E4B-GGUF/snapshots/x/model.gguf"
mkdir -p "$HNGH_ENV_DIR" "$STUB_STATE/calls" "$sandbox/bin"

check() {
	if [ "$2" = 0 ]; then
		echo "ok: $1"
	else
		echo "FAIL: $1" >&2
		failures=$((failures + 1))
	fi
}

fill="$selfcheck_dir/hngh-fill"
FAKE_KEY='sk-local-stub-key-DO-NOT-LEAK-0123456789'
printf 'UNSLOTH_API_KEY=%s\n' "$FAKE_KEY" > "$HNGH_ENV_DIR/70-unsloth.conf"

# ---- stub curl: per-fixture canned answers, records every request body -------
cat > "$sandbox/bin/curl" <<'STUB'
#!/bin/bash
# stub curl — never talks to a network. Records request bodies under $STUB_STATE.
set -u
out=""; data=""; url=""
while [ $# -gt 0 ]; do
	case "$1" in
		-o) out=${2-}; shift 2 ;;
		-w) shift 2 ;;
		-H) shift 2 ;;
		--max-time) shift 2 ;;
		-d) data=${2-}; shift 2 ;;
		--data-binary) data=${2-}; shift 2 ;;
		*) url=$1; shift ;;
	esac
done
case "$url" in
	*estimate-memory)
		# the VRAM gate asks the studio to price a prospective load
		printf '{"available": true, "reason": null, "gpu_bytes": 1000000000, "total_bytes": 1000000000}'
		exit 0 ;;
	*loaded-models)
		printf '{"object": "list", "data": []}'
		exit 0 ;;
	*/api/inference/load)
		# the fill's preload. $STUB_STATE/load409 names the resident model
		# the studio refuses to evict; the first load is answered 409.
		if [ -f "$STUB_STATE/load409" ]; then
			n=$(cat "$STUB_STATE/load409.count" 2>/dev/null || echo 0)
			n=$((n + 1)); printf '%s' "$n" > "$STUB_STATE/load409.count"
			if [ -f "$STUB_STATE/load409_always" ] || [ "$n" = 1 ]; then
				printf '{"detail":"Loading this model would unload the chat model %s, and Keep multiple models loaded is set to Always. Unload that model first, or choose When they fit."}' "$(cat "$STUB_STATE/load409")" > "$out"
				printf '409'
				exit 0
			fi
		fi
		printf '{"status":"loaded"}' > "$out"
		printf '200'
		exit 0 ;;
	*/api/inference/unload)
		n=$(cat "$STUB_STATE/unload.count" 2>/dev/null || echo 0)
		n=$((n + 1)); printf '%s' "$n" > "$STUB_STATE/unload.count"
		printf '%s' "$data" > "$STUB_STATE/unload.$n.body"
		printf '{"status":"unloaded"}' > "$out"
		printf '200'
		exit 0 ;;
esac
body=${data#@}
[ -f "$body" ] || body=""
if [ -f "$STUB_STATE/down" ]; then
	printf '000'
	exit 7
fi
if [ -z "$body" ]; then   # preflight probe (no request body): up, but not a model call
	printf '200'
	exit 0
fi
marker=$(grep -o 'FIXTURE:[A-Z]*' "$body" 2>/dev/null | head -1 | cut -d: -f2)
[ -n "$marker" ] || marker=GREEN
count_file="$STUB_STATE/count.$marker"
n=$(cat "$count_file" 2>/dev/null || echo 0)
n=$((n + 1)); printf '%s' "$n" > "$count_file"
cp "$body" "$STUB_STATE/calls/$marker.$n.body" 2>/dev/null

emit() { # emit <content>
	printf '{"choices":[{"message":{"content":%s}}]}' "$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1")" > "$out"
	printf '200'
}

case "$marker" in
GREEN) emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,2 @@
 original
+FIXED' ;;
RETRY)
	if [ "$n" = 1 ]; then
		emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,2 @@
 original
+WRONG'
	else
		emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,2 @@
 original
+FIXED'
	fi ;;
RED) emit 'I am sorry, I cannot produce that patch.' ;;
LADDER)
	# the escalation coder is handed the same SPEC but must answer
	# differently: the ladder is only proved when rung 1 is red and
	# rung 2 is green.
	if grep -q 'Qwen-AgentWorld-35B' "$body"; then
		emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,2 @@
 original
+FIXED'
	else
		emit 'I am sorry, I cannot produce that patch.'
	fi ;;
DOWN) printf '000'; exit 7 ;;
BITE) emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,2 @@
 original
+FIXED' ;;
GROWTH)
	if [ "$n" = 1 ]; then
		emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,2 @@
 original
+WRONG'
	else
		emit '--- hello.txt
+++ hello.txt
@@ -1,1 +1,3 @@
 original
+WRONG
+AND_MUCH_MORE_LONG_LINE_TO_TRIPLE_THE_DIFF_SIZE_FOR_THE_GROWTH_DETECTOR'
	fi ;;
LANG) emit '--- script.sh
+++ script.sh
@@ -1,2 +1,3 @@
 #!/bin/bash
 echo hi
+import os' ;;
PATHFENCE) emit '```bash
#!/bin/bash
echo FIXED
```' ;;
PATHBAD) emit '--- hngh-artifact
+++ hngh-artifact
@@ -1,1 +1,2 @@
-NOTTHERE
+ALSO_NOPE' ;;
PATHLABEL) emit '```src/core/hello.txt
original
FIXED
```' ;;
PATHHEAD) emit 'src/core/hello.txt
#!/bin/bash
echo FIXED' ;;
*) emit 'no diff' ;;
esac
STUB
chmod +x "$sandbox/bin/curl"
export PATH="$sandbox/bin:$PATH"

# ---- fixtures ---------------------------------------------------------------
mk_item() { # mk_item <id> <marker> <test-body>
	local id=$1 marker=$2 body=$3
	local d="$HNGH_FILL_DIR/queued/$id"
	mkdir -p "$d/tests" "$d/workdir"
	printf '# spec for %s\nFIXTURE:%s\n' "$id" "$marker" > "$d/SPEC.md"
	printf 'assert FIXED present in hello.txt\n' > "$d/tests/test_spec.txt"
	printf 'original\n' > "$d/workdir/hello.txt"
	printf '%s\n' "$body" > "$d/workdir/test.sh"
	printf '{"id":"%s","test_cmd":"bash test.sh","workdir_rel":"workdir"}\n' "$id" > "$d/item.json"
}

mk_item green-item GREEN 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
mk_item red-item RED 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
mk_item retry-item RETRY 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'

# ---- 1. drain: green fills, red escalates -----------------------------------
out=$(bash "$fill" drain --attempts 2 2>&1)
rc=$?
[ $rc = 0 ] && [ -d "$HNGH_FILL_DIR/filled/green-item" ] && [ ! -d "$HNGH_FILL_DIR/queued/green-item" ]
check "drain exits 0 and moves the green item to filled/" $?

[ -f "$HNGH_FILL_DIR/filled/green-item/result.json" ] &&
	python3 -c '
import json,sys
r=json.load(open(sys.argv[1]))
assert r["status"]=="filled", r
assert r["attempts"]==1, r
assert r["id"]=="green-item", r' "$HNGH_FILL_DIR/filled/green-item/result.json"
check "filled item has result.json with status=filled and attempts=1" $?

grep -q FIXED "$HNGH_FILL_DIR/filled/green-item/workdir/hello.txt"
check "the patch was applied into workdir/" $?

[ -d "$HNGH_FILL_DIR/escalate/red-item" ] && [ ! -d "$HNGH_FILL_DIR/queued/red-item" ]
check "the red item moves to escalate/" $?

python3 -c '
import json,sys
r=json.load(open(sys.argv[1]))
assert r["status"]=="escalated", r
assert r["attempts"]==2, r' "$HNGH_FILL_DIR/escalate/red-item/result.json"
check "escalated item has result.json with status=escalated and attempts=N" $?

# ---- 2. the second prompt carries the failing output -------------------------
[ -f "$STUB_STATE/calls/RED.2.body" ] &&
	grep -q 'no unified diff in model reply' "$STUB_STATE/calls/RED.2.body"
check "second prompt for the red item includes the failing output" $?

[ -f "$STUB_STATE/calls/RETRY.2.body" ] &&
	grep -q 'expected FIXED' "$STUB_STATE/calls/RETRY.2.body"
check "second prompt for the retry item includes the real failing test output" $?

[ -d "$HNGH_FILL_DIR/filled/retry-item" ]
check "the retry item is filled once the second prompt fixes it" $?

# ---- 3. status shows every state -------------------------------------------
st=$(bash "$fill" status 2>&1)
printf '%s' "$st" | grep -q 'green-item filled' &&
	printf '%s' "$st" | grep -q 'red-item escalate' &&
	printf '%s' "$st" | grep -q 'retry-item filled'
check "status lists filled and escalated items" $?

# ---- 4. log.jsonl records the transitions -----------------------------------
python3 -c '
import json,sys
rows=[json.loads(l) for l in open(sys.argv[1]) if l.strip()]
pairs={(r["id"], r["from"], r["to"]) for r in rows}
assert ("green-item","queued","filled") in pairs, pairs
assert ("red-item","queued","escalate") in pairs, pairs
for r in rows:
    for k in ("at","id","from","to","attempts","note"):
        assert k in r, (k, r)' "$HNGH_FILL_DIR/log.jsonl"
check "log.jsonl records transitions with the required fields" $?

# ---- 5. server down moves nothing ------------------------------------------
export HNGH_FILL_DIR="$sandbox/queue_down"
mkdir -p "$HNGH_FILL_DIR"
mk_item down-item DOWN 'grep -q FIXED hello.txt && echo PASS || exit 1'
touch "$STUB_STATE/down"
down_out=$(bash "$fill" drain 2>&1)
down_rc=$?
[ $down_rc != 0 ] && [ -d "$HNGH_FILL_DIR/queued/down-item" ] &&
	[ ! -d "$HNGH_FILL_DIR/filled/down-item" ] && [ ! -d "$HNGH_FILL_DIR/escalate/down-item" ]
check "server down: nonzero exit and no item moved" $?

[ ! -f "$STUB_STATE/calls/DOWN.1.body" ]
check "server down: the model was never called" $?

rm -f "$STUB_STATE/down"

printf '%s' "$down_out" | grep -qi 'server down'
check "server down: the failure is reported" $?

export HNGH_FILL_DIR="$sandbox/queue"

# ---- 6. reset returns an escalated item to the queue -------------------------
out=$(bash "$fill" reset red-item 2>&1)
rc=$?
[ $rc = 0 ] && [ -d "$HNGH_FILL_DIR/queued/red-item" ] && [ ! -d "$HNGH_FILL_DIR/escalate/red-item" ]
check "reset moves an escalated item back to queued/" $?

# ---- 7. unknown subcommand --------------------------------------------------
bash "$fill" bogus > "$sandbox/bogus.out" 2>&1
rc=$?
[ $rc != 0 ] && grep -qi 'unknown subcommand' "$sandbox/bogus.out"
check "unknown subcommand is refused with a message" $?

# ---- 8. no credential material in any output ---------------------------------
leak=0
for f in "$sandbox/bogus.out"; do grep -q "$FAKE_KEY" "$f" && leak=1; done
printf '%s' "$out" "$st" "$down_out" | grep -q "$FAKE_KEY" && leak=1
[ $leak = 0 ]
check "no output contains the API key" $?

# ---- 9. guards: tests-bite, growth-stop, language lint ------------------------
# a separate queue so the fixtures above keep their results
export HNGH_FILL_DIR="$sandbox/queue_guards"
mkdir -p "$HNGH_FILL_DIR"
mk_item bite-item BITE 'echo PASS'          # passes on the pre-fill state too
mk_item growth-item GROWTH 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
# the language-lint item owns a shell script the model must not patch with python
d="$HNGH_FILL_DIR/queued/lang-item"
mkdir -p "$d/tests" "$d/workdir"
printf '# spec for lang-item\nFIXTURE:LANG\n' > "$d/SPEC.md"
printf 'assert the script still runs\n' > "$d/tests/test_spec.txt"
printf '#!/bin/bash\necho hi\n' > "$d/workdir/script.sh"
printf 'grep -q hi script.sh || exit 1\n' > "$d/workdir/test.sh"
printf '{"id":"lang-item","test_cmd":"bash test.sh","workdir_rel":"workdir"}\n' > "$d/item.json"

guards_out=$(bash "$fill" drain --attempts 2 2>&1)
guards_rc=$?

[ $guards_rc = 0 ] && [ -d "$HNGH_FILL_DIR/escalate/bite-item" ] &&
	grep -q 'tests do not bite' "$HNGH_FILL_DIR/escalate/bite-item/result.json"
check "tests-bite: a green whose tests already pass on the pre-fill state is rejected and escalates" $?

[ -d "$HNGH_FILL_DIR/escalate/growth-item" ] &&
	grep -q 'growing, not converging' "$HNGH_FILL_DIR/escalate/growth-item/result.json"
check "growth-stop: a diff that doubles while the tests stay red escalates" $?

[ -d "$HNGH_FILL_DIR/escalate/lang-item" ] &&
	grep -q 'language mismatch' "$HNGH_FILL_DIR/escalate/lang-item/result.json" &&
	! grep -q 'import os' "$HNGH_FILL_DIR/escalate/lang-item/workdir/script.sh"
check "language lint: a python-flavoured patch for a shell file is rejected before it is applied" $?

# ---- 10. the studio refuses the load (409): evict the resident and retry ------
# The studio refuses (409) a load that would evict a resident chat model when
# "keep multiple models loaded" is Always. The fill must evict the named
# resident and retry the load once; if the retry still fails, the item
# escalates with the load-failure note and NO chat request is sent.
export HNGH_FILL_DIR="$sandbox/queue_evict"
mkdir -p "$HNGH_FILL_DIR"
mk_item evict-item GREEN 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
printf 'nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB' > "$STUB_STATE/load409"
printf '0' > "$STUB_STATE/load409.count"
evict_out=$(bash "$fill" drain --attempts 2 2>&1)
evict_rc=$?

[ $evict_rc = 0 ] && [ -d "$HNGH_FILL_DIR/filled/evict-item" ] &&
	[ ! -d "$HNGH_FILL_DIR/queued/evict-item" ]
check "409 refusal: the resident is evicted, the load retried, and the item proceeds to filled/" $?

[ -f "$STUB_STATE/unload.1.body" ] &&
	grep -q 'nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB' "$STUB_STATE/unload.1.body"
check "409 refusal: the unload endpoint is called with the model id the studio named" $?

[ "$(cat "$STUB_STATE/load409.count" 2>/dev/null)" = 2 ]
check "409 refusal: the load is retried exactly once" $?

printf '%s' "$evict_out" | grep -q 'evicted resident nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB to admit'
check "409 refusal: the eviction is logged" $?

export HNGH_FILL_DIR="$sandbox/queue_evict_fail"
mkdir -p "$HNGH_FILL_DIR"
mk_item evict-fail-item EVICTFAIL 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
touch "$STUB_STATE/load409_always"
printf '0' > "$STUB_STATE/load409.count"
evict_fail_out=$(bash "$fill" drain --attempts 2 2>&1)

[ -d "$HNGH_FILL_DIR/escalate/evict-fail-item" ] &&
	grep -q 'model load failed' "$HNGH_FILL_DIR/escalate/evict-fail-item/result.json"
check "409 refusal: a retry that still fails escalates with the load-failure note" $?

[ ! -f "$STUB_STATE/calls/EVICTFAIL.1.body" ]
check "409 refusal: a failed load sends no chat request" $?

rm -f "$STUB_STATE/load409" "$STUB_STATE/load409.count" "$STUB_STATE/load409_always"

export HNGH_FILL_DIR="$sandbox/queue"

# ---- 11. the escalation ladder ----------------------------------------------
# When the default coder is still red after its tries, the escalation coder
# gets its own tries with its own context and completion budget. The ladder
# only engages when the escalation model is on disk, so the fake 35B GGUF is
# created here — after the sections above, which must keep single-rung
# behaviour.
export HNGH_FILL_DIR="$sandbox/queue_ladder"
mkdir -p "$HNGH_FILL_DIR"
mkdir -p "$HOME/.cache/huggingface/hub/models--unsloth--Qwen-AgentWorld-35B-A3B-GGUF/snapshots/x"
head -c 4096 /dev/zero > "$HOME/.cache/huggingface/hub/models--unsloth--Qwen-AgentWorld-35B-A3B-GGUF/snapshots/x/model.gguf"
mk_item ladder-item LADDER 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
ladder_out=$(bash "$fill" drain --attempts 2 2>&1)

[ -d "$HNGH_FILL_DIR/filled/ladder-item" ] && [ ! -d "$HNGH_FILL_DIR/escalate/ladder-item" ]
check "ladder: the item is filled by the escalation coder after the default coder is red" $?

python3 -c '
import json,sys
r=json.load(open(sys.argv[1]))
assert r["status"]=="filled", r
assert r["model"]=="unsloth/Qwen-AgentWorld-35B-A3B-GGUF", r
assert r["attempts"]==3, r' "$HNGH_FILL_DIR/filled/ladder-item/result.json"
check "ladder: the filled result names the escalation coder and counts every attempt" $?

grep -q 'NVIDIA-Nemotron-3.5-Bolt-E4B-GGUF' "$STUB_STATE/calls/LADDER.1.body"
check "ladder: the first rung asks the default coder" $?

grep -q 'Qwen-AgentWorld-35B-A3B-GGUF' "$STUB_STATE/calls/LADDER.3.body" &&
	grep -q '"max_tokens": 30000' "$STUB_STATE/calls/LADDER.3.body"
check "ladder: the escalation rung asks the escalation coder with its own completion budget" $?

# both rungs red: the item escalates and the note records the ladder it walked
export HNGH_FILL_DIR="$sandbox/queue_ladder_fail"
mkdir -p "$HNGH_FILL_DIR"
mk_item ladder-fail-item NODIFF 'grep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }'
bash "$fill" drain --attempts 2 >/dev/null 2>&1

[ -d "$HNGH_FILL_DIR/escalate/ladder-fail-item" ] &&
	grep -q '\[ladder:' "$HNGH_FILL_DIR/escalate/ladder-fail-item/result.json" &&
	grep -q 'Qwen-AgentWorld-35B-A3B-GGUF' "$HNGH_FILL_DIR/escalate/ladder-fail-item/result.json"
check "ladder: an item red on every rung escalates with the ladder recorded in the note" $?

# ---- 12. a path-2 item: the owned file sits at the item root ---------------
# A path-2 item (workdir_rel ".") keeps its owned file next to SPEC.md,
# item.json, the reply files and the patch leftovers, so the extractor must
# pick the owned file out of that pile, and a restore must not resurrect the
# previous run's replies (measured 2026-11-01 on demo-json-001).
export HNGH_FILL_DIR="$sandbox/queue_path2"
mkdir -p "$HNGH_FILL_DIR"
d="$HNGH_FILL_DIR/queued/path2-item"
mkdir -p "$d/tests"
printf '# spec for path2-item\nFIXTURE:PATHFENCE\n' > "$d/SPEC.md"
printf '#!/bin/bash\necho original\n' > "$d/hngh-artifact"
printf '#!/bin/bash\ngrep -q FIXED hngh-artifact && echo PASS || { echo "expected FIXED"; exit 1; }\n' > "$d/tests/run_tests.sh"
printf '{"id":"path2-item","test_cmd":"bash tests/run_tests.sh","workdir_rel":"."}\n' > "$d/item.json"

d="$HNGH_FILL_DIR/queued/path2-bad-item"
mkdir -p "$d/tests"
printf '# spec for path2-bad-item\nFIXTURE:PATHBAD\n' > "$d/SPEC.md"
printf '#!/bin/bash\necho original\n' > "$d/hngh-artifact"
printf '#!/bin/bash\ngrep -q FIXED hngh-artifact && echo PASS || { echo "expected FIXED"; exit 1; }\n' > "$d/tests/run_tests.sh"
printf '{"id":"path2-bad-item","test_cmd":"bash tests/run_tests.sh","workdir_rel":"."}\n' > "$d/item.json"
# a reply from an earlier run must not come back as this run's evidence
printf 'STALE-EVIDENCE\n' > "$d/reply-attempt-1.txt"

bash "$fill" drain --attempts 2 >/dev/null 2>&1

[ -d "$HNGH_FILL_DIR/filled/path2-item" ] &&
	grep -q FIXED "$HNGH_FILL_DIR/filled/path2-item/hngh-artifact"
check "path-2: a fenced full-file reply is mapped to the owned file and fills" $?

[ -d "$HNGH_FILL_DIR/escalate/path2-bad-item" ]
check "path-2: a diff that does not apply escalates" $?

grep -q NOTTHERE "$HNGH_FILL_DIR/escalate/path2-bad-item/reply-attempt-1.txt" 2>/dev/null &&
	! grep -q STALE-EVIDENCE "$HNGH_FILL_DIR/escalate/path2-bad-item/reply-attempt-1.txt" 2>/dev/null
check "path-2: the live reply survives the restore instead of the earlier run's" $?

# ---- 13. reply shapes the extractor must map onto the owned file --------
# Two shapes killed real fills on 2026-11-01: a fence labelled with the REPO
# path (```src/core/sim.ts) when the workdir holds the flat basename, and a
# reply that opens with the path and then the bare source with no fence and
# no diff at all.
export HNGH_FILL_DIR="$sandbox/queue_shapes"
mkdir -p "$HNGH_FILL_DIR"
d="$HNGH_FILL_DIR/queued/shape-label-item"
mkdir -p "$d/tests" "$d/workdir"
printf '# spec for shape-label-item\nFIXTURE:PATHLABEL\n' > "$d/SPEC.md"
printf 'original\n' > "$d/workdir/hello.txt"
printf '#!/bin/bash\ngrep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }\n' > "$d/workdir/test.sh"
printf '{"id":"shape-label-item","test_cmd":"bash test.sh","workdir_rel":"workdir"}\n' > "$d/item.json"

d="$HNGH_FILL_DIR/queued/shape-head-item"
mkdir -p "$d/tests" "$d/workdir"
printf '# spec for shape-head-item\nFIXTURE:PATHHEAD\n' > "$d/SPEC.md"
printf 'original\n' > "$d/workdir/hello.txt"
printf '#!/bin/bash\ngrep -q FIXED hello.txt && echo PASS || { echo "expected FIXED"; exit 1; }\n' > "$d/workdir/test.sh"
printf '{"id":"shape-head-item","test_cmd":"bash test.sh","workdir_rel":"workdir"}\n' > "$d/item.json"

bash "$fill" drain --attempts 2 >/dev/null 2>&1

[ -d "$HNGH_FILL_DIR/filled/shape-label-item" ] &&
	grep -q FIXED "$HNGH_FILL_DIR/filled/shape-label-item/workdir/hello.txt"
check "extractor: a fence labelled with the repo path maps to the flat basename" $?

[ -d "$HNGH_FILL_DIR/filled/shape-head-item" ] &&
	grep -q FIXED "$HNGH_FILL_DIR/filled/shape-head-item/workdir/hello.txt"
check "extractor: a reply that opens with the path and then the source maps to that file" $?

export HNGH_FILL_DIR="$sandbox/queue"

if [ $failures = 0 ]; then
	echo "SELF-CHECK GREEN"
	exit 0
fi
echo "SELF-CHECK FAILED ($failures)" >&2
exit 1
