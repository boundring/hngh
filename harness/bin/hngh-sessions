#!/usr/bin/env python3
"""hngh-sessions — read-only fold of the hngh session ledger (fabric §5, option A).

Ledger: ~/.local/state/hngh/sessions/feed.jsonl (written by hngh-session-note)
Shows the latest record per session id. Reporting tool: always exits 0.
"""

import argparse
import json
import os
import sys
from datetime import datetime, timezone

FEED = os.path.join(
    os.environ.get("HNGH_SESSIONS_DIR", os.path.expanduser("~/.local/state/hngh/sessions")),
    "feed.jsonl",
)


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="hngh-sessions",
        description="Latest-known state per session from the hngh session ledger (read-only).",
    )
    p.add_argument("--line", metavar="PROJECT", default=None,
                   help="only sessions whose latest record touches this project/research line")
    p.add_argument("--stale", type=float, metavar="MINUTES", default=None,
                   help="only sessions whose latest record is older than this")
    p.add_argument("--json", action="store_true", help="emit folded records as JSON")
    try:
        return p.parse_args(argv)
    except SystemExit:
        raise SystemExit(0)  # reporting tool: bad flags reported, never a failing exit


def parse_ts(ts):
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except (ValueError, AttributeError):
        return None


def load_folded():
    if not os.path.exists(FEED):
        return {}, 0
    folded, malformed = {}, 0
    with open(FEED, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            raw = raw.strip()
            if not raw:
                continue
            try:
                rec = json.loads(raw)
                sid = rec["session"]
                assert isinstance(sid, str) and sid
            except Exception:
                malformed += 1
                continue
            folded[sid] = rec  # feed is append-only; last write wins
    return folded, malformed


def age_minutes(rec):
    ts = parse_ts(rec.get("ts"))
    if ts is None:
        return None
    return (datetime.now(timezone.utc) - ts).total_seconds() / 60.0


def fmt_age(mins):
    if mins is None:
        return "?"
    if mins < 90:
        return f"{int(mins)}m"
    if mins < 48 * 60:
        return f"{mins / 60:.1f}h"
    return f"{mins / 1440:.1f}d"


def main(argv):
    args = parse_args(argv)
    folded, malformed = load_folded()

    now_stale = args.stale is not None
    rows = []
    for sid, rec in folded.items():
        if args.line and args.line not in (rec.get("lines") or []):
            continue
        age = age_minutes(rec)
        if now_stale and (age is None or age <= args.stale):
            continue
        rows.append((sid, rec, age))

    rows.sort(key=lambda r: r[2] if r[2] is not None else float("inf"))

    if args.json:
        print(json.dumps(
            [{"session": s, "age_minutes": (round(a, 1) if a is not None else None),
              **{k: v for k, v in rec.items() if k != "ts"}} for s, rec, a in rows],
            indent=1))
    else:
        total = len(folded)
        print(f"hngh session ledger: {total} session(s) known"
              + (f" ({malformed} malformed line(s) skipped)" if malformed else ""))
        if not rows:
            print("no sessions match")
            return 0
        hdr = f"{'session':<22} {'event':<18} {'age':>6}  {'role':<14} {'lines':<20} detail"
        print(hdr)
        print("-" * len(hdr))
        for sid, rec, age in rows:
            lines = ",".join(rec.get("lines") or [])[:20] or "-"
            detail = (rec.get("detail") or "-")[:60]
            print(f"{sid[:22]:<22} {rec.get('event', '-')[:18]:<18} "
                  f"{fmt_age(age):>6}  {(rec.get('role') or '-')[:14]:<14} "
                  f"{lines:<20} {detail}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
